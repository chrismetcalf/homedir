#!/usr/bin/env node
// tmarchy-tick — invoked once per status-interval by a #() in bar.conf.
//
// Prints NOTHING. It exists for its side effects: writing the values tmux
// cannot compute itself into user options that bar.conf reads. Values are
// therefore one interval stale, which is invisible at 5s and is the price of
// never running a shell during a redraw.
//
// Renamed from bin/tmux-scout-window-tint; its per-window scout logic now lives
// in lib/scout.js and still colours the tabs exactly as it did.
const path = require('node:path')
const { setOptions } = require('../lib/tmux')
const { loadSegments, renderSegments } = require('../lib/segments')
const { currentContext, allWindows, allPanes, hasContext } = require('../lib/context')
const { sshHostUnder } = require('../segments.d/remote')
const { renamePlan, planToOps } = require('../lib/ssh-name')
const { scoutStates } = require('../lib/scout')

function main() {
  const ops = []

  // Per-window. A null value UNSETS the option, matching the behaviour of the
  // old ticker: an idle window has no @scout-state at all rather than the
  // string "idle", so the bar's #{==:...} comparisons fall through cleanly.
  //
  // A failed list-windows yields no windows, hence no ops, hence every window
  // keeps the state it already had — the correct behaviour for a failed tick.
  //
  // scoutStates() returns null when scout could not be read at all, as opposed
  // to an empty Map for "read fine, nothing is running". Only the latter is
  // grounds for clearing tints; on null we write no @scout-state at all and the
  // previous tick's colours stand for another five seconds. @remote-host is
  // independent of scout and is written either way.
  // Which window holds an ssh session, looking at EVERY pane. The window list
  // only reports its active pane's command, so an ssh in a background pane of a
  // split used to get neither the remote glyph nor the rename.
  const sshPaneByWindow = new Map()
  for (const pane of allPanes()) {
    if (pane.command !== 'ssh') continue
    const held = sshPaneByWindow.get(pane.windowId)
    // Prefer the active pane, so a window with two ssh sessions names itself
    // after the one you are actually looking at.
    if (!held || (pane.active && !held.active)) sshPaneByWindow.set(pane.windowId, pane)
  }

  const states = scoutStates()
  for (const win of allWindows()) {
    if (states) {
      ops.push({
        scope: 'window',
        target: win.id,
        name: '@scout-state',
        value: states.get(win.id) || null,
      })
    }
    // Resolve once: the /proc walk is the expensive part and both the tab
    // glyph and the window name want the same answer.
    const sshPane = sshPaneByWindow.get(win.id)
    const sshing = !!sshPane
    const host = sshing ? sshHostUnder(sshPane.pid) : null
    ops.push({
      scope: 'window',
      target: win.id,
      name: '@remote-host',
      value: sshing ? host || 'ssh' : null,
    })

    // Name the window after the host it is sitting on. An ssh whose host could
    // NOT be resolved is deliberately skipped rather than passed through as
    // "not ssh": that would read as the session having ended and would hand
    // back a name mid-session, on nothing worse than one failed /proc walk.
    if (!sshing || host) {
      ops.push(...planToOps(renamePlan(win, host), win))
    }
  }

  // Global segment values for the current pane's context.
  //
  // lib/tmux.js cannot tell "the command printed nothing" from "the command
  // failed", and for the pane query those differ: a live pane always has a pid,
  // so an empty answer means the query failed, not that we are outside a repo
  // and off ssh. Writing it anyway would UNSET @bar-branch and @bar-remote on
  // a failed tick, which is exactly what this ticker promises not to do — so
  // skip the whole group and leave the previous values standing.
  const ctx = currentContext()
  if (hasContext(ctx)) {
    const values = renderSegments(loadSegments(path.join(__dirname, '..', 'segments.d')), ctx)
    // 'remote' is gone: the host now names the window instead of sitting in
    // status-left, where one pane's ssh session read as a property of the
    // whole session. The per-tab glyph still comes from @remote-host above.
    for (const name of ['load', 'agents', 'branch', 'battery']) {
      // Same reasoning as the tints above, and it has to match them: if scout
      // was unreadable this tick, blanking the summary while the tabs keep
      // their colours would make the bar contradict itself.
      if (name === 'agents' && states === null) continue
      ops.push({ scope: 'global', name: `@bar-${name}`, value: values[name] || null })
    }
  }

  setOptions(ops)
}

try {
  main()
} catch {
  // A failed tick leaves every option at its previous value: the bar shows
  // five-second-stale data rather than breaking.
}
