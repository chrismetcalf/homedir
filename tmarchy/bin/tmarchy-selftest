#!/usr/bin/env bash
# tmarchy-selftest — asserts tmarchy loads and renders correctly.
# Uses a throwaway tmux server, XDG_STATE_HOME **and** CLAUDE_CONFIG_DIR so it
# never touches a live session, a real persisted theme choice, or the generated
# Claude Code theme. That last one is not hypothetical: `sync` writes outside the
# state dir, so redirecting XDG_STATE_HOME alone left the `set kanagawa` case
# below rewriting the real ~/.claude/themes/tmarchy.json on every run.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Every tmux this script runs is confined to a throwaway TMUX_TMPDIR, set
# BEFORE the *_SOCK_PATH values below derive from it. Two things make this
# load-bearing rather than tidiness:
#
#   1. `tmarchy-theme set` applies live when $TMUX is set OR `tmux has-session`
#      succeeds. Run from a shell inside the user's tmux, the unisolated call
#      this script used to make re-themed their live bar, set @tmarchy-theme on
#      it, flashed a display-message, and left the live theme diverged from the
#      persisted state file — the exact divergence 1111571 exists to prevent.
#   2. Neither half of the isolation is sufficient alone. $TMUX carries an
#      absolute socket path, so it defeats TMUX_TMPDIR; and unsetting $TMUX
#      still leaves a bare `tmux` resolving the DEFAULT socket, which without
#      TMUX_TMPDIR is the user's live server. Hence `env -u TMUX` *and*
#      TMUX_TMPDIR, together, via tmarchy_theme() below.
#
# The "theme switcher isolation" section asserts both halves, so the header
# claim above is tested rather than merely asserted.
# Fail hard rather than proceeding unisolated: every safety property below
# rests on this variable, and an empty TMUX_TMPDIR would silently resolve back
# to /tmp — i.e. to the user's live server.
# Explicitly under /tmp rather than $TMPDIR: this directory holds unix sockets,
# whose paths are capped at ~108 bytes (sun_path). A bare `mktemp -d` inherits
# $TMPDIR, and a long one — an agent scratch dir, say — silently produces
# "error connecting to ... (File name too long)" on every tmux call here.
TMUX_TMPDIR="$(mktemp -d /tmp/tmarchy-selftest.XXXXXXXX)" || exit 1
case "$TMUX_TMPDIR" in
  /*) ;;
  *) echo "tmarchy-selftest: refusing to run without a throwaway TMUX_TMPDIR" >&2; exit 1 ;;
esac
export TMUX_TMPDIR

SOCK="tmarchy-test-$$"
SOCK_PATH="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$SOCK"
STATE_HOME="$(mktemp -d)"
export XDG_STATE_HOME="$STATE_HOME"
# The Claude Code theme is generated into the CLI's own config dir, not the
# state dir, so it needs redirecting separately or a `set` here repaints the
# real one.
export CLAUDE_CONFIG_DIR="$STATE_HOME/claude"
mkdir -p "$CLAUDE_CONFIG_DIR/themes"
# tokyo-night is both the shipped default AND the only valid persisted-theme
# value available, so persisting "tokyo-night" can't distinguish "restore
# applied it" from "restore is dead code and the default just matched by
# coincidence." A throwaway fixture with a colour value that tokyo-night
# could never produce closes that gap. $$-suffixed like SOCK: concurrent
# selftest runs against the same checkout are routine here, and a shared
# fixture path lets one run's cleanup delete the file out from under another
# run mid-flight.
SENTINEL_THEME="tmarchy-selftest-sentinel-$$"
SENTINEL_PATH="$DIR/themes/$SENTINEL_THEME.conf"
SENTINEL_BG="#c0ffee"
# The outer server that supplies the pty for rendering. Same $$-uniquification
# as SOCK, and torn down in the same trap — an outer server/socket leaked on
# an interrupted run is exactly the /tmp accumulation this repo has a
# documented history of (see CLAUDE.md troubleshooting notes).
OUTER_SOCK="tmarchy-outer-$$"
OUTER_SOCK_PATH="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$OUTER_SOCK"
# Stand-ins for "a live server", used by the theme-switcher isolation checks.
# DECOY_SOCK is on a named socket reachable only via $TMUX; DEFAULT_DECOY is on
# the socket a bare `tmux` resolves to inside TMUX_TMPDIR. Both are throwaway
# (-L + -f /dev/null) and inside the throwaway TMUX_TMPDIR; neither can be the
# user's server under any failure of this script.
DECOY_SOCK="tmarchy-decoy-$$"
DECOY_SOCK_PATH="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$DECOY_SOCK"
DEFAULT_DECOY_PATH="$TMUX_TMPDIR/tmux-$(id -u)/default"
FAILED=0

cleanup() {
  tmux -L "$SOCK" kill-server 2>/dev/null
  tmux -L "$OUTER_SOCK" kill-server 2>/dev/null
  tmux -L "$DECOY_SOCK" kill-server 2>/dev/null
  # `-L default` is the socket a bare `tmux` resolves to, so this line is one
  # unset variable away from killing the user's server. Gate it on the decoy
  # socket actually existing at the throwaway path we computed, rather than on
  # TMUX_TMPDIR still being what we think it is.
  [ -S "$DEFAULT_DECOY_PATH" ] && tmux -L default kill-server 2>/dev/null
  rm -f "$DEFAULT_DECOY_PATH"
  # kill-server doesn't reliably unlink its socket, and this repo has a
  # documented history of /tmp accumulation causing box-wide lag (see
  # CLAUDE.md troubleshooting notes) — so remove it ourselves rather than
  # trusting the side effect.
  rm -f "$SOCK_PATH" "$OUTER_SOCK_PATH" "$DECOY_SOCK_PATH"
  rm -rf "$STATE_HOME"
  rm -f "$SENTINEL_PATH"
  # Last, and only after every kill-server above: this is the throwaway
  # TMUX_TMPDIR that all of the sockets live under.
  rm -rf "$TMUX_TMPDIR"
}
trap cleanup EXIT

pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"; FAILED=1; }

assert_eq() { # name expected actual
  [ "$2" = "$3" ] && pass "$1" || fail "$1" "$2" "$3"
}

# Captures tmarchy.tmux's own stdout/stderr so a noisy or erroring load can't
# hide behind assertions that only check the options it happens to set.
load_tmarchy() { tmux -L "$SOCK" run-shell "$DIR/tmarchy.tmux" 2>&1; }
theme_option() { tmux -L "$SOCK" show -gv "$1" 2>/dev/null; }

echo "tmarchy selftest"
tmux -L "$SOCK" -f /dev/null new-session -d -x 200 -y 24

echo "load"
out="$(load_tmarchy)"
assert_eq "tmarchy.tmux loads without error" "" "$out"

echo "theme options"
assert_eq "@theme-bg is set"   "#1a1b26" "$(theme_option @theme-bg)"
assert_eq "@theme-fg is set"   "#c0caf5" "$(theme_option @theme-fg)"
assert_eq "@theme-wait is set" "#f7768e" "$(theme_option @theme-wait)"
assert_eq "active theme recorded" "tokyo-night" "$(theme_option @tmarchy-theme)"

echo "theme restore"
mkdir -p "$STATE_HOME/tmarchy"

cat > "$SENTINEL_PATH" <<CONF
# throwaway fixture for tmarchy-selftest — deleted by the trap. A sentinel
# colour proves the persisted theme's file was actually sourced, not just
# that its name was accepted and echoed back.
set -g @theme-bg "$SENTINEL_BG"
CONF

printf '%s\n' "$SENTINEL_THEME" > "$STATE_HOME/tmarchy/theme"
out="$(load_tmarchy)"
assert_eq "valid persisted theme loads without error" "" "$out"
assert_eq "valid persisted theme is honoured" "$SENTINEL_THEME" "$(theme_option @tmarchy-theme)"
assert_eq "valid persisted theme's colours are applied" "$SENTINEL_BG" "$(theme_option @theme-bg)"

printf 'no-such-theme\n' > "$STATE_HOME/tmarchy/theme"
out="$(load_tmarchy)"
assert_eq "bogus persisted theme loads without error" "" "$out"
assert_eq "bogus persisted theme falls back to default" "tokyo-night" "$(theme_option @tmarchy-theme)"

# Render a real client and capture what it actually drew. An outer throwaway
# server supplies the pty the inner server needs in order to render at all.
# Reuses OUTER_SOCK/OUTER_SOCK_PATH (declared up top) rather than a fresh name
# per call, so the trap's cleanup covers this even if we're interrupted
# mid-render; the two call sites below run sequentially so there's no
# collision between them.
#
# Polls for a CONVERGED capture instead of a fixed sleep: this box's
# CLAUDE.md documents routine multi-second process-spawn stalls under load,
# so a flat wait either burns that margin needlessly when the box is quiet or
# isn't enough when it's loaded. Polling degrades to "slower," never "flaky."
#
# Non-empty isn't enough: a freshly attached client's first frame already has
# drawable content, but can render before truecolor/RGB capability
# negotiation with the outer terminal completes, so tmux falls back to the
# 256-colour palette for that one frame and then redraws in truecolor a
# moment later. Waiting for two consecutive identical samples (rather than
# special-casing a colour marker here, which would just move the problem)
# waits out that transient instead of accepting whichever frame lands first.
render_status() {
  tmux -L "$OUTER_SOCK" -f /dev/null new-session -d -x 200 -y 24 "tmux -L $SOCK attach" 2>/dev/null
  local waited=0 out="" prev=""
  while [ "$waited" -lt 3000 ]; do
    out="$(tmux -L "$OUTER_SOCK" capture-pane -p -e -t 0 2>/dev/null | tail -1)"
    [ -n "$out" ] && [ "$out" = "$prev" ] && break
    prev="$out"
    sleep 0.1
    waited=$((waited + 100))
  done
  tmux -L "$OUTER_SOCK" kill-server 2>/dev/null
  rm -f "$OUTER_SOCK_PATH"
  printf '%s' "$out"
}

echo "rendering"
tmux -L "$SOCK" rename-session tmarchytest
STATUS="$(render_status)"

case "$STATUS" in
  *tmarchytest*) pass "session name appears in the bar" ;;
  *) fail "session name appears in the bar" "tmarchytest" "$STATUS" ;;
esac

# Proves the real pipeline end-to-end: tokyo-night's actual @theme-bg
# (#1a1b26) survives load -> bar.conf's status-style -> a real render,
# encoded as its truecolor SGR (48;2;26;27;38). Stock tmux's default status
# line uses reverse-video (30/42) and never this triplet, so — unlike a bare
# "an escape sequence is present" check — this can't pass against vanilla
# tmux with no tmarchy config loaded.
case "$STATUS" in
  *'48;2;26;27;38'*) pass "tokyo-night's @theme-bg renders as SGR 48;2;26;27;38" ;;
  *) fail "tokyo-night's @theme-bg renders as SGR 48;2;26;27;38" "48;2;26;27;38" "$STATUS" ;;
esac

# The load-bearing MECHANISM, distinct from the check above: a user option
# expanded INSIDE a style spec, proven with a synthetic probe rather than the
# real theme so it can't be confused with "the theme file happens to be
# right." Uses a 256-colour value because its SGR encoding is stable, unlike
# truecolor which tmux may downsample depending on the test terminal.
echo "theme indirection"
tmux -L "$SOCK" set -g @theme-probe "colour203"
tmux -L "$SOCK" set -g status-left "#[fg=#{@theme-probe}]PROBE#[default] "
PROBE="$(render_status)"
case "$PROBE" in
  *'38;5;203'*) pass "#[fg=#{@theme-probe}] renders as SGR 38;5;203" ;;
  *) fail "#[fg=#{@theme-probe}] renders as SGR 38;5;203" "38;5;203" "$PROBE" ;;
esac

# The rate guard sits in front of the ticker in bar.conf's one #(), so anything
# it prints is drawn straight into the status line. Both paths must be silent —
# the skip path especially, since it is the one that runs several times a second.
#
# TMPDIR is redirected at its own scratch dir: the guard's stamp is shared per
# user by design (see the comment in tmarchy-tick-guard), so testing against the
# real one would both reset the live bar's throttle and make these assertions
# depend on whatever a live tmux server did in the last five seconds.
echo "tick guard"
GUARD_TMP="$(mktemp -d)"

guard_out() { TMPDIR="$GUARD_TMP" "$@" "$DIR/bin/tmarchy-tick-guard" 2>&1; }

# No stamp yet, so this one runs the ticker for real.
assert_eq "prints nothing when it runs the ticker" "" "$(guard_out env)"
assert_eq "writes a stamp when it runs the ticker" "yes" \
  "$([ -s "$GUARD_TMP/tmarchy-tick-$UID.stamp" ] && echo yes || echo no)"

# Stamp is now fresh, so this one must be dropped before node ever starts.
assert_eq "prints nothing when it skips" "" "$(guard_out env)"

# A zero interval disables the throttle: proves the skip above was the guard
# deciding, not the ticker silently failing.
assert_eq "honours TMARCHY_TICK_MIN_INTERVAL" "" \
  "$(guard_out env TMARCHY_TICK_MIN_INTERVAL=0)"

# A truncated or garbage stamp must not wedge the bar or leak a shell error.
printf 'not-a-number\n' > "$GUARD_TMP/tmarchy-tick-$UID.stamp"
assert_eq "recovers from a corrupt stamp" "" "$(guard_out env)"
assert_eq "rewrites a corrupt stamp" "yes" \
  "$(grep -qE '^[0-9]+$' "$GUARD_TMP/tmarchy-tick-$UID.stamp" && echo yes || echo no)"

rm -rf "$GUARD_TMP"

# The assertions above prove the guard is SILENT. They do not prove it
# THROTTLES: the real ticker prints nothing whether it runs once or ten times,
# so deleting the throttle line outright left every one of them green. Since
# not spawning node is the entire reason this project exists, count the spawns.
#
# The guard resolves its ticker as a sibling of itself, so a copy of the guard
# in a temp dir beside a stub named tmarchy-tick yields an exact, cheap run
# count with no node and no tmux involved.
echo "tick guard throttle"
GUARD_DIR="$(mktemp -d)"
cp "$DIR/bin/tmarchy-tick-guard" "$GUARD_DIR/tmarchy-tick-guard"
RUNS="$GUARD_DIR/runs"
cat > "$GUARD_DIR/tmarchy-tick" <<STUB
#!/usr/bin/env bash
printf 'x' >> "$RUNS"
STUB
chmod +x "$GUARD_DIR/tmarchy-tick"

# Each burst gets its own TMPDIR so it starts with no stamp: the stamp is keyed
# per user rather than per run, so a leftover one would decide the result.
count_runs() { # interval n [seed_stamp] -> how many times the stub actually ran
  local interval="$1" n="$2" seed="${3:-}" i tmp
  tmp="$(mktemp -d)"
  [ -n "$seed" ] && printf '%s\n' "$seed" > "$tmp/tmarchy-tick-$UID.stamp"
  : > "$RUNS"
  for ((i = 0; i < n; i++)); do
    TMPDIR="$tmp" TMARCHY_TICK_MIN_INTERVAL="$interval" \
      "$GUARD_DIR/tmarchy-tick-guard" >/dev/null 2>&1
  done
  rm -rf "$tmp"
  wc -c < "$RUNS" | tr -d ' '
}

# The assertion that bites: five back-to-back calls inside one interval must
# produce exactly one spawn. Delete the throttle line from tmarchy-tick-guard
# and this reads 5.
assert_eq "throttles five calls in one interval to one spawn" "1" \
  "$(count_runs 5 5)"

# Control. Without it, a stub that silently never ran would also satisfy the
# assertion above; only the pair distinguishes a working throttle from a
# broken harness.
assert_eq "runs every call when the throttle is disabled" "5" \
  "$(count_runs 0 5)"

# A stamp AHEAD of the clock — NTP stepping back, or a Pi with no RTC restoring
# a saved time via fake-hwclock, and this repo deploys to a Pi. `now - last`
# goes negative, so a naive throttle stays true forever and the ticker never
# runs again; because the tick is also what rewrites the stamp, nothing ever
# clears it either. Before the fix this read 0, for the full size of the step.
NOW="$(date +%s)"
assert_eq "recovers when the stamp is ahead of the clock" "1" \
  "$(count_runs 5 3 $((NOW + 3600)))"

# And it must self-heal rather than just tick once: the stamp has to come back
# to the current clock, or every later call re-enters the same broken state.
STEP_TMP="$(mktemp -d)"
printf '%s\n' "$((NOW + 3600))" > "$STEP_TMP/tmarchy-tick-$UID.stamp"
TMPDIR="$STEP_TMP" "$GUARD_DIR/tmarchy-tick-guard" >/dev/null 2>&1
STEP_STAMP="$(cat "$STEP_TMP/tmarchy-tick-$UID.stamp" 2>/dev/null)"
assert_eq "rewrites a future stamp back to the current clock" "yes" \
  "$([ -n "$STEP_STAMP" ] && [ "$STEP_STAMP" -le "$((NOW + 60))" ] && echo yes || echo no)"
rm -rf "$STEP_TMP"

# The ONLY way this script may invoke tmarchy-theme. `set` applies the theme to
# a live server when $TMUX is set or `tmux has-session` succeeds, so an
# unisolated call from a shell inside the user's tmux re-themes their bar for
# real. Both halves are required and neither is redundant — see the header.
# THEME_ENV is the isolation, kept as one array so the assertions below can
# probe the exact environment the helper uses. Editing one edits both.
THEME_ENV=(env -u TMUX TMUX_TMPDIR="$TMUX_TMPDIR")
tmarchy_theme() { "${THEME_ENV[@]}" "$DIR/bin/tmarchy-theme" "$@"; }

echo "theme switcher"
assert_eq "lists tokyo-night" "yes" \
  "$(tmarchy_theme list | grep -qx 'tokyo-night' && echo yes || echo no)"

STATE_DIR="$(mktemp -d)"
XDG_STATE_HOME="$STATE_DIR" tmarchy_theme set tokyo-night >/dev/null 2>&1
assert_eq "persists the chosen theme" "tokyo-night" \
  "$(cat "$STATE_DIR/tmarchy/theme" 2>/dev/null)"

XDG_STATE_HOME="$STATE_DIR" tmarchy_theme set no-such-theme >/dev/null 2>&1
assert_eq "refuses an unknown theme" "1" "$?"
assert_eq "leaves the old choice intact after a bad set" "tokyo-night" \
  "$(cat "$STATE_DIR/tmarchy/theme" 2>/dev/null)"
rm -rf "$STATE_DIR"

# These two assertions are what makes this script's header claim ("never
# touches a live session") testable rather than aspirational. `tmarchy-theme
# set` applies live when $TMUX is set OR `tmux has-session` succeeds, so there
# are two independent routes out to a real server and each needs its own check;
# passing only one of them is how this script shipped re-theming the user's bar.
#
# Both checks are non-destructive by construction: the only servers they can
# reach are throwaway ones this script started (-L + -f /dev/null) inside the
# throwaway TMUX_TMPDIR. Neither can reach the user's server even when failing.
echo "theme switcher isolation"
DECOY_STATE="$(mktemp -d)"

# Route 1 — $TMUX. It carries an absolute socket path, so it overrides
# TMUX_TMPDIR entirely; only `env -u TMUX` closes it. Point $TMUX at a decoy
# server and assert tmarchy-theme did not write to it.
tmux -L "$DECOY_SOCK" -f /dev/null new-session -d -x 80 -y 24
tmux -L "$DECOY_SOCK" set -g @tmarchy-theme decoy-untouched
TMUX="$DECOY_SOCK_PATH,0,0" XDG_STATE_HOME="$DECOY_STATE" \
  tmarchy_theme set gruvbox >/dev/null 2>&1
assert_eq "does not theme the server \$TMUX points at" "decoy-untouched" \
  "$(tmux -L "$DECOY_SOCK" show -gv @tmarchy-theme 2>/dev/null)"

# Route 2 — the default socket. With $TMUX gone, a bare `tmux` still resolves
# $TMUX_TMPDIR/tmux-$UID/default, which unisolated IS the user's server. Start a
# decoy on exactly that socket inside the throwaway dir and ask, through the
# helper's own environment, which socket a bare tmux lands on. A read-only
# query, so a regression here is reported without being inflicted.
tmux -L default -f /dev/null new-session -d -x 80 -y 24
assert_eq "a bare tmux resolves to the throwaway default socket" \
  "$DEFAULT_DECOY_PATH" \
  "$("${THEME_ENV[@]}" tmux display-message -p '#{socket_path}' 2>/dev/null)"

# And end-to-end: with that decoy up, has-session now succeeds, so a set DOES
# apply live — to the decoy. Proves the assertion above isn't passing merely
# because tmarchy-theme's live-apply branch is unreachable in this harness.
XDG_STATE_HOME="$DECOY_STATE" tmarchy_theme set kanagawa >/dev/null 2>&1
assert_eq "a live apply lands on the throwaway server" "kanagawa" \
  "$(tmux -L default show -gv @tmarchy-theme 2>/dev/null)"

tmux -L default kill-server 2>/dev/null
rm -f "$DEFAULT_DECOY_PATH"
tmux -L "$DECOY_SOCK" kill-server 2>/dev/null
rm -f "$DECOY_SOCK_PATH"
rm -rf "$DECOY_STATE"

# An unwritable state dir must fail loudly rather than silently applying the
# theme live while leaving the persisted choice stale — that divergence is
# exactly what a reboot or new session would surface with nothing on screen
# to explain it. This never touches the live server: the persistence check
# runs (and, here, fails) before tmarchy-theme makes any tmux call at all,
# so it's safe regardless of what socket a bare `tmux` would resolve to.
RO_STATE_DIR="$(mktemp -d)"
mkdir -p "$RO_STATE_DIR/tmarchy"
chmod 000 "$RO_STATE_DIR/tmarchy"
RO_OUT="$(XDG_STATE_HOME="$RO_STATE_DIR" tmarchy_theme set tokyo-night 2>&1)"
RO_RC=$?
chmod 700 "$RO_STATE_DIR/tmarchy"
assert_eq "exits non-zero when it can't persist" "1" "$RO_RC"
case "$RO_OUT" in
  *"not applied"*) pass "reports the persistence failure" ;;
  *) fail "reports the persistence failure" "a message mentioning 'not applied'" "$RO_OUT" ;;
esac
rm -rf "$RO_STATE_DIR"

# The sentinel fixture from the "theme restore" section above is done being
# used. Clean it up now rather than waiting for the exit trap: it lives in
# themes/ alongside the real theme files, and the loop below counts and
# iterates everything matching themes/*.conf.
rm -f "$SENTINEL_PATH"

echo "all themes"
# Ten for the bar, four more the prompt needs. Checked here by SOURCING each
# theme into a real tmux server, so this catches a file that does not parse as
# tmux config -- which reading the text with sed would not.
EXPECTED_KEYS="@theme-bg @theme-fg @theme-dim @theme-accent @theme-accent-alt @theme-border @theme-wait @theme-busy @theme-done @theme-remote @theme-info @theme-accent-muted @theme-alert @theme-fg-muted"
for theme_file in "$DIR"/themes/*.conf; do
  theme_name="$(basename "$theme_file" .conf)"
  # Unset first. Every theme is sourced into the SAME server, so without this a
  # theme inherits any option the previously-sourced one set and the check is
  # vacuous for all but the first: removing a colour from kanagawa.conf still
  # passed, because jewel had set it moments earlier.
  for key in $EXPECTED_KEYS; do
    tmux -L "$SOCK" set -gu "$key" 2>/dev/null
  done
  tmux -L "$SOCK" source-file "$theme_file"
  missing=""
  for key in $EXPECTED_KEYS; do
    value="$(tmux -L "$SOCK" show -gv "$key" 2>/dev/null)"
    case "$value" in
      '#'*|colour*) ;;
      *) missing="$missing $key" ;;
    esac
  done
  assert_eq "$theme_name defines every colour" "" "$missing"
done

assert_eq "nine themes are installed" "9" "$(ls -1 "$DIR"/themes/*.conf | wc -l | tr -d ' ')"

exit "$FAILED"
