#!/usr/bin/env bash
# tmarchy-theme — list, report, or change the active theme.
#
# Switching is a one-shot source-file plus refresh-client. It is NOT a
# per-redraw lookup: the bar reads @theme-* options that this sets once.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tmarchy"
STATE="$STATE_DIR/theme"

usage() {
  echo "usage: tmarchy-theme [list|current|set <name>|sync [name]]" >&2
  exit 2
}

# --- colour conversion -------------------------------------------------------
# Eight themes are #rrggbb; jewel is 256-colour "colourNNN", the pre-tmarchy
# palette. Each downstream consumer accepts a different subset, so convert once
# here rather than teaching zsh and JSON about tmux's spelling.

# p10k takes #rrggbb or a bare 0-255 index. An unconverted "colour214" is
# silently dropped and that segment falls back to the default colour -- the same
# quiet failure mode as an unknown bat theme.
to_p10k() {
  case "$1" in
    '#'??????)                printf '%s' "$1" ;;
    colour[0-9]*|color[0-9]*) printf '%s' "${1#colo*r}" ;;
  esac
}

# Claude Code themes are hex-only, so jewel has to be resolved through the
# xterm-256 table rather than skipped -- skipping would leave one of the nine
# themes unable to move the CLI at all.
to_hex() {
  case "$1" in
    '#'??????) printf '%s' "$1"; return ;;
    colour[0-9]*|color[0-9]*) n="${1#colo*r}" ;;
    *) return ;;
  esac
  if [ "$n" -ge 232 ] 2>/dev/null; then          # 232-255: 24-step greyscale
    v=$(( (n - 232) * 10 + 8 ))
    printf '#%02x%02x%02x' "$v" "$v" "$v"
  elif [ "$n" -ge 16 ] 2>/dev/null; then         # 16-231: 6x6x6 colour cube
    i=$((n - 16)); r=$((i / 36)); g=$(((i % 36) / 6)); b=$((i % 6))
    [ "$r" -gt 0 ] && r=$((55 + r * 40)); [ "$g" -gt 0 ] && g=$((55 + g * 40))
    [ "$b" -gt 0 ] && b=$((55 + b * 40))
    printf '#%02x%02x%02x' "$r" "$g" "$b"
  else                                            # 0-15: the fixed basic set
    set -- 000000 800000 008000 808000 000080 800080 008080 c0c0c0 \
           808080 ff0000 00ff00 ffff00 0000ff ff00ff 00ffff ffffff
    eval "printf '#%s' \"\${$((n + 1))}\""
  fi
}

# Mix $1 toward $2 by $3 percent. Used only for the diff backgrounds, which are
# the one thing a Claude Code theme needs that no semantic token carries: a
# tint of the background, not a foreground colour.
blend() {
  a="$(to_hex "$1")"; b="$(to_hex "$2")"; pct="$3"
  [ -n "$a" ] && [ -n "$b" ] || return
  out='#'
  for off in 1 3 5; do
    ca=$((16#$(printf '%s' "$a" | cut -c$((off + 1))-$((off + 2)))))
    cb=$((16#$(printf '%s' "$b" | cut -c$((off + 1))-$((off + 2)))))
    out="$out$(printf '%02x' $(( ca + (cb - ca) * pct / 100 )))"
  done
  printf '%s' "$out"
}

# Read one @theme-* value out of a theme .conf.
theme_val() {
  sed -n "s/^set -g @theme-$2 *\"\(.*\)\".*/\1/p" "$1" | head -1
}

# Regenerate the state files that non-tmux consumers read: the shell (bat) and
# neovim. They are GENERATED from the theme .conf rather than from live tmux
# options on purpose -- `tmarchy-theme set` must work with no server running,
# and a login shell on a host that has never started tmux still needs a theme.
#
# Written atomically. A consumer that sourced a half-written file would get a
# partial palette, and for the shell that means a broken login, not a wrong
# colour.
sync_state() {
  name="$1"
  conf="$DIR/themes/$name.conf"
  [ -f "$conf" ] || return 1
  mkdir -p "$STATE_DIR" 2>/dev/null || return 1

  sh_tmp="$STATE_DIR/.current.sh.$$"
  lua_tmp="$STATE_DIR/.current.lua.$$"

  {
    echo "# generated by tmarchy-theme -- do not edit"
    echo "TMARCHY_THEME='$name'"
    sed -n 's/^set -g @theme-\([a-z-]*\) *"\(.*\)".*/\1 \2/p' "$conf" |
      while read -r key val; do
        # Shell variables cannot contain a dash.
        printf "TMARCHY_%s='%s'\n" "$(printf '%s' "$key" | tr 'a-z-' 'A-Z_')" "$val"
      done
  } > "$sh_tmp" || return 1

  {
    echo "-- generated by tmarchy-theme -- do not edit"
    echo "return {"
    printf "  theme = %s,\n" "\"$name\""
    sed -n 's/^set -g @theme-\([a-z-]*\) *"\(.*\)".*/\1 \2/p' "$conf" |
      while read -r key val; do
        # Lua table keys cannot contain a dash either.
        printf "  %s = \"%s\",\n" "$(printf '%s' "$key" | tr '-' '_')" "$val"
      done
    echo "}"
  } > "$lua_tmp" || return 1

  # The prompt. p10k resolves its colours once at load, so this is written as
  # ready-to-source assignments rather than raw @theme-* values: the conversion
  # jewel needs (colourNNN -> a bare index) belongs here, not in a zsh config
  # running under `setopt no_unset`.
  p10k_tmp="$STATE_DIR/.current.p10k.zsh.$$"
  {
    echo "# generated by tmarchy-theme -- do not edit"
    for key in accent accent-muted alert busy dim done fg-muted info remote wait; do
      var="tm_$(printf '%s' "$key" | tr '-' '_')"
      printf "%s='%s'\n" "$var" "$(to_p10k "$(theme_val "$conf" "$key")")"
    done
  } > "$p10k_tmp" || return 1

  mv -f "$sh_tmp" "$STATE_DIR/current.sh" &&
    mv -f "$lua_tmp" "$STATE_DIR/current.lua" &&
    mv -f "$p10k_tmp" "$STATE_DIR/current.p10k.zsh" || return 1

  sync_claude_theme "$conf" "$name"
}

# The Claude Code CLI. Unlike bat and nvim it takes a palette, not a theme name,
# so this generates one rather than mapping to something that already exists.
#
# Written to a FIXED theme name ("custom:tmarchy" in settings.json) whose
# contents change, rather than one file per theme with settings.json rewritten
# on every switch: settings.json is versioned, and rewriting it would dirty the
# repo on every theme change.
#
# Never fatal. A host without Claude Code has no ~/.claude to write into, and a
# theme is not worth failing a tmux load over.
sync_claude_theme() {
  conf="$1"; name="$2"
  dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/themes"
  [ -d "$dir" ] || return 0

  bg="$(to_hex "$(theme_val "$conf" bg)")"
  done_c="$(to_hex "$(theme_val "$conf" done)")"
  wait_c="$(to_hex "$(theme_val "$conf" wait)")"
  [ -n "$bg" ] && [ -n "$done_c" ] && [ -n "$wait_c" ] || return 0

  tmp="$dir/.tmarchy.json.$$"
  {
    echo '{'
    printf '  "name": "tmarchy (%s)",\n' "$name"
    echo '  "base": "dark",'
    echo '  "overrides": {'
    # Twelve foreground tokens, each a direct read of a semantic role. Only
    # tokens confirmed to exist in the binary are emitted -- an invented name is
    # ignored silently, so a plausible-looking one is worse than none.
    printf '    "claude": "%s",\n'             "$(to_hex "$(theme_val "$conf" accent-alt)")"
    printf '    "error": "%s",\n'              "$wait_c"
    printf '    "success": "%s",\n'            "$done_c"
    printf '    "warning": "%s",\n'            "$(to_hex "$(theme_val "$conf" busy)")"
    printf '    "permission": "%s",\n'         "$(to_hex "$(theme_val "$conf" accent)")"
    printf '    "permissionShimmer": "%s",\n'  "$(to_hex "$(theme_val "$conf" remote)")"
    printf '    "autoAccept": "%s",\n'         "$(to_hex "$(theme_val "$conf" info)")"
    printf '    "autoAcceptShimmer": "%s",\n'  "$done_c"
    printf '    "planMode": "%s",\n'           "$(to_hex "$(theme_val "$conf" remote)")"
    printf '    "thinking": "%s",\n'           "$(to_hex "$(theme_val "$conf" dim)")"
    printf '    "bashBorder": "%s",\n'         "$(to_hex "$(theme_val "$conf" remote)")"
    printf '    "secondaryBorder": "%s",\n'    "$(to_hex "$(theme_val "$conf" border)")"
    # The six diff backgrounds are the one thing no semantic token carries: a
    # TINT of the background rather than a foreground. Derived by mixing bg
    # toward done/wait, so every theme gets them instead of only the one whose
    # values were hand-picked.
    printf '    "diffAdded": "%s",\n'          "$(blend "$bg" "$done_c" 20)"
    printf '    "diffRemoved": "%s",\n'        "$(blend "$bg" "$wait_c" 20)"
    printf '    "diffAddedWord": "%s",\n'      "$(blend "$bg" "$done_c" 45)"
    printf '    "diffRemovedWord": "%s",\n'    "$(blend "$bg" "$wait_c" 45)"
    printf '    "diffAddedDimmed": "%s",\n'    "$(blend "$bg" "$done_c" 10)"
    printf '    "diffRemovedDimmed": "%s"\n'   "$(blend "$bg" "$wait_c" 10)"
    echo '  }'
    echo '}'
  } > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 0; }
  mv -f "$tmp" "$dir/tmarchy.json" 2>/dev/null || rm -f "$tmp" 2>/dev/null
  return 0
}

list_themes() {
  find "$DIR/themes" -maxdepth 1 -name '*.conf' -exec basename {} .conf \; | sort
}

case "${1:-current}" in
  list)
    list_themes
    ;;
  current)
    tmux show -gv @tmarchy-theme 2>/dev/null || cat "$STATE" 2>/dev/null || echo tokyo-night
    ;;
  set)
    name="${2:-}"
    [ -n "$name" ] || usage
    if [ ! -f "$DIR/themes/$name.conf" ]; then
      echo "tmarchy-theme: no such theme: $name" >&2
      echo "available: $(list_themes | tr '\n' ' ')" >&2
      exit 1
    fi
    # Persist before applying anything live, and refuse to apply live if
    # persistence fails. The alternative — apply live anyway — makes the bar
    # show $name while the state file still names the old theme, which is
    # the exact silent-divergence bug this is fixing, just moved from "wrong
    # exit code" to "wrong screen": the next tmux start (new session, reboot)
    # would revert with nothing on screen to explain why. A loud failure here
    # keeps the live bar and the persisted state in agreement at all times.
    if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
      echo "tmarchy-theme: failed to create $STATE_DIR — $name not applied" >&2
      exit 1
    fi
    if ! printf '%s\n' "$name" > "$STATE" 2>/dev/null; then
      echo "tmarchy-theme: failed to persist theme to $STATE — $name not applied (would silently revert on the next tmux start)" >&2
      exit 1
    fi
    # Downstream state before the live bar: if this fails the theme is still
    # correctly persisted, and a warning is better than a bar that has moved
    # while the shell and editor have not.
    sync_state "$name" || echo "tmarchy-theme: warning: could not write downstream state in $STATE_DIR" >&2

    if [ -n "${TMUX:-}" ] || tmux has-session 2>/dev/null; then
      # Re-run the entry point rather than re-applying the theme by hand. It is
      # idempotent by design, reads the theme we just persisted, and is the ONLY
      # place that knows about the parts a plain source-file cannot cover — the
      # colour-type options (display-panes-*, clock-mode-colour), which tmux
      # rejects as formats and so must be resolved concretely after load.
      #
      # Duplicating those three lines here instead would work today and drift
      # tomorrow: switching a theme would stop matching what a fresh tmux start
      # produces, and nothing would report the difference. One code path, one
      # behaviour.
      "$DIR/tmarchy.tmux"
      tmux refresh-client -S 2>/dev/null
      tmux display-message "tmarchy: $name"
    fi
    ;;
  sync)
    # Regenerate from whatever is already persisted. tmarchy.tmux calls this on
    # every load, so a fresh checkout or a new host gets state files without
    # having to switch theme first.
    # An explicit name makes this testable without touching the live theme;
    # without one it regenerates from whatever is already active.
    cur="${2:-}"
    [ -n "$cur" ] || cur=$(tmux show -gv @tmarchy-theme 2>/dev/null || cat "$STATE" 2>/dev/null || echo tokyo-night)
    if [ ! -f "$DIR/themes/$cur.conf" ]; then
      echo "tmarchy-theme: no such theme: $cur" >&2; exit 1
    fi
    sync_state "$cur" || { echo "tmarchy-theme: sync failed for $cur" >&2; exit 1; }
    ;;
  *)
    usage
    ;;
esac
