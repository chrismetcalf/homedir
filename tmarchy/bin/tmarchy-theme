#!/usr/bin/env bash
# tmarchy-theme — list, report, or change the active theme.
#
# Switching is a one-shot source-file plus refresh-client. It is NOT a
# per-redraw lookup: the bar reads @theme-* options that this sets once.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tmarchy"
STATE="$STATE_DIR/theme"

usage() {
  echo "usage: tmarchy-theme [list|current|set <name>|sync [name]]" >&2
  exit 2
}

# Regenerate the state files that non-tmux consumers read: the shell (bat) and
# neovim. They are GENERATED from the theme .conf rather than from live tmux
# options on purpose -- `tmarchy-theme set` must work with no server running,
# and a login shell on a host that has never started tmux still needs a theme.
#
# Written atomically. A consumer that sourced a half-written file would get a
# partial palette, and for the shell that means a broken login, not a wrong
# colour.
sync_state() {
  name="$1"
  conf="$DIR/themes/$name.conf"
  [ -f "$conf" ] || return 1
  mkdir -p "$STATE_DIR" 2>/dev/null || return 1

  sh_tmp="$STATE_DIR/.current.sh.$$"
  lua_tmp="$STATE_DIR/.current.lua.$$"

  {
    echo "# generated by tmarchy-theme -- do not edit"
    echo "TMARCHY_THEME='$name'"
    sed -n 's/^set -g @theme-\([a-z-]*\) *"\(.*\)".*/\1 \2/p' "$conf" |
      while read -r key val; do
        # Shell variables cannot contain a dash.
        printf "TMARCHY_%s='%s'\n" "$(printf '%s' "$key" | tr 'a-z-' 'A-Z_')" "$val"
      done
  } > "$sh_tmp" || return 1

  {
    echo "-- generated by tmarchy-theme -- do not edit"
    echo "return {"
    printf "  theme = %s,\n" "\"$name\""
    sed -n 's/^set -g @theme-\([a-z-]*\) *"\(.*\)".*/\1 \2/p' "$conf" |
      while read -r key val; do
        # Lua table keys cannot contain a dash either.
        printf "  %s = \"%s\",\n" "$(printf '%s' "$key" | tr '-' '_')" "$val"
      done
    echo "}"
  } > "$lua_tmp" || return 1

  mv -f "$sh_tmp" "$STATE_DIR/current.sh" && mv -f "$lua_tmp" "$STATE_DIR/current.lua"
}

list_themes() {
  find "$DIR/themes" -maxdepth 1 -name '*.conf' -exec basename {} .conf \; | sort
}

case "${1:-current}" in
  list)
    list_themes
    ;;
  current)
    tmux show -gv @tmarchy-theme 2>/dev/null || cat "$STATE" 2>/dev/null || echo tokyo-night
    ;;
  set)
    name="${2:-}"
    [ -n "$name" ] || usage
    if [ ! -f "$DIR/themes/$name.conf" ]; then
      echo "tmarchy-theme: no such theme: $name" >&2
      echo "available: $(list_themes | tr '\n' ' ')" >&2
      exit 1
    fi
    # Persist before applying anything live, and refuse to apply live if
    # persistence fails. The alternative — apply live anyway — makes the bar
    # show $name while the state file still names the old theme, which is
    # the exact silent-divergence bug this is fixing, just moved from "wrong
    # exit code" to "wrong screen": the next tmux start (new session, reboot)
    # would revert with nothing on screen to explain why. A loud failure here
    # keeps the live bar and the persisted state in agreement at all times.
    if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
      echo "tmarchy-theme: failed to create $STATE_DIR — $name not applied" >&2
      exit 1
    fi
    if ! printf '%s\n' "$name" > "$STATE" 2>/dev/null; then
      echo "tmarchy-theme: failed to persist theme to $STATE — $name not applied (would silently revert on the next tmux start)" >&2
      exit 1
    fi
    # Downstream state before the live bar: if this fails the theme is still
    # correctly persisted, and a warning is better than a bar that has moved
    # while the shell and editor have not.
    sync_state "$name" || echo "tmarchy-theme: warning: could not write downstream state in $STATE_DIR" >&2

    if [ -n "${TMUX:-}" ] || tmux has-session 2>/dev/null; then
      # Re-run the entry point rather than re-applying the theme by hand. It is
      # idempotent by design, reads the theme we just persisted, and is the ONLY
      # place that knows about the parts a plain source-file cannot cover — the
      # colour-type options (display-panes-*, clock-mode-colour), which tmux
      # rejects as formats and so must be resolved concretely after load.
      #
      # Duplicating those three lines here instead would work today and drift
      # tomorrow: switching a theme would stop matching what a fresh tmux start
      # produces, and nothing would report the difference. One code path, one
      # behaviour.
      "$DIR/tmarchy.tmux"
      tmux refresh-client -S 2>/dev/null
      tmux display-message "tmarchy: $name"
    fi
    ;;
  sync)
    # Regenerate from whatever is already persisted. tmarchy.tmux calls this on
    # every load, so a fresh checkout or a new host gets state files without
    # having to switch theme first.
    # An explicit name makes this testable without touching the live theme;
    # without one it regenerates from whatever is already active.
    cur="${2:-}"
    [ -n "$cur" ] || cur=$(tmux show -gv @tmarchy-theme 2>/dev/null || cat "$STATE" 2>/dev/null || echo tokyo-night)
    if [ ! -f "$DIR/themes/$cur.conf" ]; then
      echo "tmarchy-theme: no such theme: $cur" >&2; exit 1
    fi
    sync_state "$cur" || { echo "tmarchy-theme: sync failed for $cur" >&2; exit 1; }
    ;;
  *)
    usage
    ;;
esac
