#!/usr/bin/env node
// Reads tmux-scout's active sessions, aggregates them per tmux window
// (priority: wait > busy > done > idle), and stores the result on each
// window as the @scout-state user option so window-status-format can
// render a state-colored marker.
//
// Designed to be called once per status-interval (cheap: one JSON read,
// one tmux list-panes, one batched tmux command).

const { execSync } = require('child_process')
const path = require('path')
const fs = require('fs')

function tmux(args) {
  try {
    return execSync('tmux ' + args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
  } catch (_) {
    return ''
  }
}

const SCOUT_DIR = tmux('show-env -g SCOUT_DIR').replace(/^SCOUT_DIR=/m, '').trim()
if (!SCOUT_DIR || !fs.existsSync(SCOUT_DIR)) process.exit(0)

let sync, render
try {
  sync = require(path.join(SCOUT_DIR, 'scripts/picker/sync'))
  render = require(path.join(SCOUT_DIR, 'scripts/picker/render'))
} catch (_) {
  process.exit(0)
}

const STATUS_FILE = path.join(process.env.HOME || '', '.tmux-scout/status.json')
let cached
try { cached = sync.run(STATUS_FILE) } catch (_) { process.exit(0) }
if (!cached || !cached.status) process.exit(0)

const active = render.getActiveSessions(cached.status, cached.panes)

const PRIO = { wait: 4, busy: 3, done: 2, idle: 1 }
const paneState = new Map()

for (const s of active) {
  if (!s.tmuxPane) continue
  // tmux-scout >= the 2025 refactor expresses session state via `phase`
  // (running/idle/completed/waitingForApproval/…); older builds only set
  // `status`. Map both so tinting survives the upgrade.
  const phase = s.phase || ''
  // Mirror tmux-scout's own render.js isNeedsAttention(): needsAttention /
  // pendingInteraction are the authoritative "waiting on the user" signals.
  // No pendingToolUse-age heuristic: a tool pending >Ns just means a long tool
  // is running, not that the user is being asked something — it painted busy
  // panes red and made the wait tint unreliable.
  const waiting = !!(s.needsAttention || s.pendingInteraction
    || phase === 'waitingForApproval' || phase === 'waitingForAnswer')
  let state
  if (waiting) state = 'wait'
  else if (phase) {
    // phase is authoritative when present (status can lag behind it)
    if (phase === 'running') state = 'busy'
    else if (phase === 'completed') state = 'done'
    else if (phase === 'idle') state = 'idle'
    else continue // crashed/stale/interrupted — leave untinted
  } else if (s.status === 'working') state = 'busy'
  else if (s.status === 'completed') state = 'done'
  else if (s.status === 'idle') state = 'idle'
  else continue

  const prev = paneState.get(s.tmuxPane)
  if (!prev || PRIO[state] > PRIO[prev]) paneState.set(s.tmuxPane, state)
}

// Pane-content fallback. scout only learns of a permission prompt via its
// PermissionRequest hook, which never fires for sessions started before that
// hook was installed (long-running worktree sessions) or when scout has latched
// an interrupted/stale phase — so needsAttention stays null while the pane is
// visibly asking for input. Scrape each agent pane and promote it to wait (top
// priority). One capture-pane per agent pane per tick — cheap.
//
// Match only a LIVE dialog at the bottom of the screen, not prose/history higher
// up that merely quotes a prompt (an agent pane — like a Claude session helping
// with this very script — can print dialog-looking text). Claude's dialog draws
// an "❯ <n>." option selector plus a footer hint; require both, in the last ~12
// non-empty lines.
function paneIsPrompting(text) {
  const tail = text.split('\n').map(l => l.replace(/\s+$/, '')).filter(Boolean).slice(-12)
  const hasSelector = tail.some(l => /^\s*❯\s*\d+\.\s/.test(l))
  const hasFooter = tail.some(l => /Esc to (cancel|reject)|Tab to amend|shift\+tab\)|allow all edits|don.t ask again/.test(l))
  return hasSelector && hasFooter
}
for (const s of active) {
  const pane = s.tmuxPane
  if (!pane || paneState.get(pane) === 'wait') continue
  if (paneIsPrompting(tmux(`capture-pane -p -t ${pane}`))) paneState.set(pane, 'wait')
}

const panesRaw = tmux("list-panes -a -F '#{window_id} #{pane_id}'").trim()
if (!panesRaw) process.exit(0)

const winState = new Map()
const winIds = new Set()
for (const line of panesRaw.split('\n')) {
  const [winId, paneId] = line.split(' ')
  if (!winId) continue
  winIds.add(winId)
  const state = paneState.get(paneId)
  if (!state) continue
  const prev = winState.get(winId)
  if (!prev || PRIO[state] > PRIO[prev]) winState.set(winId, state)
}

const cmds = []
for (const winId of winIds) {
  const state = winState.get(winId)
  if (state) cmds.push(`set-option -wt ${winId} @scout-state ${state}`)
  else cmds.push(`set-option -uwt ${winId} @scout-state`)
}
if (!cmds.length) process.exit(0)

try {
  execSync('tmux ' + cmds.join(' \\; '), { stdio: 'ignore' })
} catch (_) {}
