#!/usr/bin/env bash
# tmux-dropdown — run a long-lived TUI in a detached session and attach a popup
# to it. The mechanism behind prefix + B (btop) and prefix + e (lazydocker).
#
#   tmux-dropdown <session> <command> [args...]
#
# Why a session rather than just `display-popup -E btop`: a popup running the
# command directly starts a FRESH process on every toggle, losing whatever state
# the tool has built up — btop's history graphs, lazydocker's selected container
# and scroll position — and paying startup each time. Here the process outlives
# the overlay; the popup only ever attaches a second client to it.
#
# Keeping it in a session rather than a window also keeps it out of the tab bar.
# Sessions named with a leading _ are treated as infrastructure and hidden from
# tmux-goto's picker, since they are somewhere you summon, not somewhere you
# navigate to.
set -uo pipefail

SESSION="${1:-}"
shift || true
COMMAND=("$@")

if [ -z "$SESSION" ] || [ "${#COMMAND[@]}" -eq 0 ]; then
    printf 'usage: tmux-dropdown <session> <command> [args...]\n' >&2
    exit 2
fi

case "$SESSION" in
    _*) ;;
    # Enforced, not just conventional: the toggle binding detaches on
    # #{m:_*,#{session_name}}, and tmux-goto hides the same pattern. A dropdown
    # named without the underscore would be un-closeable by its own key and
    # would show up as a destination in the picker.
    *) printf 'tmux-dropdown: session name must start with _ (got %s)\n' "$SESSION" >&2
       exit 2 ;;
esac

if ! command -v "${COMMAND[0]}" >/dev/null 2>&1; then
    printf '\ntmux-dropdown: %s is not installed\n\n  [any key] close  ' "${COMMAND[0]}"
    # The redirect is inside the group: a failure to open /dev/tty is reported
    # by the shell, not by read, so `read ... 2>/dev/null` would not silence it
    # and the clean one-line message would be followed by shell noise.
    { IFS= read -r -n1 -s _ </dev/tty; } 2>/dev/null || true
    exit 1
fi

# --- the dropdown-client registry -------------------------------------------
#
# A popup client is an ordinary tmux client, so every prefix binding still works
# inside it — including the ones that switch session. One stray keypress moves
# it off the dropdown session and onto main, and then main renders INSIDE the
# popup (a whole session in a 90%-size box) and #{m:_*,#{session_name}} is false,
# so the very key that opened the overlay can no longer close it. That is not
# hypothetical: it is how this registry came to exist.
#
# So record the popup's tty in a global option. The toggle bindings detach on
# "my session is a dropdown OR my client is a registered dropdown client", which
# survives the wander, and a client-session-changed hook detaches immediately on
# leaving, so the nested render never appears in the first place.
REGISTRY=@dropdown-clients

registry_get() { tmux show-options -gqv "$REGISTRY" 2>/dev/null; }

# Values are stored space-delimited AND space-padded (" /dev/pts/9 /dev/pts/24 ")
# because the bindings match with the pattern "* $tty *". Without the padding
# /dev/pts/2 would match inside /dev/pts/24 and the wrong client would be
# detached.
registry_add() {
    local mine="$1" live entry out=" "
    # Drop any tty that is no longer an attached client. A dropdown killed with
    # SIGKILL skips the EXIT trap below and leaves its entry behind; pts numbers
    # get reused, so a stale entry could otherwise match a brand-new real client
    # and let prefix + B detach the terminal you are working in.
    live=$(tmux list-clients -F '#{client_tty}' 2>/dev/null)
    for entry in $(registry_get); do
        [ "$entry" = "$mine" ] && continue
        printf '%s\n' "$live" | grep -qxF -- "$entry" && out="$out$entry "
    done
    tmux set-option -g "$REGISTRY" "$out$mine "
}

registry_remove() {
    local mine="$1" entry out=" "
    for entry in $(registry_get); do
        [ "$entry" = "$mine" ] && continue
        out="$out$entry "
    done
    tmux set-option -g "$REGISTRY" "$out"
}

MY_TTY=$(tty 2>/dev/null) || MY_TTY=""
if [ -n "$MY_TTY" ]; then
    registry_add "$MY_TTY"
    # HUP and TERM matter as much as EXIT: closing the popup signals the client
    # rather than letting it return normally.
    trap 'registry_remove "$MY_TTY"' EXIT HUP INT TERM
fi

# =NAME is an exact match. Without it tmux matches on prefix, so _btop would be
# satisfied by a session called _btop-old and we would attach to the wrong one.
if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -n "${COMMAND[0]}" "${COMMAND[@]}"
    # Plain name here, NOT "=$SESSION": this tmux accepts the = exact-match
    # prefix for has-session but rejects it for set-option ("no such session").
    tmux set-option -t "$SESSION" status off
fi

# TMUX= is required: tmux refuses to attach a client from inside another client
# ("sessions should be nested with care") unless the variable is cleared. This
# is a deliberate nested attach — the popup IS a second client on the same
# server — which is exactly the case that warning is about.
TMUX= tmux attach-session -t "=$SESSION"
