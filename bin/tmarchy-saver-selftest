#!/usr/bin/env bash
# tmarchy-saver-selftest — the parts of the screensaver that only a real tmux
# server can answer. Everything pure is covered by tmarchy/test/*.test.js; this
# is here for the one behaviour that spans a process, a terminal and a client.
#
# Runs entirely on a throwaway socket with a fake HOME, so it never reads or
# writes the real scout state. That isolation is not optional: an earlier
# version of this check pointed a tick at a scratch socket WITHOUT overriding
# HOME, and scout wrote "pane %N no longer exists" into the live status.json
# about the pane the session was running in.
#
# Three measurement traps this had to get past, all of which produced confident
# wrong answers first:
#   - `display-message -p -t <session>` does NOT resolve to that session's
#     active window. Ask `list-windows -f '#{window_active}'`.
#   - `select-window` is a no-op with no client attached, so the test needs a
#     real one (via `script`), not just a detached session.
#   - counting text in a captured pty stream counts REDRAWS, not events.
set -uo pipefail

SOCK=tmarchy-saver-selftest-$$
ROOT=$(cd "$(dirname "$0")/.." && pwd)
TMPDIR_SELF=$(mktemp -d)
FAIL=0

cleanup() {
    tmux -L "$SOCK" kill-server 2>/dev/null
    rm -rf "$TMPDIR_SELF"
}
trap cleanup EXIT

ok()   { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n' "$1"; FAIL=$((FAIL + 1)); }

command -v tmux >/dev/null || { echo "tmux not installed; nothing to check"; exit 0; }

mkdir -p "$TMPDIR_SELF/.tmux-scout" "$TMPDIR_SELF/.local/state/tmarchy"
cp "$HOME/.local/state/tmarchy/current.sh" "$TMPDIR_SELF/.local/state/tmarchy/" 2>/dev/null

echo "tmarchy-saver-selftest"

tmux -L "$SOCK" new-session -d -s t -x 100 -y 30 \
    "HOME=$TMPDIR_SELF $ROOT/bin/tmarchy-saver; sleep 120"
SAVERWIN=$(tmux -L "$SOCK" display-message -p -t t '#{window_id}')
SAVER=$(tmux -L "$SOCK" list-panes -t "$SAVERWIN" -F '#{pane_id}')
# `-t t:` with the colon, NOT `-t t`. Measured on a scratch server: the bare
# session name works while the session has one window and then fails with
# `create window failed: index 2 in use` once it has two. The trailing colon
# pins the target to the SESSION, so tmux picks the next free index.
tmux -L "$SOCK" new-window -t t: -n target 'sleep 300'
TARGETWIN=$(tmux -L "$SOCK" display-message -p -t t:target '#{window_id}')
TARGET=$(tmux -L "$SOCK" list-panes -t "$TARGETWIN" -F '#{pane_id}')

script -qfc "tmux -L $SOCK attach -t t" /dev/null >/dev/null 2>&1 &
sleep 2
tmux -L "$SOCK" select-window -t "$SAVERWIN"

printf '{"sessions":{"s1":{"tmuxPane":"%s","workingDirectory":"/tmp/agent-under-test","phase":"waitingForApproval"}}}\n' \
    "$TARGET" > "$TMPDIR_SELF/.tmux-scout/status.json"
sleep 4

# The window is named 'target' while the working directory is
# /tmp/agent-under-test, so the banner's label proves WHICH of the two it
# prefers. The window name is the one you see in the tab bar and the one you
# would use to say which agent you mean; a worktree's directory basename is
# routinely something else (~/.homedir reads as ".homedir" while its tab says
# "tmarchy"), which made the list look like other people's agents.
ROW=$(tmux -L "$SOCK" capture-pane -p -t "$SAVER" | sed -n '2p')
case "$ROW" in
    *agent-under-test*)
        fail "banner used the directory basename, not the window name ('$ROW')" ;;
    *target*) ok "a waiting agent raises the banner, labelled by its window name" ;;
    *) fail "no banner for a waiting agent (row 2: '$ROW')"; echo "$FAIL failed"; exit 1 ;;
esac

BEFORE=$(tmux -L "$SOCK" list-windows -t t -f '#{window_active}' -F '#{window_name}')
if [ "$BEFORE" = "target" ]; then
    fail "setup: already on the target window, the click test would be vacuous"
else
    COL=$(awk -v r="$ROW" 'BEGIN{ print index(r, "target") }')
    tmux -L "$SOCK" send-keys -t "$SAVER" -l "$(printf '\033[<0;%d;2M' "$COL")"
    sleep 2
    AFTER=$(tmux -L "$SOCK" list-windows -t t -f '#{window_active}' -F '#{window_name}')
    # Scope the pane query to the TARGET WINDOW. `list-panes -t <session>`
    # reported the target's pane even when nothing had navigated, which would
    # have made half this assertion decorative.
    PANE=$(tmux -L "$SOCK" list-panes -t "$TARGETWIN" -f '#{pane_active}' -F '#{pane_id}')
    if [ "$AFTER" = "target" ] && [ "$PANE" = "$TARGET" ]; then
        ok "clicking a banner name switches to that agent's pane"
    else
        fail "click did not navigate (window '$BEFORE' -> '$AFTER', pane '$PANE', wanted $TARGET)"
    fi
fi

# --- an agent that is not a tmux pane ---------------------------------------
# The provider contract (tmarchy/lib/agents.js): anything that can write a JSON
# file gets onto the saver's surfaces. This proves the whole path end to end
# with scout holding NOTHING -- an empty status.json -- so a row on screen can
# only have come from the drop directory.
#
# Two agents, because `pane` is optional and the two halves behave differently:
# one carries the target pane and must be clickable, one carries none and gets
# no click region at all.
#
# NOTE on what is NOT asserted here. "Clicking the paneless one navigates
# nowhere" looks like the obvious second assertion and is worthless: a hit
# region holding a non-pane string would make jumpTo run
# `display-message -t selftest:goal:none`, which simply fails to resolve, so
# the sabotaged code and the correct code land on exactly the same window. The
# guard's value is that it does not TRY, and that is not observable from
# outside the process. So the clickable half is what gets tested.
#
# A fresh saver in its own window, because the click test above dismissed the
# first one (that is what a click on a name does) and a dismissed saver draws
# nothing.
echo '{"sessions":{}}' > "$TMPDIR_SELF/.tmux-scout/status.json"
mkdir -p "$TMPDIR_SELF/.local/state/tmarchy/agents.d"
# The stamp is NOW: a fixture with a stale timestamp would take the expiry
# path by accident and report it as "no banner".
python3 - "$TMPDIR_SELF/.local/state/tmarchy/agents.d/selftest.json" "$TARGET" <<'PYEOF'
import json, sys, time
json.dump({"generatedAt": int(time.time() * 1000), "ttlMs": 120000, "agents": [
    {"key": "goal:none", "label": "paneless-goal", "state": "wait"},
    {"key": "goal:pinned", "label": "pinned-goal", "state": "wait", "pane": sys.argv[2]},
]}, open(sys.argv[1], "w"))
PYEOF

tmux -L "$SOCK" new-window -t t: -n saver2 \
    "HOME=$TMPDIR_SELF $ROOT/bin/tmarchy-saver; sleep 120"
SAVER2WIN=$(tmux -L "$SOCK" display-message -p -t t:saver2 '#{window_id}')
SAVER2=$(tmux -L "$SOCK" list-panes -t "$SAVER2WIN" -F '#{pane_id}')
tmux -L "$SOCK" select-window -t "$SAVER2WIN"
sleep 4

ROW2=$(tmux -L "$SOCK" capture-pane -p -t "$SAVER2" | sed -n '2p')
case "$ROW2" in
    *paneless-goal*) ok "a provider's agent reaches the banner with no scout record" ;;
    *) fail "no banner for a provider agent (row 2: '$ROW2')" ;;
esac

# The pane-carrying one navigates, which is what proves the provider's `pane`
# is plumbed through rather than merely accepted by the parser.
COL2=$(awk -v r="$ROW2" 'BEGIN{ print index(r, "pinned-goal") }')
BEFORE2=$(tmux -L "$SOCK" list-windows -t t -f '#{window_active}' -F '#{window_name}')
if [ "$COL2" -eq 0 ]; then
    fail "setup: no pinned-goal row, the click check would be vacuous ('$ROW2')"
elif [ "$BEFORE2" = "target" ]; then
    fail "setup: already on the target window, the click check would be vacuous"
else
    tmux -L "$SOCK" send-keys -t "$SAVER2" -l "$(printf '\033[<0;%d;2M' "$COL2")"
    sleep 2
    AFTER2=$(tmux -L "$SOCK" list-windows -t t -f '#{window_active}' -F '#{window_name}')
    PANE2=$(tmux -L "$SOCK" list-panes -t "$TARGETWIN" -f '#{pane_active}' -F '#{pane_id}')
    if [ "$AFTER2" = "target" ] && [ "$PANE2" = "$TARGET" ]; then
        ok "a provider agent carrying a pane is clickable"
    else
        fail "provider click did not navigate ('$BEFORE2' -> '$AFTER2', pane '$PANE2')"
    fi
fi

# --- what a frame costs -----------------------------------------------------
# A screensaver nobody is looking at is still a data bill. Measured on a real
# backgrounded iPhone client, the original full-repaint renderer sent 305 KB/s
# at 52x27 -- a gigabyte an hour, over a cellular link, for a picture that was
# not on screen.
#
# Two ceilings rather than one, because two independent things keep it down and
# a single number would let either rot:
#
#   at a FIXED 20fps, the renderer itself -- frame diffing plus colour
#   quantisation. Losing either shows up here (measured: 170 KB/s without
#   quantisation, 304 KB/s with neither) while the frame-rate tier hides it.
#
#   ADAPTIVE against that fixed rate, which is the tier logic. It cannot be
#   caught by an absolute ceiling, because a tier that stopped working still
#   passes any bound the 20fps renderer passes.
#
# Rates are measured through a real pty at a pinned size -- tmux is deliberately
# not in the path, because tmux diffs on its own and would measure its work
# rather than ours. That is also the honest configuration: a locked client runs
# lock-command on its own tty with no tmux in between.
rate_at() {  # $1 = cols, $2 = rows, rest = args; prints KB/s as an integer
    python3 - "$1" "$2" "${@:3}" <<'PYEOF'
import os, pty, fcntl, termios, struct, select, time, signal, sys
cols, rows = int(sys.argv[1]), int(sys.argv[2])
extra = sys.argv[3:]
pid, fd = pty.fork()
if pid == 0:
    env = dict(os.environ); env.pop('TMUX', None); env.pop('TMUX_PANE', None)
    os.execve(os.environ['SAVER'], ['tmarchy-saver', *extra], env)
fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack('HHHH', rows, cols, 0, 0))
time.sleep(1.5)                      # past the first full repaint
total, t0, died = 0, time.time(), False
while time.time() - t0 < 6:
    r, _, _ = select.select([fd], [], [], 0.2)
    if r:
        try:
            chunk = os.read(fd, 1 << 20)
            if not chunk: died = True; break
            total += len(chunk)
        except OSError: died = True; break
el = time.time() - t0
try: os.kill(pid, signal.SIGKILL); os.waitpid(pid, 0)
except (ProcessLookupError, ChildProcessError): pass
# A crashed child would otherwise divide a stack trace by a fraction of a
# second and report a spectacular rate. It reports -1 instead.
print(-1 if died or el < 5 else round(total / el / 1024))
PYEOF
}

if ! command -v python3 >/dev/null 2>&1; then
    printf '  skip output rate (no python3)\n'
else
    export SAVER="$ROOT/bin/tmarchy-saver"
    FIXED=$(rate_at 52 27 --fps 20)
    ADAPT=$(rate_at 52 27)
    CEIL=110
    if [ "$FIXED" -lt 0 ] || [ "$ADAPT" -lt 0 ]; then
        fail "the saver died during the rate measurement"
    else
        if [ "$FIXED" -le "$CEIL" ]; then
            ok "renderer stays under ${CEIL} KB/s at 52x27 (${FIXED} KB/s at a fixed 20fps)"
        else
            fail "renderer sends ${FIXED} KB/s at 52x27, ceiling ${CEIL} -- diffing or colour quantisation is gone"
        fi
        # Generous ratio: the point is that the tier does SOMETHING, not to pin
        # a particular frame rate, and a loaded box adds noise to both numbers.
        if [ "$ADAPT" -lt "$((FIXED * 3 / 4))" ]; then
            ok "a narrow terminal costs less than a fixed 20fps (${ADAPT} vs ${FIXED} KB/s)"
        else
            fail "narrow terminal cost ${ADAPT} KB/s against ${FIXED} at 20fps -- the frame-rate tier is not applying"
        fi
    fi
fi

# --- standalone, no tmux ----------------------------------------------------
# The saver is an ordinary program, not a tmux feature. These run it through a
# pty with TMUX scrubbed from the environment, because "works outside tmux" is
# the claim and the only way to test it is to take tmux away.
#
# Frames are counted by cursor-home writes: a run that was killed by the first
# keypress draws far fewer than one that kept going to the end.
kiosk_frames() { # $1 = flags, $2 = key sent partway through
    local raw="$TMPDIR_SELF/kiosk.raw"
    rm -f "$raw"
    ( sleep 2; printf '%s' "$2"; sleep 2 ) |
        env -u TMUX -u TMUX_PANE timeout 12 script -qfec "$ROOT/bin/tmarchy-saver $1" "$raw" \
        >/dev/null 2>&1
    # Count CURSOR ADDRESSES, not cursor-HOME. The renderer used to repaint
    # every row from column 1 and so emitted ESC[1;1H once per frame; it now
    # emits ESC[y;xH once per changed run, and the first run of a frame rarely
    # starts at the top-left. Counting homes therefore returned 1 for every run
    # -- a live one and a killed one alike -- which made both kiosk checks
    # vacuous rather than failing: they compared 1 against 1. Any address works
    # as a liveness proxy, because a run that kept drawing emits thousands and
    # one that was killed emits a handful.
    python3 -c "import sys,re; print(len(re.findall(rb'\x1b\[[0-9]+;[0-9]+H', open(sys.argv[1],'rb').read())))" "$raw"
}

if ! command -v script >/dev/null; then
    echo "  skip script(1) not installed; standalone checks need a pty"
else
    stray=$(kiosk_frames "--kiosk" " ")
    quit=$(kiosk_frames "--kiosk" "q")
    saver=$(kiosk_frames "" " ")
    if [ "$stray" -gt "$saver" ]; then
        ok "kiosk ignores a stray key ($stray frames) where the screensaver exits ($saver)"
    else
        fail "kiosk died on a stray key ($stray frames vs screensaver's $saver)"
    fi
    if [ "$quit" -lt "$stray" ]; then
        ok "kiosk still quits on q ($quit frames)"
    else
        fail "kiosk did not quit on q ($quit frames vs $stray for a stray key)"
    fi
fi

if [ "$FAIL" -eq 0 ]; then echo "all passed"; else echo "$FAIL failed"; fi
exit $((FAIL > 0))
