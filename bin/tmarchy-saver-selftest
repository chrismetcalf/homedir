#!/usr/bin/env bash
# tmarchy-saver-selftest — the parts of the screensaver that only a real tmux
# server can answer. Everything pure is covered by tmarchy/test/*.test.js; this
# is here for the one behaviour that spans a process, a terminal and a client.
#
# Runs entirely on a throwaway socket with a fake HOME, so it never reads or
# writes the real scout state. That isolation is not optional: an earlier
# version of this check pointed a tick at a scratch socket WITHOUT overriding
# HOME, and scout wrote "pane %N no longer exists" into the live status.json
# about the pane the session was running in.
#
# Three measurement traps this had to get past, all of which produced confident
# wrong answers first:
#   - `display-message -p -t <session>` does NOT resolve to that session's
#     active window. Ask `list-windows -f '#{window_active}'`.
#   - `select-window` is a no-op with no client attached, so the test needs a
#     real one (via `script`), not just a detached session.
#   - counting text in a captured pty stream counts REDRAWS, not events.
set -uo pipefail

SOCK=tmarchy-saver-selftest-$$
ROOT=$(cd "$(dirname "$0")/.." && pwd)
TMPDIR_SELF=$(mktemp -d)
FAIL=0

cleanup() {
    tmux -L "$SOCK" kill-server 2>/dev/null
    rm -rf "$TMPDIR_SELF"
}
trap cleanup EXIT

ok()   { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n' "$1"; FAIL=$((FAIL + 1)); }

command -v tmux >/dev/null || { echo "tmux not installed; nothing to check"; exit 0; }

mkdir -p "$TMPDIR_SELF/.tmux-scout" "$TMPDIR_SELF/.local/state/tmarchy"
cp "$HOME/.local/state/tmarchy/current.sh" "$TMPDIR_SELF/.local/state/tmarchy/" 2>/dev/null

echo "tmarchy-saver-selftest"

tmux -L "$SOCK" new-session -d -s t -x 100 -y 30 \
    "HOME=$TMPDIR_SELF $ROOT/bin/tmarchy-saver; sleep 120"
SAVERWIN=$(tmux -L "$SOCK" display-message -p -t t '#{window_id}')
SAVER=$(tmux -L "$SOCK" list-panes -t "$SAVERWIN" -F '#{pane_id}')
tmux -L "$SOCK" new-window -t t -n target 'sleep 300'
TARGETWIN=$(tmux -L "$SOCK" display-message -p -t t:target '#{window_id}')
TARGET=$(tmux -L "$SOCK" list-panes -t "$TARGETWIN" -F '#{pane_id}')

script -qfc "tmux -L $SOCK attach -t t" /dev/null >/dev/null 2>&1 &
sleep 2
tmux -L "$SOCK" select-window -t "$SAVERWIN"

printf '{"sessions":{"s1":{"tmuxPane":"%s","workingDirectory":"/tmp/agent-under-test","phase":"waitingForApproval"}}}\n' \
    "$TARGET" > "$TMPDIR_SELF/.tmux-scout/status.json"
sleep 4

# The window is named 'target' while the working directory is
# /tmp/agent-under-test, so the banner's label proves WHICH of the two it
# prefers. The window name is the one you see in the tab bar and the one you
# would use to say which agent you mean; a worktree's directory basename is
# routinely something else (~/.homedir reads as ".homedir" while its tab says
# "tmarchy"), which made the list look like other people's agents.
ROW=$(tmux -L "$SOCK" capture-pane -p -t "$SAVER" | sed -n '2p')
case "$ROW" in
    *agent-under-test*)
        fail "banner used the directory basename, not the window name ('$ROW')" ;;
    *target*) ok "a waiting agent raises the banner, labelled by its window name" ;;
    *) fail "no banner for a waiting agent (row 2: '$ROW')"; echo "$FAIL failed"; exit 1 ;;
esac

BEFORE=$(tmux -L "$SOCK" list-windows -t t -f '#{window_active}' -F '#{window_name}')
if [ "$BEFORE" = "target" ]; then
    fail "setup: already on the target window, the click test would be vacuous"
else
    COL=$(awk -v r="$ROW" 'BEGIN{ print index(r, "target") }')
    tmux -L "$SOCK" send-keys -t "$SAVER" -l "$(printf '\033[<0;%d;2M' "$COL")"
    sleep 2
    AFTER=$(tmux -L "$SOCK" list-windows -t t -f '#{window_active}' -F '#{window_name}')
    # Scope the pane query to the TARGET WINDOW. `list-panes -t <session>`
    # reported the target's pane even when nothing had navigated, which would
    # have made half this assertion decorative.
    PANE=$(tmux -L "$SOCK" list-panes -t "$TARGETWIN" -f '#{pane_active}' -F '#{pane_id}')
    if [ "$AFTER" = "target" ] && [ "$PANE" = "$TARGET" ]; then
        ok "clicking a banner name switches to that agent's pane"
    else
        fail "click did not navigate (window '$BEFORE' -> '$AFTER', pane '$PANE', wanted $TARGET)"
    fi
fi

# --- standalone, no tmux ----------------------------------------------------
# The saver is an ordinary program, not a tmux feature. These run it through a
# pty with TMUX scrubbed from the environment, because "works outside tmux" is
# the claim and the only way to test it is to take tmux away.
#
# Frames are counted by cursor-home writes: a run that was killed by the first
# keypress draws far fewer than one that kept going to the end.
kiosk_frames() { # $1 = flags, $2 = key sent partway through
    local raw="$TMPDIR_SELF/kiosk.raw"
    rm -f "$raw"
    ( sleep 2; printf '%s' "$2"; sleep 2 ) |
        env -u TMUX -u TMUX_PANE timeout 12 script -qfec "$ROOT/bin/tmarchy-saver $1" "$raw" \
        >/dev/null 2>&1
    python3 -c "import sys; print(open(sys.argv[1],'rb').read().count(b'\x1b[1;1H'))" "$raw"
}

if ! command -v script >/dev/null; then
    echo "  skip script(1) not installed; standalone checks need a pty"
else
    stray=$(kiosk_frames "--kiosk" " ")
    quit=$(kiosk_frames "--kiosk" "q")
    saver=$(kiosk_frames "" " ")
    if [ "$stray" -gt "$saver" ]; then
        ok "kiosk ignores a stray key ($stray frames) where the screensaver exits ($saver)"
    else
        fail "kiosk died on a stray key ($stray frames vs screensaver's $saver)"
    fi
    if [ "$quit" -lt "$stray" ]; then
        ok "kiosk still quits on q ($quit frames)"
    else
        fail "kiosk did not quit on q ($quit frames vs $stray for a stray key)"
    fi
fi

if [ "$FAIL" -eq 0 ]; then echo "all passed"; else echo "$FAIL failed"; fi
exit $((FAIL > 0))
