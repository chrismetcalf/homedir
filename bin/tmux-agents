#!/usr/bin/env bash
# tmux-agents — fuzzy-pick a live agent, waiting first. prefix + A.
#
# The sixth picker, built like the others: rows are "TARGET<TAB>KIND<TAB>DISPLAY"
# with fzf on --with-nth=3.., so the pane id is never recovered from display text.
#
# Sorted by TIME IN STATE, not by frecency. That is why this is its own tool
# rather than a mode of tmux-goto: tmux-goto's Enter-is-alt-tab behaviour
# depends on frecency ordering, and it is used 40+ times a week.
#
# Navigation only. Enter jumps; Ctrl-V is deliberately unbound, because an agent
# already lives in a pane and there is nothing to open a second copy of.
#
# Ctrl-W / Ctrl-B / Ctrl-D / Ctrl-A filter by state, reloading the list in
# place the way tmux-files' ^g/^h/^u re-root it. There is deliberately no key
# for idle: Ctrl-I *is* Tab in every terminal, so it cannot be bound without
# taking Tab away. Idle is reachable as `tmux-agents --state idle`.
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
    SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
fi
DIR="$(dirname "$SELF")"
# shellcheck source=lib/tmux-theme.sh
[ -r "$DIR/lib/tmux-theme.sh" ] && . "$DIR/lib/tmux-theme.sh"

# TMUX_AGENTS_ROWS_BIN override exists for the selftest, so the "missing" and
# "non-executable" preflight branches and the exit-code passthrough can be
# exercised against a throwaway stand-in rather than mutating the real emitter.
ROWS_BIN="${TMUX_AGENTS_ROWS_BIN:-$DIR/tmux-agents-rows}"
STATUS="${TMUX_AGENTS_STATUS:-$HOME/.tmux-scout/status.json}"

# fzf hands a reload()/transform-header() body to `sh -c`, so the path to this
# script reaches those bodies through the ENVIRONMENT and is referenced as
# "$TMUX_AGENTS_SELF" inside them -- never interpolated. bin/tmux-files learned
# that the hard way: a root pasted into a quoted argument closes the quote and
# the remainder is syntax, which executed a payload from a directory named
# x'$(touch /tmp/PROOF)'y. The state words in the bindings are our own literals
# and safe; the path is not ours to trust.
export TMUX_AGENTS_SELF="$SELF"

# Tint each row by its state, using the same @theme-* values as the bar and
# tmux-goto -- agent state should read identically everywhere.
colourise() {
    local wait busy done_c reset line rest state
    wait=$(ansi_for "$(tmux show -gv @theme-wait 2>/dev/null)" 2>/dev/null)
    busy=$(ansi_for "$(tmux show -gv @theme-busy 2>/dev/null)" 2>/dev/null)
    done_c=$(ansi_for "$(tmux show -gv @theme-done 2>/dev/null)" 2>/dev/null)
    [ -n "$wait$busy$done_c" ] && reset=$'\033[0m' || reset=""
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        # Field 3 is the state KEY, read positionally rather than matched out of
        # the display text. The emitter's own note says why it is a field: the
        # picker tints and filters on it, and parsing a word back out of the
        # display would keep passing after the label changed shape, silently
        # leaving every row uncoloured.
        rest=${line#*$'\t'}          # kind \t state \t display
        rest=${rest#*$'\t'}          # state \t display
        state=${rest%%$'\t'*}
        case "$state" in
            "wait") printf '%s%s%s\n' "$wait" "$line" "$reset" ;;
            "busy") printf '%s%s%s\n' "$busy" "$line" "$reset" ;;
            "done") printf '%s%s%s\n' "$done_c" "$line" "$reset" ;;
            *)      printf '%s\n' "$line" ;;
        esac
    done
}

# count_of <counts-line> <key> -- one tally out of the emitter's --counts line
# ("wait=2 busy=1 done=1 idle=2 total=6"). A missing key reads as 0 rather than
# as the whole line: ${1#*key=} returns the string unchanged when the key is
# absent, so the digits guard is what stops "wait=2" being printed as a count.
count_of() {
    local v="${1#*"$2"=}"
    v="${v%% *}"
    case "$v" in
        ''|*[!0-9]*) printf '0' ;;
        *)           printf '%s' "$v" ;;
    esac
}

# The header is rebuilt on every filter change through fzf's transform-header,
# which runs a command -- change-header could only carry a string fixed when
# the picker opened, so the counts would go stale the moment an agent finished.
# Counts come from the emitter's --counts, i.e. from the classifier, not from
# counting rows that survived a grep.
header_line() {
    local active="${1:-all}" c out="" key st n item
    c="$("$ROWS_BIN" --counts 2>/dev/null)"
    for st in wait busy "done" all; do
        case "$st" in
            wait)   key=w ;;
            busy)   key=b ;;
            "done") key=d ;;
            *)      key=a ;;
        esac
        if [ "$st" = all ]; then n="$(count_of "$c" total)"; else n="$(count_of "$c" "$st")"; fi
        item="$st($n)"
        # Brackets rather than colour: a header's ANSI handling varies, and the
        # active marker has to survive on a terminal that drops it.
        [ "$st" = "$active" ] && item="[$item]"
        out="$out  ^$key $item"
    done
    printf '%s' "${out#  }"
}

doctor() {
    printf 'tmux-agents doctor\n\n'
    printf '  status file    %s\n' "$STATUS"
    printf '  readable       %s\n' "$([ -r "$STATUS" ] && echo yes || echo NO)"
    printf '  node           %s\n' "$(command -v node || echo MISSING)"
    printf '  fzf            %s\n' "$(command -v fzf || echo MISSING)"
    printf '  rows bin       %s\n' "$ROWS_BIN"
    printf '  rows bin exec  %s\n' "$([ -x "$ROWS_BIN" ] && echo yes || echo NO)"
    printf '  lib dir        %s\n' "$DIR/lib"
    printf '  ansi_for       %s\n' "$(type -t ansi_for 2>/dev/null || echo MISSING)"
    if [ -r "$STATUS" ] && command -v python3 >/dev/null 2>&1; then
        python3 - "$STATUS" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
s = d.get("sessions", {})
stale = sum(1 for x in s.values() if x.get("staleReason") or x.get("endedAt"))
print("  sessions       %d total, %d live-flagged, %d stale/ended" % (len(s), len(s) - stale, stale))
PY
    fi
    printf '  rows emitted   %s\n' "$("$ROWS_BIN" 2>/dev/null | grep -c .)"
}

main() {
    TMUX_AGENTS_MAIN_RAN=1
    # An initial filter, so the picker can be opened pre-narrowed from a
    # binding. Validation is the emitter's job (it exits 2), not a second copy
    # of the state list here.
    local initial=all
    case "${1:-}" in
        --state)   initial="${2:-all}" ;;
        --state=*) initial="${1#--state=}" ;;
    esac
    if ! command -v node >/dev/null 2>&1; then
        printf '\ntmux-agents: node is not installed, and the row emitter needs it.\n\n'
        printf 'Press ENTER to close'; read -r _; exit 1
    fi
    # Same check every sibling picker makes (tmux-goto, tmux-cmd, tmux-ssh),
    # wrapped in this script's own pause-before-close so the popup (bound with
    # display-popup -E, which closes the instant the command exits) doesn't
    # flash open and shut with the message unread.
    if ! command -v fzf >/dev/null 2>&1; then
        printf '\ntmux-agents: fzf is not installed\n\n'
        printf 'Press ENTER to close'; read -r _; exit 1
    fi
    if [ ! -r "$STATUS" ]; then
        printf '\ntmux-agents: no scout status file at\n  %s\n\n' "$STATUS"
        printf '  tmux-scout writes it; install it with prefix + I\n\n'
        printf 'Press ENTER to close'; read -r _; exit 1
    fi
    if [ ! -x "$ROWS_BIN" ]; then
        printf '\ntmux-agents: the row emitter is missing or not executable at\n  %s\n\n' "$ROWS_BIN"
        printf 'Press ENTER to close'; read -r _; exit 1
    fi
    local rows choice pane rc
    rows="$("$ROWS_BIN" --state "$initial")"; rc=$?
    if [ "$rc" = 2 ]; then
        printf '\ntmux-agents: %s is not a state to filter by.\n\n' "$initial"
        printf '  wait, busy, done, idle or all.\n\n'
        printf 'Press ENTER to close'; read -r _; exit 1
    fi
    if [ "$rc" = 3 ]; then
        printf '\ntmux-agents: the scout status file could not be parsed.\n  %s\n\n' "$STATUS"
        printf '  It exists but is not valid JSON -- scout may have been interrupted mid-write.\n\n'
        printf 'Press ENTER to close'; read -r _; exit 1
    fi
    # Any other non-zero rc (126 permission denied, 127 not found, a node crash)
    # is a real failure, not "zero rows" -- falling through to the empty-list
    # branch would report "no live agents" and send the user looking in the
    # wrong place, exactly the class of bug bin/lib/ being unlinked caused before.
    if [ "$rc" != 0 ]; then
        printf '\ntmux-agents: the row emitter failed (exit %s).\n  %s\n\n' "$rc" "$ROWS_BIN"
        printf 'Press ENTER to close'; read -r _; exit 1
    fi
    if [ -z "$rows" ]; then
        # Three different empties, and they must not borrow each other's words.
        # "nothing live" and "your status file is corrupt" were already
        # distinguished above; a filter that matched nothing while agents ARE
        # running is the third, and reporting it as "no live agents" would send
        # you looking at scout for a picker that is working perfectly.
        local total
        total="$(count_of "$("$ROWS_BIN" --counts 2>/dev/null)" total)"
        if [ "$initial" != all ] && [ "$total" -gt 0 ]; then
            printf '\ntmux-agents: no %s agents (%s live).\n\n' "$initial" "$total"
        else
            printf '\ntmux-agents: no live agents.\n\n'
            printf '  %s parsed fine; every session in it is stale, ended, or has no pane.\n\n' "$STATUS"
        fi
        printf 'Press ENTER to close'; read -r _; exit 0
    fi
    # --tiebreak=index so equal-scoring matches keep the duration order above;
    # fzf's default of `length` would re-sort them by row width.
    # shellcheck disable=SC2046  # one token or nothing; see tmux-cmd
    # --tiebreak=index must survive every reload, or the duration order the
    # emitter went to the trouble of producing silently becomes fzf's default
    # `length` -- a sort by row width, which looks almost plausible.
    local rl="\"\$TMUX_AGENTS_SELF\" --rows" hd="\"\$TMUX_AGENTS_SELF\" --header"
    choice=$(printf '%s\n' "$rows" | colourise | fzf --ansi --tiebreak=index $(fzf_theme_opts) \
        --delimiter=$'\t' --with-nth=4.. \
        --header="$(header_line "$initial")" \
        --bind "ctrl-w:reload($rl wait)+transform-header($hd wait)" \
        --bind "ctrl-b:reload($rl busy)+transform-header($hd busy)" \
        --bind "ctrl-d:reload($rl done)+transform-header($hd done)" \
        --bind "ctrl-a:reload($rl all)+transform-header($hd all)" \
        --prompt='agent > ' --height=100% --reverse --no-multi) || exit 0
    pane=${choice%%$'\t'*}
    [ -n "$pane" ] || exit 0
    # A pane id may live in another session, so switch-client first: a bare
    # select-pane only works within the current session and would silently do
    # nothing from a different one. Same sequence bin/tmux-scout-next-wait uses.
    local sess win
    sess=$(tmux display-message -p -t "$pane" '#{session_name}' 2>/dev/null)
    win=$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null)
    [ -n "$sess" ] && tmux switch-client -t "$sess"
    [ -n "$win" ] && tmux select-window -t "$win"
    tmux select-pane -t "$pane"
}

case "${1:-}" in
    --doctor) [ "${TMUX_AGENTS_LIB:-}" = "1" ] || { doctor; exit 0; } ;;
    # Called by the reload/transform-header bindings above, not by hand. They
    # live here rather than inline in the bindings so colourise and header_line
    # each keep exactly one definition.
    --rows)   [ "${TMUX_AGENTS_LIB:-}" = "1" ] || { "$ROWS_BIN" --state "${2:-all}" | colourise; exit 0; } ;;
    --header) [ "${TMUX_AGENTS_LIB:-}" = "1" ] || { header_line "${2:-all}"; exit 0; } ;;
esac

[ "${TMUX_AGENTS_LIB:-}" = "1" ] || main "$@"
