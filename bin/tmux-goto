#!/usr/bin/env bash
# tmux-goto — one picker over sessions, windows and panes.
#
# Bound to prefix + u. Deliberately navigation-only: adding tmux's ~300 commands
# would bury the few dozen rows you actually want to reach. prefix + F keeps its
# nine tmux-fzf modes for the "do something" intent.
#
# Rows are "TARGET<TAB>KIND<TAB>DISPLAY<TAB>STATE<TAB>FRECENCY-KEY" and fzf
# shows only field 3, so the action always has an unambiguous %3 / @7 / session
# name to act on, plus a kind field naming what it is. Parsing either back out
# of display text would break on window names containing spaces, or on a
# leading glyph.
#
# STATE sits at field 4 rather than at the end ON PURPOSE: frecency_key_goto
# reads the LAST field, so appending state there would have silently made the
# state the frecency key and quietly destroyed the ranking this picker is built
# around -- with every row still looking perfectly correct on screen.
#
# Sourced with TMUX_GOTO_LIB=1 it defines its functions and exits, so the
# selftest can exercise the pure parts with no tmux server involved.
set -uo pipefail

# Resolve through symlinks: ~/bin may be one symlink to the repo, or a
# directory of per-file symlinks, depending on how gitfix ran.
TMUX_GOTO_SELF="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
    TMUX_GOTO_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
fi
TMUX_GOTO_LIBDIR="$(dirname "$TMUX_GOTO_SELF")/lib"
# fzf hands reload()/transform-header() bodies to `sh -c`, so the path reaches
# them through the ENVIRONMENT and is referenced as "$TMUX_GOTO_SELF" there --
# never interpolated. See bin/tmux-files for what a pasted path does.
export TMUX_GOTO_SELF
# shellcheck source=lib/tmux-theme.sh
[ -r "$TMUX_GOTO_LIBDIR/tmux-theme.sh" ] && . "$TMUX_GOTO_LIBDIR/tmux-theme.sh"

# shellcheck source=lib/tmux-frecency.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/tmux-frecency.sh"

# Three tmux list outputs -> "TARGET<TAB>TAG DETAIL" rows.
#
# Pure: it takes the text rather than calling tmux, so the whole shape is
# testable from fixtures without a server. Field 1 is the target because fzf
# is configured --with-nth=3, so the id never has to be recovered from
# display text — which would break on the window names containing spaces that
# this repo's agent worktrees routinely produce.
# Nerd Font (Material Design Icons) glyphs, the same family tmarchy's bar
# uses -- GLYPH_SESS is byte-for-byte the glyph sitting next to the session
# name up there, so it is known to render in this terminal. The other two are
# from the same MDI family but are not otherwise used in this repo; swap any of
# them if a terminal shows a box. Nothing else depends on their value.
GLYPH_SESS='󰆍'
GLYPH_WIN='󰖯'
GLYPH_PANE='󱂬'

# Scout-state markers. The text label rides along with the glyph deliberately:
# if a terminal boxes the glyph, "busy" is still readable.
GLYPH_WAIT='󰀦'
GLYPH_BUSY='󰔟'
GLYPH_DONE='󰄬'

# Set by load_theme from whatever theme is live. Empty means "no colour",
# which is what lets rows_from_lists stay pure and testable with no server.
C_WAIT=""
C_BUSY=""
C_DONE=""
C_DIM=""
C_RESET=""

# Read once per invocation, not per row: the picker should follow the theme
# that prefix + ? -> +Theme last persisted.
#
# Through theme_get rather than four `tmux show -gv` calls of its own. Those
# four cost 89ms here -- twice what it costs to ask tmux for every session,
# window and pane in the server -- because each one is a fork, and a fork is
# ~13ms on this Mac. theme_get serves all four from a single batched read.
load_theme() {
    theme_load
    C_WAIT=$(ansi_for "$(theme_get wait)")
    C_BUSY=$(ansi_for "$(theme_get busy)")
    C_DONE=$(ansi_for "$(theme_get done)")
    C_DIM=$(ansi_for "$(theme_get dim)")
    if [ -n "$C_WAIT$C_BUSY$C_DONE$C_DIM" ]; then C_RESET=$'\033[0m'; else C_RESET=""; fi
}

# Marker text and row tint for a scout state. Unset and "idle" get neither:
# marking every idle window defeats the point, which is to make the windows
# wanting your attention stand out. Mirrors how tmarchy tints the whole tab.
state_decor() {
    STATE_MARKER=""
    STATE_COLOUR=""
    case "${1:-}" in
        wait) STATE_MARKER="  $GLYPH_WAIT wait"; STATE_COLOUR="$C_WAIT" ;;
        busy) STATE_MARKER="  $GLYPH_BUSY busy"; STATE_COLOUR="$C_BUSY" ;;
        done) STATE_MARKER="  $GLYPH_DONE done"; STATE_COLOUR="$C_DONE" ;;
    esac
}

rows_from_lists() {
    local sessions="${1:-}" windows="${2:-}" panes="${3:-}"
    local name count id sess idx wname state cmd i

    while IFS=$'\t' read -r name count; do
        [ -n "$name" ] || continue
        # A leading underscore marks an infrastructure session -- one you summon
        # from a key, not a place you navigate to. _btop (prefix + B) is the
        # first; listing it here would offer a destination that immediately
        # detaches you.
        case "$name" in _*) continue ;; esac
        # No dim target appended here, unlike the window and pane rows: a
        # session's target IS its name, which is already the visible label.
        # Field 4 is empty: a session has no scout state of its own, which is
        # also what correctly drops session rows out of a state filter.
        printf '%s\tsess\t%s [sess] %s  (%s windows)\t\tsess:%s\n' \
            "$name" "$GLYPH_SESS" "$name" "$count" "$name"
    done <<< "$sessions"

    # Index states by session:window so pane rows can inherit them. scout sets
    # @scout-state per window, but an agent lives in a pane, and the pane row
    # is as likely to be the one you pick.
    #
    # Two parallel arrays scanned linearly, NOT a string re-parsed per pane.
    # This used to be a newline-delimited string and the pane loop below dug a
    # value out of it with `printf '%s' "$win_states" | awk ...` -- a subshell
    # and an awk exec PER PANE. At 16 panes that was 756ms of the picker's
    # 1.5s startup, by far the largest single cost in it, for a lookup over
    # fifteen keys. Builtins only now: 5ms, byte-for-byte the same output.
    #
    # Parallel indexed arrays rather than one associative array, for the reason
    # in bin/lib/tmux-theme.sh: macOS still ships bash 3.2, where `declare -A`
    # is a syntax error that would take the whole picker down.
    #
    # A linear scan is also what keeps this safe with user-supplied names. A
    # `case "$win_states" in *"$key"*)` lookup would be fewer lines and would
    # treat the key as a GLOB, so a session named `*` would match every window.
    local win_keys=() win_vals=()
    while IFS=$'\t' read -r id sess idx wname state; do
        [ -n "$id" ] || continue
        win_keys[${#win_keys[@]}]="${sess}:${idx}"
        win_vals[${#win_vals[@]}]="${state}"
        state_decor "$state"
        # The id is appended, dimmed, so it can be typed: fzf matches only what
        # it displays. The frecency key is a separate hidden field because the
        # id itself is useless as one -- @2 is a different window after every
        # restart, while the session and window name persist.
        printf '%s\twin\t%s%s [win]  %s:%s %s%s%s  %s%s%s\t%s\twin:%s:%s\n' \
            "$id" "$STATE_COLOUR" "$GLYPH_WIN" "$sess" "$idx" "$wname" \
            "$STATE_MARKER" "${STATE_COLOUR:+$C_RESET}" \
            "$C_DIM" "$id" "${C_DIM:+$C_RESET}" "$state" "$sess" "$wname"
    done <<< "$windows"

    # Six fields: the label is what the row SHOWS, the command is what it keys
    # on. They have to be separate. A pane running an agent is titled by Claude
    # Code itself ("✳ otto"), which is far more use on screen than the fifth
    # "claude" in a column of them -- but it changes when a session is renamed,
    # and a frecency key that moved on every /rename would rank nothing. tmux
    # resolves the label, including the fall back to the command for a pane
    # that set no title of its own (such a pane reports the HOSTNAME), so this
    # stays pure and needs no host_short of its own.
    while IFS=$'\t' read -r id sess idx wname cmd label; do
        [ -n "$id" ] || continue
        [ -n "$label" ] || label="$cmd"
        state=""
        i=0
        while [ "$i" -lt "${#win_keys[@]}" ]; do
            if [ "${win_keys[$i]}" = "${sess}:${idx}" ]; then state="${win_vals[$i]}"; break; fi
            i=$((i + 1))
        done
        state_decor "$state"
        printf '%s\tpane\t%s%s [pane] %s:%s %s  %s%s%s  %s%s%s\t%s\tpane:%s:%s:%s\n' \
            "$id" "$STATE_COLOUR" "$GLYPH_PANE" "$sess" "$idx" "$wname" "$label" \
            "$STATE_MARKER" "${STATE_COLOUR:+$C_RESET}" \
            "$C_DIM" "$id" "${C_DIM:+$C_RESET}" "$state" "$sess" "$wname" "$cmd"
    done <<< "$panes"
}
# Field 4 of each row, read positionally. Pure: it takes the rows rather than
# asking tmux, so the filter is testable from fixtures with no server.
state_of_row() {
    local rest="${1:-}"
    rest=${rest#*$'\t'}      # kind \t display \t state \t key
    rest=${rest#*$'\t'}      # display \t state \t key
    rest=${rest#*$'\t'}      # state \t key
    printf '%s' "${rest%%$'\t'*}"
}

filter_by_state() {
    local rows="${1:-}" want="${2:-all}" row
    if [ "$want" = all ]; then printf '%s' "$rows"; return 0; fi
    while IFS= read -r row; do
        [ -n "$row" ] || continue
        [ "$(state_of_row "$row")" = "$want" ] && printf '%s\n' "$row"
    done <<< "$rows"
    return 0
}

# Sets CS_* rather than printing a line somebody then has to parse -- the
# string form below exists only for --counts and the selftest. A header that
# needed a parser would be a second definition of the counts format.
count_states() {
    local rows="${1:-}" row
    CS_WAIT=0; CS_BUSY=0; CS_DONE=0; CS_TOTAL=0
    while IFS= read -r row; do
        [ -n "$row" ] || continue
        CS_TOTAL=$((CS_TOTAL + 1))
        case "$(state_of_row "$row")" in
            wait)   CS_WAIT=$((CS_WAIT + 1)) ;;
            busy)   CS_BUSY=$((CS_BUSY + 1)) ;;
            "done") CS_DONE=$((CS_DONE + 1)) ;;
        esac
    done <<< "$rows"
}

counts_line() { count_states "${1:-}"; printf 'wait=%s busy=%s done=%s total=%s' \
    "$CS_WAIT" "$CS_BUSY" "$CS_DONE" "$CS_TOTAL"; }

# Counts come from the UNFILTERED rows, so the header still reads busy(1) while
# the list shows only waits. No key for idle: Ctrl-I *is* Tab, and most rows
# here carry no state at all, so an idle filter would mean "almost everything".
header_line() {
    local rows="${1:-}" active="${2:-all}" out="" key st n item
    count_states "$rows"
    for st in wait busy "done" all; do
        case "$st" in
            wait)   key=w; n=$CS_WAIT ;;
            busy)   key=b; n=$CS_BUSY ;;
            "done") key=d; n=$CS_DONE ;;
            *)      key=a; n=$CS_TOTAL ;;
        esac
        item="$st($n)"
        [ "$st" = "$active" ] && item="[$item]"
        out="$out  ^$key $item"
    done
    printf '%s' "${out#  }"
}

frecency_key_goto() {
    local row="${1:-}"
    printf '%s' "${row##*$'\t'}"
}

# Put the previously-active window first and drop the places you already are,
# so prefix + u then Enter is a toggle back to where you just were -- the same
# gesture as alt-tab. Everything else keeps its frecency order behind it.
#
# Pure: it takes the ids rather than asking tmux, so the whole shape is
# testable from fixtures.
promote_and_filter() {
    local rows="${1:-}" cur_win="${2:-}" cur_pane="${3:-}" cur_sess="${4:-}" last_win="${5:-}"
    local row target

    if [ -n "$last_win" ]; then
        while IFS= read -r row; do
            [ -n "$row" ] || continue
            target=${row%%$'\t'*}
            if [ "$target" = "$last_win" ]; then
                printf '%s\n' "$row"
                break
            fi
        done <<< "$rows"
    fi

    while IFS= read -r row; do
        [ -n "$row" ] || continue
        target=${row%%$'\t'*}
        # Compared with = rather than a case pattern: a session name is
        # user-supplied and could contain glob characters.
        [ -n "$cur_win" ] && [ "$target" = "$cur_win" ] && continue
        [ -n "$cur_pane" ] && [ "$target" = "$cur_pane" ] && continue
        [ -n "$cur_sess" ] && [ "$target" = "$cur_sess" ] && continue
        [ -n "$last_win" ] && [ "$target" = "$last_win" ] && continue
        printf '%s\n' "$row"
    done <<< "$rows"
}

collect_rows() {
    local sorted ctx cur_win cur_pane cur_sess last_win
    sorted=$(frecency_sort "$(_collect_rows_raw)" "$(frecency_path goto)" frecency_key_goto)

    ctx=$(tmux display-message -p '#{window_id}'$'\t''#{pane_id}'$'\t''#{session_name}' 2>/dev/null)
    IFS=$'\t' read -r cur_win cur_pane cur_sess <<< "$ctx"

    # Without -a: "last window" is per session, and the one worth toggling to
    # is the last window of the session you are actually in.
    last_win=$(tmux list-windows -F '#{window_id}'$'\t''#{window_last_flag}' 2>/dev/null \
        | awk -F'\t' '$2 == 1 { print $1; exit }')

    promote_and_filter "$sorted" "$cur_win" "$cur_pane" "$cur_sess" "$last_win"
}

_collect_rows_raw() {
    rows_from_lists \
        "$(tmux list-sessions -F '#{session_name}'$'\t''#{session_windows}' 2>/dev/null)" \
        "$(tmux list-windows -a -F '#{window_id}'$'\t''#{session_name}'$'\t''#{window_index}'$'\t''#{window_name}'$'\t''#{@scout-state}' 2>/dev/null)" \
        "$(tmux list-panes -a -F '#{pane_id}'$'\t''#{session_name}'$'\t''#{window_index}'$'\t''#{window_name}'$'\t''#{pane_current_command}'$'\t''#{?#{==:#{pane_title},#{host_short}},#{pane_current_command},#{pane_title}}' 2>/dev/null)"
}

# Dispatch on the row's own kind field, never on the target's first character
# and never on display text: a session name may legally begin with @ or %, so
# sniffing the sigil would send a session called "@release" to select-window.
# Field 2 exists purely to carry the kind and fzf hides it (--with-nth=3), so
# the action reads a value that cannot be perturbed by a glyph, by a window
# name containing spaces, or by anything the display picks up later. Selecting
# a pane also selects its window (verified: select-window accepts a pane id),
# and switching sessions is what makes a session row take you there.
act_on() {
    local row="${1:-}" target kind rest
    [ -n "$row" ] || return 0
    target=${row%%$'\t'*}
    [ -n "$target" ] || return 0
    rest=${row#*$'\t'}
    kind=${rest%%$'\t'*}

    case "$kind" in
        pane) tmux select-window -t "$target"; tmux select-pane -t "$target" ;;
        win)  tmux select-window -t "$target" ;;
        sess) tmux switch-client -t "$target" ;;
    esac
}
# TMUX_GOTO_MAIN_RAN is the selftest's only observable proof that the guard
# below actually skipped main. Keep it as main's first statement.
main() {
    TMUX_GOTO_MAIN_RAN=1
    if ! command -v fzf >/dev/null 2>&1; then
        printf 'tmux-goto: fzf is not installed\n' >&2
        exit 1
    fi
    # An initial filter, so a binding can open the picker pre-narrowed.
    local initial=all
    case "${1:-}" in
        --state)   initial="${2:-all}" ;;
        --state=*) initial="${1#--state=}" ;;
    esac
    case "$initial" in
        wait|busy|"done"|all) ;;
        *)  # Exit 2 rather than widening to all: a typo in a binding would
            # otherwise look exactly like the filter not working.
            printf 'tmux-goto: %s is not a state to filter by (wait, busy, done, all)\n' \
                "$initial" >&2
            exit 2 ;;
    esac
    load_theme
    local choice rows all_rows
    all_rows=$(collect_rows)
    rows=$(filter_by_state "$all_rows" "$initial")
    # Legitimately possible: one session, one window, one pane means every row
    # is somewhere you already are. Say so rather than opening an empty picker
    # that just looks broken.
    if [ -z "$rows" ]; then
        # Two different empties. "Nowhere else to go" is about the server; a
        # filter matching nothing is about the filter, and borrowing the first
        # message for the second would claim you are alone in one window when
        # you are not.
        if [ -n "$all_rows" ] && [ "$initial" != all ]; then
            count_states "$all_rows"
            printf '\ntmux-goto: nothing is %s (%s rows).\n\n  [any key] close  ' \
                "$initial" "$CS_TOTAL"
        else
            printf '\ntmux-goto: nowhere else to go -- this is the only window\n'
            printf 'and pane in the only session.\n\n  [any key] close  '
        fi
        IFS= read -r -n1 -s _ </dev/tty 2>/dev/null || true
        exit 0
    fi
    # --with-nth=3 exactly, NOT 3..: fields 4 and 5 carry the state and the
    # frecency key and must stay hidden. --tiebreak=index so equal-scoring
    # matches keep the frecency order; the default `length` ranks by row width
    # and would undo the sort -- including after every reload below.
    # shellcheck disable=SC2046  # one token or nothing; see tmux-cmd
    local rl="\"\$TMUX_GOTO_SELF\" --rows" hd="\"\$TMUX_GOTO_SELF\" --header"
    choice=$(printf '%s\n' "$rows" | fzf --ansi --tiebreak=index $(fzf_theme_opts) \
        --delimiter=$'\t' --with-nth=3 \
        --header="$(header_line "$all_rows" "$initial")" \
        --bind "ctrl-w:reload($rl wait)+transform-header($hd wait)" \
        --bind "ctrl-b:reload($rl busy)+transform-header($hd busy)" \
        --bind "ctrl-d:reload($rl done)+transform-header($hd done)" \
        --bind "ctrl-a:reload($rl all)+transform-header($hd all)" \
        --prompt='go to > ' --height=100% --reverse --no-multi) || exit 0
    frecency_record "$(frecency_path goto)" "$(frecency_key_goto "$choice")"
    act_on "$choice"
}

# Called by the reload/transform-header bindings, not by hand. --header needs
# no theme: colours live in the display text, and the counts it reports come
# from the state field, which load_theme does not touch.
case "${1:-}" in
    --rows)   [ "${TMUX_GOTO_LIB:-}" = "1" ] || { load_theme; filter_by_state "$(collect_rows)" "${2:-all}"; exit 0; } ;;
    --header) [ "${TMUX_GOTO_LIB:-}" = "1" ] || { header_line "$(collect_rows)" "${2:-all}"; exit 0; } ;;
    --counts) [ "${TMUX_GOTO_LIB:-}" = "1" ] || { counts_line "$(collect_rows)"; printf '\n'; exit 0; } ;;
esac

[ "${TMUX_GOTO_LIB:-}" = "1" ] || main "$@"
