#!/usr/bin/env bash
# tmux-agents-selftest — fixture-driven tests for bin/tmux-agents-rows.
#
# Runs entirely without tmux, fzf, or any live agent: the emitter takes its
# status file, its live pane list and the current pane from the environment.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAILED=0
pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"; FAILED=1; }
assert_eq() { [ "$2" = "$3" ] && pass "$1" || fail "$1" "$2" "$3"; }
assert_contains() { case "$3" in *"$2"*) pass "$1" ;; *) fail "$1" "to contain: $2" "$3" ;; esac; }

export TMUX_AGENTS_STATUS="$DIR/fixtures/agents-status.json"
# %15 and %18 deliberately absent: one is flagged stale, one is not.
# NOTE: the fixture's `sessions` object deliberately does NOT declare its keys
# in this order (see bin/fixtures/agents-status.json) -- input order already
# equalling sorted order is exactly what let `rows.sort(...)` be deleted from
# tmux-agents-rows without this suite noticing. Keep the fixture's declared
# order different from this expected order.
export TMUX_AGENTS_PANES="%10 %11 %12 %13 %14 %16 %17 %19 %20 %99"
export TMUX_AGENTS_CURRENT="%99"

echo "tmux-agents-rows"
OUT="$(TMUX_AGENTS_NOW=1788672000000 "$DIR/tmux-agents-rows")"
PANES="$(printf '%s\n' "$OUT" | cut -f1 | tr '\n' ' ')"

assert_eq "row count" "6" "$(printf '%s\n' "$OUT" | grep -c .)"
assert_eq "order is wait-longest, wait, busy, done, then idle" "%10 %11 %12 %20 %13 %14 " "$PANES"

echo "exclusions"
assert_eq "current pane excluded"            "0" "$(printf '%s\n' "$OUT" | grep -c '^%99')"
assert_eq "stale by flag excluded"           "0" "$(printf '%s\n' "$OUT" | grep -c '^%15')"
assert_eq "ended excluded"                   "0" "$(printf '%s\n' "$OUT" | grep -c '^%16')"
assert_eq "crashed (null state) excluded"    "0" "$(printf '%s\n' "$OUT" | grep -c '^%19')"
assert_eq "session with no pane excluded"    "0" "$(printf '%s\n' "$OUT" | grep -c 'nopane')"
# The two disagreement cases, which one-way filtering gets wrong:
assert_eq "flagged stale but pane alive: excluded" "0" "$(printf '%s\n' "$OUT" | grep -c '^%17.*zombie')"
assert_eq "not flagged but pane gone: excluded"    "0" "$(printf '%s\n' "$OUT" | grep -c '^%18')"

echo "clocks"
# wait uses lastHookAt: 1788672000000-1788671400000 = 600s = 10m
assert_contains "wait duration from lastHookAt" "10m" "$(printf '%s\n' "$OUT" | grep '^%10')"
# busy uses turnStartedAt: 900000ms = 15m
assert_contains "busy duration from turnStartedAt" "15m" "$(printf '%s\n' "$OUT" | grep '^%12')"
# idle uses turnEndedAt: 3600000ms = 1h
assert_contains "idle duration from turnEndedAt" "1h" "$(printf '%s\n' "$OUT" | grep '^%13')"
# idle with no turnEndedAt falls back to lastUpdated
assert_contains "idle falls back to lastUpdated" "1h" "$(printf '%s\n' "$OUT" | grep '^%14')"
# done uses turnEndedAt: 1200000ms = 20m -- done was previously unexercised
# (reachable in practice, but no fixture entry classified to it before this).
assert_contains "done duration from turnEndedAt" "20m" "$(printf '%s\n' "$OUT" | grep '^%20')"
assert_contains "done label is DONE" "DONE" "$(printf '%s\n' "$OUT" | grep '^%20')"

echo "pane-content fallback (dialog on a hookless/latched session)"
# sessionState() alone misses a live approval dialog when needsAttention never
# fired (a session started before the PermissionRequest hook existed) or the
# phase is latched to something else. TMUX_AGENTS_CAPTURE_<id> stubs
# capture-pane per pane with no tmux server. s-busy-dialog (%21) and
# s-busy-quoted (%22) are both plain `phase: running` (busy) sessions in the
# fixture; only their pane content differs.
DIALOG=$'some tool output\n  \xe2\x9d\xaf 1. Yes\n    2. No\nEsc to cancel'
QUOTED_LINES=$'\xe2\x9d\xaf 1. Yes\nEsc to cancel\n'
for _ in $(seq 1 20); do QUOTED_LINES="${QUOTED_LINES}later output
"; done
FALLBACK_OUT="$(TMUX_AGENTS_PANES="%21 %22" \
    TMUX_AGENTS_CAPTURE_21="$DIALOG" \
    TMUX_AGENTS_CAPTURE_22="$QUOTED_LINES" \
    TMUX_AGENTS_NOW=1788672000000 "$DIR/tmux-agents-rows")"
assert_contains "busy pane with a live approval dialog is promoted to WAIT" "WAIT" \
    "$(printf '%s\n' "$FALLBACK_OUT" | grep '^%21')"
assert_contains "busy pane merely quoting dialog text in scrollback stays WORK" "WORK" \
    "$(printf '%s\n' "$FALLBACK_OUT" | grep '^%22')"
assert_eq "quoted-but-not-live dialog text is never promoted to WAIT" "0" \
    "$(printf '%s\n' "$FALLBACK_OUT" | grep -c '^%22.*WAIT')"

echo "shape"
assert_eq "field 2 is the kind" "agent" "$(printf '%s\n' "$OUT" | head -1 | cut -f2)"
assert_contains "label is the directory basename" "otto" "$(printf '%s\n' "$OUT" | grep '^%10')"

echo "empty state"
assert_eq "no live agents yields no rows" "0" \
    "$(TMUX_AGENTS_PANES=" " "$DIR/tmux-agents-rows" | grep -c .)"

echo "picker"
assert_eq "picker is executable" "yes" "$([ -x "$DIR/tmux-agents" ] && echo yes || echo no)"
# Comment-stripped source: a comment mentioning switch-client/select-window
# must not be able to satisfy these on its own -- only real code counts.
JUMP_CODE="$(grep -vE '^[[:space:]]*#' "$DIR/tmux-agents")"
# Enter must jump across sessions, not just within one.
assert_contains "jump switches client before selecting" "switch-client" "$JUMP_CODE"
assert_contains "jump selects the window too" "select-window" "$JUMP_CODE"
# The name promises an ORDER, so check the order: switch-client, then
# select-window, then select-pane. A bare select-pane from another session
# silently does nothing, which is the exact bug this guards against.
jump_line() { printf '%s\n' "$JUMP_CODE" | grep -n "tmux $1" | head -1 | cut -d: -f1; }
SC=$(jump_line switch-client); SW=$(jump_line select-window); SP=$(jump_line select-pane)
assert_eq "jump order is switch-client, select-window, select-pane" "ordered" \
    "$([ -n "$SC" ] && [ -n "$SW" ] && [ -n "$SP" ] && [ "$SC" -lt "$SW" ] && [ "$SW" -lt "$SP" ] && echo ordered || echo "out-of-order: $SC $SW $SP")"
# All three colours colourise fetches (wait/busy/done) must actually be
# painted onto a row -- a fetched-but-unused colour is exactly what a future
# tidy-up deletes, since nothing else in the script reads it. Checked against
# the case block that dispatches on $state, and that each arm paints with its
# OWN variable, not just that the state word appears somewhere.
CASE_BLOCK="$(sed -n '/case "\$state" in/,/esac/p' "$DIR/tmux-agents")"
assert_contains "colourise: WAIT arm paints with \$wait"   '$wait' \
    "$(printf '%s\n' "$CASE_BLOCK" | grep '^ *WAIT)')"
assert_contains "colourise: WORK arm paints with \$busy"   '$busy' \
    "$(printf '%s\n' "$CASE_BLOCK" | grep '^ *WORK)')"
assert_contains "colourise: DONE arm paints with \$done_c" '$done_c' \
    "$(printf '%s\n' "$CASE_BLOCK" | grep '^ *DONE)')"
# Navigation only: no acting on agents from this tool.
assert_eq "no kill in the picker"    "0" "$(grep -c 'kill-pane\|kill-window\|kill-session' "$DIR/tmux-agents")"
assert_eq "ctrl-v is not bound"      "0" "$(grep -c 'expect=ctrl-v' "$DIR/tmux-agents")"
assert_contains "tiebreak=index is set" "--tiebreak=index" "$(cat "$DIR/tmux-agents")"
# Empty states must explain rather than open an empty picker.
assert_contains "absent status file is explained" "no scout status file" \
    "$(TMUX_AGENTS_STATUS=/definitely/absent bash "$DIR/tmux-agents" 2>&1 </dev/null || true)"
# A corrupt file and an empty one are different answers; saying "no live agents"
# for a truncated write would send you looking in the wrong place entirely.
# mktemp, not a file under fixtures/, so an interrupted run leaves nothing
# untracked behind (every other selftest in this repo follows the same rule).
CORRUPT="$(mktemp)"
printf 'not json' > "$CORRUPT"
assert_contains "corrupt status file is explained" "could not be parsed" \
    "$(TMUX_AGENTS_STATUS="$CORRUPT" bash "$DIR/tmux-agents" 2>&1 </dev/null || true)"
rm -f "$CORRUPT"

# JSON.parse("null") succeeds -- "null" is valid JSON -- so the emitter must
# reject it explicitly rather than let `doc.sessions` throw a TypeError and
# exit 1, which would print "no live agents" for a file that is actually broken.
NULLFILE="$(mktemp)"
printf 'null' > "$NULLFILE"
TMUX_AGENTS_STATUS="$NULLFILE" "$DIR/tmux-agents-rows" >/dev/null 2>&1
NULLRC=$?
assert_eq "a parsed-but-non-object status file exits 3, not 1" "3" "$NULLRC"
rm -f "$NULLFILE"

echo "preflight: fzf"
# Every sibling picker (tmux-goto, tmux-cmd, tmux-ssh) refuses to open without
# fzf; this one didn't, so a host missing it got an empty popup with nothing to
# read (display-popup -E closes the instant the command exits). Build a PATH
# containing only bash, node and dirname -- everything the script needs to
# reach the fzf check -- and deliberately no fzf, so the check under test is
# the only thing that can produce this message. (A plain `PATH=... bash ...`
# doesn't work here: bash resolves the command it's about to run using the
# NEW PATH, not the invoking shell's, so bash itself must be on it too.)
NOFZF_DIR="$(mktemp -d)"
ln -s "$(command -v bash)" "$NOFZF_DIR/bash"
ln -s "$(command -v node)" "$NOFZF_DIR/node"
ln -s "$(command -v dirname)" "$NOFZF_DIR/dirname"
assert_contains "missing fzf is explained, not flashed away" "fzf is not installed" \
    "$(PATH="$NOFZF_DIR" TMUX_AGENTS_STATUS="$DIR/fixtures/agents-status.json" bash "$DIR/tmux-agents" 2>&1 </dev/null || true)"
rm -rf "$NOFZF_DIR"

echo "preflight: row emitter missing/non-executable/failing"
# TMUX_AGENTS_ROWS_BIN lets these point at a throwaway stand-in instead of
# mutating the real bin/tmux-agents-rows.
MISSING_ROWS="$(mktemp -u)"  # deliberately never created
assert_contains "missing row emitter is explained, not reported as 'no live agents'" \
    "missing or not executable" \
    "$(TMUX_AGENTS_ROWS_BIN="$MISSING_ROWS" bash "$DIR/tmux-agents" 2>&1 </dev/null || true)"

NOEXEC_ROWS="$(mktemp)"
printf '#!/usr/bin/env bash\nprintf "should never run\\n"\n' > "$NOEXEC_ROWS"
# left non-executable deliberately
assert_contains "non-executable row emitter is explained" "missing or not executable" \
    "$(TMUX_AGENTS_ROWS_BIN="$NOEXEC_ROWS" bash "$DIR/tmux-agents" 2>&1 </dev/null || true)"
rm -f "$NOEXEC_ROWS"

# A row emitter that runs but fails with some exit code other than 0 or 3 (a
# permission error, a node crash, anything) must be reported by exit code, not
# silently folded into the empty-rows "no live agents" branch.
FAILING_ROWS="$(mktemp)"
printf '#!/usr/bin/env bash\nexit 42\n' > "$FAILING_ROWS"
chmod +x "$FAILING_ROWS"
assert_contains "a row emitter exit code other than 0/3 is named, not swallowed" "exit 42" \
    "$(TMUX_AGENTS_ROWS_BIN="$FAILING_ROWS" bash "$DIR/tmux-agents" 2>&1 </dev/null || true)"
rm -f "$FAILING_ROWS"

echo "doctor reports fzf and the row emitter"
DOCTOR_OUT="$("$DIR/tmux-agents" --doctor)"
assert_contains "doctor reports fzf" "fzf" "$DOCTOR_OUT"
assert_contains "doctor reports whether the row emitter is executable" "rows bin exec" "$DOCTOR_OUT"

printf '\n'
[ "$FAILED" = 0 ] && { printf 'all passed\n'; exit 0; }
printf 'FAILURES\n'; exit 1
