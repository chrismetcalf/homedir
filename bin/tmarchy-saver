#!/usr/bin/env node
// tmarchy-saver — a screensaver that reads the machine it is running on.
//
// A rotating solid (or rain), a telemetry panel and a CPU timeline, all painted
// in the ACTIVE tmarchy theme, so it matches whatever the bar is wearing without
// being told. Every number on screen is real: the nodes are live agent panes
// coloured by their scout state, and the readouts are system load, every Claude
// plan limit, and round-trip times to things you actually talk to. A
// screensaver made of fiction would be wallpaper; this one is worth glancing at.
//
// Wired to tmux's own lock-command, which is the actual screensaver hook --
// `lock-after` idles into it, and any key OR click exits. Also bound to a key
// for when you just want to look at it.
//
// Theme comes from ~/.local/state/tmarchy/current.sh rather than from live tmux
// options, for the same reason tmarchy-theme sync generates that file: it must
// work with no server running. A lock-command runs inside tmux, but this is
// also runnable on a bare terminal, and there is no reason to make it care.
'use strict'

const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')

const STATE = path.join(os.homedir(), '.local', 'state', 'tmarchy')

// Two renderers, one frame loop. Both paint into the same character grid, so
// the agent nodes and the HUD are written once and neither renderer knows they
// exist. `geo` is the default because it is the one worth staring at; `rain` is
// the first one and still the better backdrop if you want the HUD legible.
const MODE = (process.argv[2] || 'geo').replace(/^--/, '')
let geo = null
try { geo = require(path.join(__dirname, 'tmarchy-geo.js')) } catch { /* rain still works */ }
let panel = null
try { panel = require(path.join(__dirname, 'tmarchy-panel.js')) } catch { /* panel is optional */ }
let ping = null
try { ping = require(path.join(__dirname, 'tmarchy-ping.js')) } catch { /* reachability is optional */ }
const FPS = 20
const TICK = Math.round(1000 / FPS)
// Real data changes on human timescales; re-reading it every frame would spend
// the whole budget on syscalls for numbers that move once a minute.
const DATA_EVERY = 2000
// CPU is the exception: it is the graph's time axis, so it is sampled every
// second. At one sample per data tick a 120-column graph would take eight
// minutes to fill; at 1s it reads as live within a minute or two.
const CPU_EVERY = 1000

// ---------------------------------------------------------------- colour ----
// The same two spellings bin/lib/tmux-theme.sh handles: eight themes are
// #rrggbb, jewel is 256-colour colourNNN. Anything else yields no escape at
// all rather than a broken one, exactly as ansi_for does.
function fg(value) {
  if (!value) return ''
  const hex = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(value)
  if (hex) return `\x1b[38;2;${parseInt(hex[1], 16)};${parseInt(hex[2], 16)};${parseInt(hex[3], 16)}m`
  const idx = /^colou?r(\d{1,3})$/.exec(value)
  if (idx) return `\x1b[38;5;${idx[1]}m`
  return ''
}

// Mix toward black, so a rain tail can fade without needing more theme tokens.
function dim(value, factor) {
  const hex = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(value || '')
  if (!hex) return fg(value)
  const c = [1, 2, 3].map((i) => Math.round(parseInt(hex[i], 16) * factor))
  return `\x1b[38;2;${c[0]};${c[1]};${c[2]}m`
}

function loadTheme() {
  const t = {}
  try {
    for (const line of fs.readFileSync(path.join(STATE, 'current.sh'), 'utf8').split('\n')) {
      const m = /^TMARCHY_([A-Z_]+)='(.*)'$/.exec(line)
      if (m) t[m[1].toLowerCase()] = m[2]
    }
  } catch { /* no state yet: the fallback below still paints something */ }
  return {
    name: t.theme || 'tokyo-night',
    bg: t.bg || '#1a1b26',
    fg: t.fg || '#c0caf5',
    dim: t.dim || '#565f89',
    accent: t.accent || '#7aa2f7',
    accentAlt: t.accent_muted || t.accent_alt || '#bb9af7',
    wait: t.wait || '#f7768e',
    busy: t.busy || '#e0af68',
    done: t.done || '#9ece6a',
    info: t.info || '#73daca',
    remote: t.remote || '#7dcfff',
  }
}

// ------------------------------------------------------------------ data ----
// sessionState is the ONE definition of agent state in this repo -- the bar,
// prefix + ~ and the triage picker all call it. Borrowing it here means the
// nodes cannot disagree with the tab colours they are sitting under.
let sessionState = null
try {
  ({ sessionState } = require(path.join(__dirname, '..', 'tmarchy', 'lib', 'scout')))
} catch { /* tmarchy absent: nodes simply do not appear */ }

function readAgents() {
  if (!sessionState) return []
  try {
    const doc = JSON.parse(fs.readFileSync(path.join(os.homedir(), '.tmux-scout', 'status.json'), 'utf8'))
    const out = []
    for (const s of Object.values(doc.sessions || {})) {
      if (!s.tmuxPane || s.staleReason || s.endedAt) continue
      const state = sessionState(s)
      if (!state) continue
      out.push({ label: path.basename(s.workingDirectory || '') || '?', state })
    }
    return out.sort((a, b) => a.label.localeCompare(b.label)).slice(0, 12)
  } catch { return [] }
}

// Quota comes from tmarchy's own segment rather than being re-parsed here, so
// the thresholds the panel paints red are literally the ones the status bar
// warns on. It also owns the staleness rule -- a 45-minute-old reading is
// dropped rather than shown as current -- and the detached refresher, which
// matters here in a way it does not on the bar: a locked session stops
// redrawing its status line, so without this a screensaver left up for an hour
// would quietly show hour-old numbers.
let quotaSeg = null
try {
  quotaSeg = require(path.join(__dirname, '..', 'tmarchy', 'segments.d', 'quota.js'))
} catch { /* tmarchy absent: the CLAUDE section simply does not appear */ }

function readClaude() {
  if (!quotaSeg) return []
  const record = quotaSeg.readCache()
  quotaSeg.maybeRefresh(record)
  return quotaSeg.bucketRows(record)
}

function readData() {
  const agents = readAgents()
  return {
    agents,
    wait: agents.filter((a) => a.state === 'wait').length,
    busy: agents.filter((a) => a.state === 'busy').length,
    load: os.loadavg()[0].toFixed(2),
    claude: readClaude(),
    host: os.hostname().split('.')[0],
    up: Math.floor(os.uptime() / 3600),
  }
}

// ------------------------------------------------------------------ rain ----
// Half the glyphs are katakana because that is the look; the rest are hex and
// the repo's own vocabulary, so the fall occasionally spells something true.
// HALF-WIDTH katakana (U+FF65-FF9F), not the full-width forms. Full-width kana
// occupy TWO terminal columns, and this renderer addresses a one-character grid
// -- mixing them in overflows every row and shifts the HUD sideways, which is
// exactly what the first version did. Half-width is also the authentic
// terminal-matrix look, so the constraint and the aesthetic agree.
const GLYPHS = ('ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ' +
  '0123456789ABCDEF' + '#{}[]<>/\\|=+-*%$~').split('')
const WORDS = ['tmarchy', 'scout', 'wait', 'busy', 'agent', 'quota', 'pane', 'tmux', 'idle']

function makeColumn(rows) {
  return {
    y: -Math.floor(Math.random() * rows),
    speed: 0.3 + Math.random() * 0.9,
    len: 6 + Math.floor(Math.random() * 14),
    word: Math.random() < 0.06 ? WORDS[Math.floor(Math.random() * WORDS.length)] : null,
  }
}

// ------------------------------------------------------------------ main ----
function main() {
  const out = process.stdout
  if (!out.isTTY) {
    process.stderr.write('tmarchy-saver: needs a terminal\n')
    process.exit(1)
  }

  let theme = loadTheme()
  let data = readData()
  // Panel stats are RATES (cpu jiffies, net bytes), so they are sampled on the
  // data tick rather than per frame -- per frame the deltas would be noise
  // divided by 50ms.
  let stats = panel ? panel.read() : {}
  // Pings are async children on their own 15s timer; the frame loop only ever
  // reads the cache they fill. Started here rather than at require time so a
  // module that is merely loaded (by a test, say) never spawns anything.
  if (ping) ping.start()
  let reach = ping ? ping.read() : null
  let cols = out.columns || 80
  let rows = out.rows || 24
  let columns = Array.from({ length: cols }, () => makeColumn(rows))
  let frame = 0

  // Mouse reporting, so a CLICK dismisses the saver the way a keypress does.
  // The screensaver's contract is "any input wakes it", and a click is input --
  // having to reach for the keyboard to clear a screensaver you clicked on
  // reads as a hang.
  //
  // 1000 is press/release only, deliberately not 1002/1003: with motion
  // reporting the saver would vanish the instant the pointer drifted over the
  // window, which is not the same gesture at all. 1006 asks for SGR-encoded
  // coordinates -- irrelevant to us, since we discard the bytes, but the legacy
  // encoding breaks past column 223 and some terminals refuse to send anything
  // they cannot encode.
  //
  // tmux with `mouse on` normally eats mouse events for its own pane handling;
  // enabling this is precisely what flips #{mouse_any_flag} to 1 and makes tmux
  // forward them to us instead (verified against a scratch server: a plain cat
  // reports 0, a process that has sent 1000h reports 1).
  const MOUSE_ON = '\x1b[?1000h\x1b[?1006h'
  const MOUSE_OFF = '\x1b[?1006l\x1b[?1000l'

  const cleanup = () => {
    // Mouse mode off FIRST and unconditionally. Leaving it on would have the
    // terminal spraying escape sequences at whatever shell comes back -- a
    // screensaver that breaks your prompt on the way out.
    out.write(MOUSE_OFF + '\x1b[?25h\x1b[0m\x1b[?1049l')   // cursor, reset, leave alt screen
    try { process.stdin.setRawMode(false) } catch {}
    process.exit(0)
  }

  out.write('\x1b[?1049h\x1b[?25l\x1b[2J' + MOUSE_ON)  // alt screen, hide cursor, clear
  process.stdin.setRawMode(true)
  process.stdin.resume()
  process.stdin.on('data', cleanup)             // ANY key leaves, as a lock should
  process.on('SIGINT', cleanup)
  process.on('SIGTERM', cleanup)
  out.on('resize', () => {
    cols = out.columns || 80
    rows = out.rows || 24
    columns = Array.from({ length: cols }, () => makeColumn(rows))
    out.write('\x1b[2J')
  })

  const stateColour = (s) =>
    s === 'wait' ? theme.wait : s === 'busy' ? theme.busy : s === 'done' ? theme.done : theme.dim

  setInterval(() => {
    frame++
    if (frame % Math.round(DATA_EVERY / TICK) === 0) {
      data = readData()
      theme = loadTheme()                       // switch theme and the rain follows
      if (panel) stats = panel.read()
      if (ping) reach = ping.read()
    }
    if (panel && frame % Math.round(CPU_EVERY / TICK) === 0) {
      // The gauge shows the sampler's newest reading rather than waiting for the
      // next data tick, so the CPU number and the graph's right edge agree.
      const c = panel.sampleCpu()
      if (c !== null && stats) stats.cpu = c
    }

    const buf = []

    const grid = Array.from({ length: rows }, () => new Array(cols).fill(null))

    // The telemetry panel owns the right-hand columns; everything else is
    // centred in what is LEFT, not in the whole pane. Computed before drawing
    // so the solid and the rain can both avoid it.
    const right = (panel && cols >= panel.MIN_COLS && rows >= 14) ? panel.WIDTH : 0
    const mainW = cols - right
    // The CPU graph owns the bottom band, full width -- it runs UNDER the panel
    // too, which is deliberate: a timeline that stopped at the panel's edge
    // would read as clipped rather than as a backdrop.
    // Shorter than the filled version was. A sparse trace only ever occupies one
    // cell per column, so a tall band on an idle box is empty pane rather than
    // a fuller-looking graph -- the height buys resolution, not presence.
    const graphH = (panel && rows >= 18) ? Math.max(4, Math.min(6, Math.floor(rows * 0.18))) : 0

    // --- solid geometry ---------------------------------------------------
    if (MODE !== 'rain' && geo) {
      // Spin tracks load per core, so the thing visibly works harder when the
      // box does. That is the readout, not decoration.
      const spin = geo.spinFactor(os.loadavg()[0], (stats && stats.cores) || os.cpus().length)
      geo.render({ grid, rows, cols, frame, theme, fg, dim, spin, right, bottom: graphH })
    }

    // --- rain ---------------------------------------------------------------
    if (MODE === 'rain' || !geo) columns.forEach((col, x) => {
      if (x >= mainW) return                    // leave the panel's columns alone
      col.y += col.speed
      if (col.y - col.len > rows) Object.assign(col, makeColumn(rows), { y: -col.len })
      const head = Math.floor(col.y)
      for (let i = 0; i < col.len; i++) {
        const y = head - i
        if (y < 0 || y >= rows) continue
        const ch = col.word && i < col.word.length
          ? col.word[col.word.length - 1 - i]
          : GLYPHS[(x * 31 + y * 17 + Math.floor(frame / 3)) % GLYPHS.length]
        // Head is bright, tail fades to nothing: the whole trick of the effect.
        const colour = i === 0 ? fg(theme.fg)
          : col.word ? fg(theme.info)
            : dim(theme.accent, Math.max(0.12, 1 - i / col.len))
        grid[y][x] = colour + ch
      }
    })

    // Agent nodes and the HUD used to float over the middle of the pane. They
    // live in the telemetry panel now: the same information, in a column that
    // does not cut through the solid or fight the graph for the bottom rows.

    // --- CPU over time -----------------------------------------------------
    if (graphH && stats && stats.cpuHistory) {
      panel.renderGraph({ grid, rows, cols, theme, fg, dim,
        history: stats.cpuHistory, height: graphH })
    }

    // --- telemetry panel ---------------------------------------------------
    if (right) {
      panel.render({ grid, rows, cols, frame, theme, fg, dim,
        stats, agents: data.agents, claude: data.claude, ping: reach,
        meta: { theme: theme.name, host: data.host, uptimeHours: data.up } })
    }

    // Address each row explicitly rather than ending lines with a newline.
    // Writing into the LAST column auto-wraps the cursor, so a trailing newline
    // then lands a row further down than intended -- which paints every other
    // line blank and shoves the HUD sideways. Cursor addressing makes the wrap
    // harmless because the next row starts from a known position regardless.
    for (let y = 0; y < rows; y++) {
      buf.push(`\x1b[${y + 1};1H`)
      for (let x = 0; x < cols; x++) buf.push(grid[y][x] === null ? ' ' : grid[y][x])
      buf.push('\x1b[0m')
    }
    out.write(buf.join(''))
  }, TICK)
}

main()
