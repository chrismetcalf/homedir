#!/usr/bin/env node
// tmarchy-saver — a screensaver that reads the machine it is running on.
//
// A rotating solid (or rain), a telemetry panel and a CPU timeline, all painted
// in the ACTIVE tmarchy theme, so it matches whatever the bar is wearing without
// being told. Every number on screen is real: the nodes are live agent panes
// coloured by their scout state, and the readouts are system load, every Claude
// plan limit, and round-trip times to things you actually talk to. A
// screensaver made of fiction would be wallpaper; this one is worth glancing at.
//
// Wired to tmux's own lock-command, which is the actual screensaver hook --
// `lock-after` idles into it, and any key OR click exits. Also bound to a key
// for when you just want to look at it.
//
// Theme comes from ~/.local/state/tmarchy/current.sh rather than from live tmux
// options, for the same reason tmarchy-theme sync generates that file: it must
// work with no server running. A lock-command runs inside tmux, but this is
// also runnable on a bare terminal, and there is no reason to make it care.
'use strict'

const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')

const STATE = path.join(os.homedir(), '.local', 'state', 'tmarchy')

// Two renderers, one frame loop. Both paint into the same character grid, so
// the agent nodes and the HUD are written once and neither renderer knows they
// exist. `geo` is the default because it is the one worth staring at; `rain` is
// the first one and still the better backdrop if you want the HUD legible.
// Flags and the mode can come in any order, and the mode may be spelled bare or
// with dashes: `tmarchy-saver rain`, `--rain`, `--kiosk rain` all work. The old
// form was `argv[2]` positionally, which silently read `--kiosk` as a mode name
// and fell through to geo.
const ARGS = process.argv.slice(2)
const MODES = ['geo', 'rain', 'demo']
const flag = (...names) => ARGS.some((a) => names.includes(a))

if (flag('--help', '-h')) {
  process.stdout.write([
    'tmarchy-saver [geo|rain] [--kiosk]',
    '',
    '  A live visualisation of this machine: a rotating solid that spins and',
    '  breathes with the work in progress, a telemetry column, a CPU timeline,',
    '  and the hosts it talks to pinned to the surface.',
    '',
    '  geo       rotating solid (default)',
    '  rain      falling glyphs',
    '',
    '  --kiosk   run it as a display rather than a screensaver. ONLY q quits',
    '            (or Ctrl-C). Stray keys are ignored, and a click on an agent',
    '            in the alert banner still jumps to it without ending the',
    '            display. Use this for a window you want to leave running.',
    '',
    '  Needs a terminal. Runs perfectly well outside tmux -- the agent and',
    '  reachability panels come from files and the network, not from tmux.',
    '',
  ].join('\n'))
  process.exit(0)
}

const KIOSK = flag('--kiosk', '-k')
// --fps N, where N is 1..60. A bad value is ignored rather than fatal: this is
// a screensaver, and refusing to lock the screen over a typo is the worse
// failure.
const FPS_FLAG = (() => {
  const i = ARGS.indexOf('--fps')
  const n = i >= 0 ? Number(ARGS[i + 1]) : NaN
  return Number.isFinite(n) && n >= 1 && n <= 60 ? Math.round(n) : 0
})()
// An explicit argument wins; otherwise the persisted preference, which is what
// makes `lock-after` and `prefix + Z` follow `tmarchy-saver-mode next` without
// either of them having to carry the mode. See bin/tmarchy-saver-mode for why
// the preference is a file rather than a flag on the binding.
function persistedMode() {
  try {
    const f = path.join(process.env.XDG_STATE_HOME || path.join(os.homedir(), '.local', 'state'),
      'tmarchy', 'saver-mode')
    const m = require('node:fs').readFileSync(f, 'utf8').trim()
    return MODES.includes(m) ? m : null
  } catch { return null }
}
const MODE = ARGS.map((a) => a.replace(/^--?/, '')).find((a) => MODES.includes(a))
  || persistedMode() || 'geo'
let geo = null
try { geo = require(path.join(__dirname, 'tmarchy-geo.js')) } catch { /* rain still works */ }
// The demo mode: this host's name run through a sequence of demo-scene
// effects, modelled on Omarchy's own screensaver (see the header of
// tmarchy-demo.js for what is taken from it and what is not).
let demo = null
try { demo = require(path.join(__dirname, 'tmarchy-demo.js')) } catch { /* geo and rain still work */ }
let panel = null
try { panel = require(path.join(__dirname, 'tmarchy-panel.js')) } catch { /* panel is optional */ }
let ping = null
try { ping = require(path.join(__dirname, 'tmarchy-ping.js')) } catch { /* reachability is optional */ }
// FRAME RATE FOLLOWS THE TERMINAL, because the cost does. A frame costs
// roughly its cell count in bytes, so a 20fps full-rate animation that is
// invisible on a desktop over a LAN is a gigabyte an hour on a phone over a
// cellular link -- measured, on a real client: 305 KB/s to a backgrounded
// iPhone at 52x27, which is the saver's entire output and nothing else.
//
// Tiers rather than a formula. The honest signal here is "is this a small
// remote window", and columns are the only proxy available to a process whose
// whole world is one tty -- a formula over cell count would dress that guess
// up as arithmetic. --fps overrides it for anyone who wants the full rate on a
// small screen, and for tests that need a known rate.
const BASE_FPS = 20                // what the animation's constants are tuned for
// The middle boundary is 100, NOT 80, and that is a measured number rather
// than a round one. ShellFish on an iPhone reports 84 columns, which an
// 80-column break put in the middle tier and cost 294 MB/hour against the 126
// the cheap tier gives at the same size -- the single biggest factor left in
// what that device pays, larger than anything else tuned here. A window under
// a hundred columns is a small window, and 6fps is a screensaver, so the cost
// of being wrong in the other direction is a laptop split animating a little
// more coarsely.
function fpsFor(width) {
  if (FPS_FLAG) return FPS_FLAG
  if (width >= 120) return BASE_FPS
  if (width >= 100) return 12
  return 6
}
let FPS = BASE_FPS
let TICK = Math.round(1000 / FPS)
// How far the animation advances per tick, in BASE_FPS frames. Everything that
// moves is tuned in frames -- the morph cycle, the banner pulse, the rotation
// increments -- so dropping the frame rate without this does not make the
// picture cheaper, it makes it SLOW: a 6fps saver would rotate at a third of
// the speed rather than showing the same motion in fewer steps.
let STEP = BASE_FPS / FPS
// Same tiers as the frame rate and the same reasoning: a wide window is a
// cheap one and keeps the theme's exact colours, which were hand-matched
// across the bar, nvim, bat and the prompt and should not be rounded off on a
// desktop that is not paying for bytes.
// Even the widest tier quantises a little. 4 leaves 64 levels per channel,
// which is past anything the eye resolves on a character grid, and it is worth
// 1.7x on a desktop-sized window -- measured 3355 -> 1924 MB/hour at 209x61.
// The reason to stop there rather than go further is the theme: these colours
// were hand-matched across the bar, nvim, bat and the prompt, and a client not
// paying for bytes should not have them rounded off for nothing.
function quantFor(width) { return width >= 120 ? 4 : width >= 100 ? 8 : 16 }
// Real data changes on human timescales; re-reading it every frame would spend
// the whole budget on syscalls for numbers that move once a minute.
const DATA_EVERY = 2000
const PANEL_SSH_ROWS = 5
// CPU is the exception: it is the graph's time axis, so it is sampled every
// second. At one sample per data tick a 120-column graph would take eight
// minutes to fill; at 1s it reads as live within a minute or two.
const CPU_EVERY = 1000

// ---------------------------------------------------------------- colour ----
// The same two spellings bin/lib/tmux-theme.sh handles: eight themes are
// #rrggbb, jewel is 256-colour colourNNN. Anything else yields no escape at
// all rather than a broken one, exactly as ansi_for does.
// Colour QUANTISATION, the single biggest lever on what a frame costs.
// Measured at 52x27: 81% of a frame's bytes are colour escapes, and a frame
// emits ~250 of them for only ~76 distinct colours -- the same colours
// re-established over and over, because a shaded solid scanned row by row puts
// a different face in every few cells. Rounding channels merges neighbouring
// shades, and a merged neighbour costs no escape at all.
let QUANT = 1
function setQuant(n) { QUANT = Math.max(1, n | 0) }
const qz = (v) => (QUANT <= 1 ? v : Math.min(255, Math.round(v / QUANT) * QUANT))

function fg(value) {
  if (!value) return ''
  const hex = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(value)
  if (hex) return `\x1b[38;2;${qz(parseInt(hex[1], 16))};${qz(parseInt(hex[2], 16))};${qz(parseInt(hex[3], 16))}m`
  const idx = /^colou?r(\d{1,3})$/.exec(value)
  if (idx) return `\x1b[38;5;${idx[1]}m`
  return ''
}

// Mix toward black, so a rain tail can fade without needing more theme tokens.
function dim(value, factor) {
  const hex = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(value || '')
  if (!hex) return fg(value)
  const c = [1, 2, 3].map((i) => qz(Math.round(parseInt(hex[i], 16) * factor)))
  return `\x1b[38;2;${c[0]};${c[1]};${c[2]}m`
}

// Blend two theme colours. dim() fades toward BLACK, which is right for a rain
// tail but wrong for a pulse: fading red toward black reads as red-to-grey, and
// grey is the colour this panel uses for "nothing to see". Cycling between two
// real palette colours keeps the alert saturated at both ends of the beat.
//
// 256-colour themes (jewel) cannot be interpolated -- there is no arithmetic
// between palette indices that means anything -- so they alternate between the
// two colours instead. A hard switch rather than no pulse at all.
let mixHex = null
try { ({ mixHex } = require(path.join(__dirname, '..', 'tmarchy', 'lib', 'colour'))) } catch {}

function mix(a, b, t) {
  return mixHex ? fg(mixHex(a, b, t)) : fg(t < 0.5 ? a : b)
}

function loadTheme() {
  const t = {}
  try {
    for (const line of fs.readFileSync(path.join(STATE, 'current.sh'), 'utf8').split('\n')) {
      const m = /^TMARCHY_([A-Z_]+)='(.*)'$/.exec(line)
      if (m) t[m[1].toLowerCase()] = m[2]
    }
  } catch { /* no state yet: the fallback below still paints something */ }
  return {
    name: t.theme || 'tokyo-night',
    bg: t.bg || '#1a1b26',
    fg: t.fg || '#c0caf5',
    dim: t.dim || '#565f89',
    accent: t.accent || '#7aa2f7',
    // accent-alt BEFORE accent-muted. The breath blends toward this, and muted
    // is by definition the dimmer, more tertiary of the two -- blending toward
    // it makes the swing hard to see, which defeats the point of having a
    // colour signal at all. (It was the other way round from when nothing but
    // the rain read this; the breath is now its only consumer.)
    accentAlt: t.accent_alt || t.accent_muted || '#bb9af7',
    wait: t.wait || '#f7768e',
    busy: t.busy || '#e0af68',
    done: t.done || '#9ece6a',
    info: t.info || '#73daca',
    remote: t.remote || '#7dcfff',
  }
}

// ------------------------------------------------------------------ data ----
// sessionState is the ONE definition of agent state in this repo -- the bar,
// prefix + ~ and the triage picker all call it. Borrowing it here means the
// nodes cannot disagree with the tab colours they are sitting under.
let sessionState = null
let isStale = null
let subagentCount = null
let paneIsWorking = null
let paneIsPrompting = null
try {
  ({ sessionState, isStale, subagentCount, paneIsWorking, paneIsPrompting } =
    require(path.join(__dirname, '..', 'tmarchy', 'lib', 'scout')))
} catch { /* tmarchy absent: nodes simply do not appear */ }

// The live pane list, which is AUTHORITATIVE for whether a session still
// exists -- scout's stale flag is not (see isStale in lib/scout.js). One tmux
// call per two-second data tick, not per frame. A failure yields null, which
// means "nothing to refute the flag with" rather than "no panes".
// One query, two answers: which panes exist, and what their windows are called.
// The window name is what you see in the tab bar, and it is the name you would
// use to say which agent you mean -- the working directory's basename is often
// something else entirely (a worktree at ~/.homedir reads as ".homedir" while
// its tab says "tmarchy"), which made the list look like other people's agents.
function paneInfo() {
  try {
    const out = require('node:child_process').execFileSync(
      'tmux', ['list-panes', '-a', '-F', '#{pane_id}\t#{window_name}'],
      { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'], timeout: 2000 })
    const live = new Set()
    const names = new Map()
    for (const line of out.trim().split('\n')) {
      if (!line) continue
      const [id, name] = line.split('\t')
      if (!id) continue
      live.add(id)
      if (name) names.set(id, name)
    }
    // An empty result means the query failed, not that there are no panes: a
    // live tmux server always has at least one.
    return live.size ? { live, names } : null
  } catch { return null }
}

// What the pane itself says, for agents scout has no hook evidence about. See
// paneIsWorking in lib/scout.js: a session scout discovered by scanning panes
// gets `phase: 'idle'` as a default meaning "never heard from", and believing
// it makes a working agent invisible to the spin and the breath.
//
// One capture per agent pane per two-second data tick, not per frame, and only
// for panes whose record has nothing better to offer.
function paneVerdict(pane) {
  if (!paneIsWorking && !paneIsPrompting) return null
  try {
    const text = require('node:child_process').execFileSync(
      'tmux', ['capture-pane', '-p', '-t', pane],
      { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'], timeout: 1000 })
    if (paneIsPrompting && paneIsPrompting(text)) return 'wait'
    if (paneIsWorking && paneIsWorking(text)) return 'busy'
  } catch { /* pane gone, or no tmux at all */ }
  return null
}

// Pane-backed agents, from scout. Returns [] on any failure -- a torn
// status.json must not take the providers down with it, and vice versa.
function scoutAgents() {
  if (!sessionState) return []
  try {
    const doc = JSON.parse(fs.readFileSync(path.join(os.homedir(), '.tmux-scout', 'status.json'), 'utf8'))
    const info = paneInfo()
    const live = info && info.live
    const out = []
    for (const s of Object.values(doc.sessions || {})) {
      if (isStale ? isStale(s, live) : (!s.tmuxPane || s.staleReason || s.endedAt)) continue
      let state = sessionState(s)
      // Upgrade only, and only when the record has no opinion worth keeping:
      // scout seeing 'running' or 'completed' beats anything scraped off a
      // screen, but its idle-by-default does not.
      if (!state || state === 'idle') state = paneVerdict(s.tmuxPane) || state
      if (!state) continue
      // Keyed by pane, not by label: two worktrees of the same repo share a
      // basename, and a sticky list that merged them would silently report one
      // agent where two had asked.
      // The tab's name first, the directory only as a fallback -- outside tmux,
      // or for a pane the query did not see, there is no window name to use.
      const named = info && info.names.get(s.tmuxPane)
      out.push({
        key: s.tmuxPane,
        // Where to jump on a click. For a pane-backed agent that is the key
        // itself; a provider's agent may have no pane at all, so the two are
        // separate fields rather than one doing both jobs.
        pane: s.tmuxPane,
        label: named || path.basename(s.workingDirectory || '') || '?',
        state,
        // Only meaningful for a parent we have already established is live --
        // see subagentCount's note on scout's leaked records.
        subagents: subagentCount ? subagentCount(s) : 0,
        // scout records what KIND of agent this is (claude, codex, gemini).
        // Carried through so the panel can draw them differently -- the same
        // field a provider may set, so one rule covers both sources.
        agentType: s.agentType || null,
      })
    }
    return out
  } catch { return [] }
}

// Every agent, whatever it is running in. The two sources are read
// independently and merged here: scout owns the tmux panes, and whatever
// filled agents.d owns the rest. Neither can fail the other.
function readAgents() {
  const out = scoutAgents()
  if (readProviders) {
    // readProviders never throws -- a file it cannot parse costs that producer
    // its rows and nothing else -- but it does touch the filesystem, and this
    // is on the frame loop's data tick.
    try { out.push(...readProviders()) } catch { /* no providers this tick */ }
  }
  // Sorted for the panel's list, but WAITING agents are pulled to the front
  // before the cap: the panel shows twelve, and an agent that needs you
  // sorting thirteenth alphabetically must not be the one that falls off.
  return out
    .sort((a, b) => (a.state === 'wait' ? 0 : 1) - (b.state === 'wait' ? 0 : 1) ||
      a.label.localeCompare(b.label))
    // A safety bound, not a display budget -- the panel decides how many rows
    // it can actually spare. Waiting agents are already sorted to the front,
    // so if anything is ever cut here it is never one that needs you.
    .slice(0, 24)
}

// Quota comes from tmarchy's own segment rather than being re-parsed here, so
// the thresholds the panel paints red are literally the ones the status bar
// warns on. It also owns the staleness rule -- a 45-minute-old reading is
// dropped rather than shown as current -- and the detached refresher, which
// matters here in a way it does not on the bar: a locked session stops
// redrawing its status line, so without this a screensaver left up for an hour
// would quietly show hour-old numbers.
// Agents that are not tmux panes -- a containerised relay, a queue runner, a
// daemon elsewhere. See tmarchy/lib/agents.js: tmarchy reads a drop directory
// and never learns who fills it.
let readProviders = null
try { ({ readProviders } = require(path.join(__dirname, '..', 'tmarchy', 'lib', 'agents'))) }
catch { /* tmarchy absent: only pane-backed agents appear */ }

let alerts = null
try { alerts = require(path.join(__dirname, '..', 'tmarchy', 'lib', 'alerts')) }
catch { /* tmarchy absent: no banner, everything else still draws */ }

let quotaSeg = null
try {
  quotaSeg = require(path.join(__dirname, '..', 'tmarchy', 'segments.d', 'quota.js'))
} catch { /* tmarchy absent: the CLAUDE section simply does not appear */ }

function readClaude() {
  if (!quotaSeg) return []
  const record = quotaSeg.readCache()
  quotaSeg.maybeRefresh(record)
  return quotaSeg.bucketRows(record)
}

function readData() {
  const agents = readAgents()
  return {
    agents,
    wait: agents.filter((a) => a.state === 'wait').length,
    // Subagents count as work in progress, because they are: a parent running
    // three of them has four things going at once, and the solid should say so.
    busy: agents.filter((a) => a.state === 'busy').length +
      agents.reduce((n, a) => n + (a.subagents || 0), 0),
    load: os.loadavg()[0].toFixed(2),
    claude: readClaude(),
    host: os.hostname().split('.')[0],
    up: Math.floor(os.uptime() / 3600),
  }
}

// ------------------------------------------------------------------ rain ----
// Half the glyphs are katakana because that is the look; the rest are hex and
// the repo's own vocabulary, so the fall occasionally spells something true.
// HALF-WIDTH katakana (U+FF65-FF9F), not the full-width forms. Full-width kana
// occupy TWO terminal columns, and this renderer addresses a one-character grid
// -- mixing them in overflows every row and shifts the HUD sideways, which is
// exactly what the first version did. Half-width is also the authentic
// terminal-matrix look, so the constraint and the aesthetic agree.
const GLYPHS = ('ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ' +
  '0123456789ABCDEF' + '#{}[]<>/\\|=+-*%$~').split('')
const WORDS = ['tmarchy', 'scout', 'wait', 'busy', 'agent', 'quota', 'pane', 'tmux', 'idle']

function makeColumn(rows) {
  return {
    y: -Math.floor(Math.random() * rows),
    speed: 0.3 + Math.random() * 0.9,
    len: 6 + Math.floor(Math.random() * 14),
    word: Math.random() < 0.06 ? WORDS[Math.floor(Math.random() * WORDS.length)] : null,
  }
}

// The ground is TRUE BLACK, painted by us rather than inherited: the alt
// screen otherwise shows through to the emulator's own background, so one
// session looked like three different screensavers depending on which client
// was attached. Module scope because the frame writer needs it too -- it is
// re-established on a full repaint and then left alone.
const BG = '\x1b[48;2;0;0;0m'

// ----------------------------------------------------------- frame writer ----
// Emit only the cells that CHANGED, and only the colour escapes that changed
// with them.
//
// This is the difference between a screensaver and a data bill. Measured on a
// real backgrounded iPhone client at 52x27, the full repaint this replaced
// cost 305 KB/s -- a gigabyte an hour -- while only 17.6% of cells differ
// between consecutive frames.
//
// tmux already does exactly this for a pane: the same content through a pane
// reached a client at 37.8 KB/s, eight times less. But tmux is NOT in the path
// for the case that actually hurts. A locked client runs `lock-command` with
// that client's own tty as stdin and stdout -- verified, the tty the lock
// command sees is the device `list-clients` reports -- so for the screensaver
// nothing is diffing anything, and this is the only thing that can.
//
// Two details make it cheap rather than merely correct:
//
//   SGR state is terminal-global and SURVIVES CURSOR MOVES, so the background
//   is set once per full repaint and a foreground only when it actually
//   changes. Nothing is reset mid-frame: a reset would clear the background
//   too, and then every following cell would have to re-establish it. (The old
//   code reset at the end of every row, which is why it re-emitted BG at the
//   start of every row.)
//
//   A BLANK cell never changes the colour. A space shows no foreground, so
//   emitting one for it is bytes spent on nothing -- and blanks are most of
//   what changes as the rain falls and the solid turns.
let prevGrid = null
let curSgr = null

function invalidateFrame() { prevGrid = null }

// A cell is `sgrPrefix + oneCharacter`, which is how every drawing site in
// this file and in tmarchy-{geo,panel}.js builds one. Split rather than
// requiring them all to hand over a pair: the contract is already established
// across three files, and only the cells that changed are ever parsed.
const CELL_RE = /^((?:\x1b\[[0-9;]*m)*)([\s\S]*)$/
// How many unchanged cells are worth redrawing to avoid a cursor jump. Tuned
// by measurement, not by argument -- see the sweep in the commit message.
const GAP = Number(process.env.TMARCHY_SAVER_GAP) || 8

function writeFrame(out, grid, rows, cols) {
  let full = false
  if (!prevGrid || prevGrid.length !== rows || prevGrid[0].length !== cols) {
    prevGrid = Array.from({ length: rows }, () => new Array(cols).fill(null))
    full = true
  }
  const buf = []
  // Re-establish the background on a full repaint only. On an incremental one
  // it is still set from last time, because nothing since has reset it.
  if (full) { buf.push(BG); curSgr = null }

  for (let y = 0; y < rows; y++) {
    const row = grid[y]
    const prow = prevGrid[y]
    const at = (i) => (row[i] === null ? ' ' : row[i])
    let x = 0
    while (x < cols) {
      while (x < cols && !full && prow[x] === at(x)) x++   // skip to the next change
      if (x >= cols) break

      // Extend the run THROUGH short unchanged gaps rather than stopping at
      // each one. A cursor address costs seven or eight bytes and an unchanged
      // cell costs one, so jumping over a three-cell gap spends more than
      // redrawing it -- and the first version of this did exactly that, which
      // is why diffing alone only bought 1.9x when tmux gets 8x on the same
      // content. Bridging also lengthens runs, which is what lets the colour
      // coalescing below actually pay: scattered single cells change colour
      // almost every time.
      const start = x
      let last = x
      let i = x
      while (i < cols) {
        if (full || prow[i] !== at(i)) last = i
        else if (i - last > GAP) break
        i++
      }

      // Cursor addressing rather than newlines: writing into the LAST column
      // auto-wraps, so a trailing newline lands a row further down than
      // intended -- every other line blank, and the HUD shoved sideways.
      buf.push(`\x1b[${y + 1};${start + 1}H`)
      for (let j = start; j <= last; j++) {
        const c = at(j)
        const m = CELL_RE.exec(c)
        const ch = m[2]
        if (ch !== ' ') {
          const sgr = m[1] || '\x1b[39m'       // no colour of its own: default fg
          if (sgr !== curSgr) { buf.push(sgr); curSgr = sgr }
        }
        buf.push(ch)
        prow[j] = c
      }
      x = last + 1
    }
  }
  if (buf.length) out.write(buf.join(''))
}

// ---------------------------------------------------------------- banner ----
// The one thing allowed to sit over the middle of the pane.
//
// Everything else in this file is arranged to keep text out of the solid's way
// -- the readouts live in a column, the graph in a band -- because text through
// the centre punches a hole in the shape. An alert is the deliberate exception:
// interrupting the picture IS the job, and something you have to hunt for in a
// dim side column is not an alert. The solid is told to start below it.
const BANNER_MAX = 64

// Clickable regions for the banner's names, rebuilt each frame by drawBanner
// and read by the input handler. Module-level because the two are on opposite
// sides of the frame loop.
const hits = []

function drawBanner(grid, rows, cols, mainW, frame, theme, sticky, now, agents) {
  if (!alerts || !sticky || !sticky.length) return 0

  const title = alerts.bannerTitle(sticky)
  const entries = alerts.bannerEntries(sticky, now)
  const live = entries.some((e) => e.active)

  const width = Math.max(24, Math.min(BANNER_MAX, mainW - 4))
  const inner = width - 2
  const x0 = Math.max(0, Math.floor((mainW - width) / 2))
  if (width > mainW || rows < 8) return 0

  // Pulse only while something is STILL waiting. A list of agents that have
  // all since given up is a record, not an emergency, and a box that throbs
  // forever is one you learn to stop seeing.
  //
  // The beat runs between the theme's BUSY and WAIT colours -- amber to red --
  // rather than dimming red toward black, which read as red-to-grey and made
  // the low half of every pulse look like the panel's "nothing here" colour.
  const beat = (Math.sin(frame / 5) + 1) / 2
  const hot = live ? mix(theme.busy, theme.wait, beat) : dim(theme.wait, 0.45)
  const cold = dim(theme.wait, 0.35)

  const layout = alerts.bannerLayout(entries, inner)
  const text = layout.text

  const head = ` ${title} `.slice(0, inner)
  const put = (y, str, colour) => {
    for (let i = 0; i < str.length; i++) {
      const x = x0 + i
      if (x >= 0 && x < cols && y >= 0 && y < rows) grid[y][x] = colour + str[i]
    }
  }
  put(0, '\u256d' + head + '\u2500'.repeat(Math.max(0, inner - head.length)) + '\u256e', hot)
  put(1, '\u2502 ' + text.padEnd(inner - 1) + '\u2502', live ? hot : cold)
  put(2, '\u2570' + '\u2500'.repeat(inner) + '\u256f', hot)

  // Where each name ended up, so a click can be resolved to the agent under it.
  // Recomputed every frame rather than cached: the widths move as the elapsed
  // times tick over from "9s" to "10s", and a stale region would send you to
  // the agent next door.
  //
  // A name only becomes clickable if it has somewhere to go. An agent that is
  // not a tmux pane -- anything out of agents.d -- has no pane to select, so it
  // gets no region at all and a click on it falls through to "clicked the
  // background". The alternative would be a click that looks live and does
  // nothing, which reads as a broken saver rather than an agent that simply is
  // not somewhere tmux can take you.
  //
  // Note this is the CURRENT pane list, while the sticky entries outlive it:
  // an agent that has since gone stops being clickable, which is right.
  const paneFor = new Map((agents || []).map((a) => [a.key, a.pane]))
  hits.length = 0
  const textX = x0 + 2                       // past the border and its space
  for (const seg of layout.segments) {
    const pane = paneFor.get(seg.key)
    if (!pane) continue
    hits.push({ y: 1, x0: textX + seg.start, x1: textX + seg.start + seg.length - 1, pane })
  }
  return 3
}

// ------------------------------------------------------------------ main ----
function main() {
  const out = process.stdout
  if (!out.isTTY) {
    process.stderr.write('tmarchy-saver: needs a terminal\n')
    process.exit(1)
  }

  let theme = loadTheme()
  let data = readData()
  // Panel stats are RATES (cpu jiffies, net bytes), so they are sampled on the
  // data tick rather than per frame -- per frame the deltas would be noise
  // divided by 50ms.
  let stats = panel ? panel.read() : {}
  // Pings are async children on their own 15s timer; the frame loop only ever
  // reads the cache they fill. Started here rather than at require time so a
  // module that is merely loaded (by a test, say) never spawns anything.
  if (ping) ping.start()
  let reach = ping ? ping.read() : null
  // The sticky alert list, held in memory for the life of the saver. Dismissing
  // the saver is what acknowledges it, so there is deliberately nothing on disk.
  let sticky = []
  let cols = out.columns || 80
  let rows = out.rows || 24
  let columns = Array.from({ length: cols }, () => makeColumn(rows))
  // TWO counters, and the split is load-bearing. `ticks` is real timer
  // firings and drives the data/CPU sampling, which is wall-clock work.
  // `frame` is the animation clock measured in BASE_FPS frames, advanced by
  // STEP, so every renderer's frame-tuned timing keeps its real-world speed
  // whatever rate we are actually drawing at.
  let ticks = 0
  let frame = 0

  // Mouse reporting, so a CLICK dismisses the saver the way a keypress does.
  // The screensaver's contract is "any input wakes it", and a click is input --
  // having to reach for the keyboard to clear a screensaver you clicked on
  // reads as a hang.
  //
  // 1000 is press/release only, deliberately not 1002/1003: with motion
  // reporting the saver would vanish the instant the pointer drifted over the
  // window, which is not the same gesture at all. 1006 asks for SGR-encoded
  // coordinates -- irrelevant to us, since we discard the bytes, but the legacy
  // encoding breaks past column 223 and some terminals refuse to send anything
  // they cannot encode.
  //
  // tmux with `mouse on` normally eats mouse events for its own pane handling;
  // enabling this is precisely what flips #{mouse_any_flag} to 1 and makes tmux
  // forward them to us instead (verified against a scratch server: a plain cat
  // reports 0, a process that has sent 1000h reports 1).
  // A true-black ground, painted by the saver rather than inherited from the
  // terminal. The alt screen otherwise shows through to whatever the emulator's
  // background is, which differs between Rio, Tabby and ShellFish -- so the same
  // session looked like three different screensavers depending on what was
  // attached. Black also buys the most contrast for a renderer whose whole
  // effect is a ramp from '.' to '@'.
  //
  // Re-emitted at the START of every row, because each row ends with a full SGR
  // reset (which the foreground colours need) and that clears the background
  // too. Cheap: one escape per row, not per cell -- the per-cell escapes only
  // ever set a foreground, so the row's background survives them.
  const MOUSE_ON = '\x1b[?1000h\x1b[?1006h'
  const MOUSE_OFF = '\x1b[?1006l\x1b[?1000l'

  // Jump to the agent whose name was clicked. Same sequence as bin/tmux-agents
  // and tmux-scout-next-wait: a pane id may live in another SESSION, and a bare
  // select-pane only acts within the current one -- it would silently do
  // nothing, which looks like a dead click rather than a missing switch.
  //
  // Three separate tmux calls rather than one batched command list, deliberately:
  // tmux rejects an entire list if any command in it is invalid, so a pane that
  // vanished between the render and the click would lose the switch as well as
  // the select. This runs once, on the way out, so the extra forks cost nothing.
  const jumpTo = (pane) => {
    const run = (args) => {
      try {
        return require('node:child_process').execFileSync('tmux', args,
          { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'], timeout: 2000 }).trim()
      } catch { return '' }
    }
    const sess = run(['display-message', '-p', '-t', pane, '#{session_name}'])
    const win = run(['display-message', '-p', '-t', pane, '#{window_id}'])
    if (!sess && !win) return false            // the pane is gone; just exit
    if (sess) run(['switch-client', '-t', sess])
    if (win) run(['select-window', '-t', win])
    run(['select-pane', '-t', pane])
    return true
  }

  // SGR mouse press: ESC[<button;col;rowM. Only button 0 (left) and only a
  // press -- the matching release arrives as 'm' and must not count as a second
  // click. Coordinates are 1-based.
  const SGR_PRESS = /\x1b\[<(\d+);(\d+);(\d+)M/
  // Ctrl-C arrives as a BYTE, not a signal: raw mode is on, so the SIGINT
  // handler below never sees it and a kiosk with no quit key would need a kill
  // from another terminal.
  const QUIT_KEYS = new Set(['q', 'Q', '\x03'])

  const onInput = (buf) => {
    const str = String(buf)
    const m = SGR_PRESS.exec(str)
    if (m && m[1] === '0') {
      const x = Number(m[2]) - 1
      const y = Number(m[3]) - 1
      const hit = hits.find((h) => h.y === y && x >= h.x0 && x <= h.x1)
      // A click on a name goes to that agent. As a SCREENSAVER that also
      // dismisses it -- you are leaving, so the lock should end. As a DISPLAY
      // it does not: the point of kiosk mode is that the window keeps showing
      // this, and sending the tmux session somewhere else is no reason to tear
      // the display down.
      if (hit) { jumpTo(hit.pane); cleanup(); return }
      // A click anywhere else dismisses a screensaver, but must not kill a
      // display you deliberately left running.
      if (KIOSK) return
      cleanup()
      return
    }
    // As a screensaver, ANY key leaves -- that is what a lock is for. As a
    // display, only a deliberate one does.
    if (KIOSK && !QUIT_KEYS.has(str)) return
    cleanup()
  }

  const cleanup = () => {
    // Mouse mode off FIRST and unconditionally. Leaving it on would have the
    // terminal spraying escape sequences at whatever shell comes back -- a
    // screensaver that breaks your prompt on the way out.
    out.write(MOUSE_OFF + '\x1b[?25h\x1b[0m\x1b[?1049l')   // cursor, reset, leave alt screen
    try { process.stdin.setRawMode(false) } catch {}
    process.exit(0)
  }

  // Background BEFORE the clear: ESC[2J erases using the current SGR background,
  // so setting it afterwards would leave the first frame on the terminal's own
  // colour until every cell had been painted over.
  out.write('\x1b[?1049h\x1b[?25l' + BG + '\x1b[2J' + MOUSE_ON)
  process.stdin.setRawMode(true)
  process.stdin.resume()
  process.stdin.on('data', onInput)             // ANY key leaves, as a lock should
  process.on('SIGINT', cleanup)
  process.on('SIGTERM', cleanup)
  out.on('resize', () => {
    cols = out.columns || 80
    rows = out.rows || 24
    columns = Array.from({ length: cols }, () => makeColumn(rows))
    out.write(BG + '\x1b[2J')
    // The diff's memory of the screen is now wrong in both dimensions, so the
    // next frame has to be a full repaint rather than a set of edits against a
    // screen that no longer exists.
    invalidateFrame()
    retime()                                   // a narrower window is a cheaper one
  })

  const stateColour = (s) =>
    s === 'wait' ? theme.wait : s === 'busy' ? theme.busy : s === 'done' ? theme.done : theme.dim

  const onTick = () => {
    ticks++
    frame += STEP
    if (ticks % Math.max(1, Math.round(DATA_EVERY / TICK)) === 0) {
      data = readData()
      theme = loadTheme()                       // switch theme and the rain follows
      if (panel) stats = panel.read()
      if (ping) reach = ping.read()
      if (alerts) {
        sticky = alerts.stickyUpdate(sticky,
          data.agents.filter((a) => a.state === 'wait' && a.key), Date.now())
      }
    }
    if (panel && ticks % Math.max(1, Math.round(CPU_EVERY / TICK)) === 0) {
      // The gauge shows the sampler's newest reading rather than waiting for the
      // next data tick, so the CPU number and the graph's right edge agree.
      const c = panel.sampleCpu()
      if (c !== null && stats) stats.cpu = c
    }

    // The renderers' timing is written in whole BASE_FPS frames -- morph
    // cycles, blink phases, the banner pulse -- so they get an integer frame
    // number that advances in STEP-sized jumps rather than the fractional
    // clock the accumulating motion needs.
    const aframe = Math.floor(frame)

    const grid = Array.from({ length: rows }, () => new Array(cols).fill(null))

    // The telemetry panel owns the right-hand columns; everything else is
    // centred in what is LEFT, not in the whole pane. Computed before drawing
    // so the solid and the rain can both avoid it.
    // The demo draws ALONE -- see the demo block below. Suppressing the panel
    // and the graph here rather than inside the demo keeps the reservations
    // honest: everything else centres in what is LEFT of the pane, so a demo
    // that merely drew over them would still be squeezed into the middle third.
    const soloDemo = MODE === 'demo' && demo
    const right = (!soloDemo && panel && cols >= panel.MIN_COLS && rows >= 14) ? panel.WIDTH : 0
    const mainW = cols - right
    // The CPU graph owns the bottom band, full width -- it runs UNDER the panel
    // too, which is deliberate: a timeline that stopped at the panel's edge
    // would read as clipped rather than as a backdrop.
    // Shorter than the filled version was. A sparse trace only ever occupies one
    // cell per column, so a tall band on an idle box is empty pane rather than
    // a fuller-looking graph -- the height buys resolution, not presence.
    const graphH = (!soloDemo && panel && rows >= 18) ? Math.max(4, Math.min(6, Math.floor(rows * 0.18))) : 0

    // --- the alert banner ---------------------------------------------------
    // Drawn FIRST so the solid can be told to start below it, rather than being
    // drawn over afterwards and leaving a hole in the shape.
    const bannerH = drawBanner(grid, rows, cols, mainW, aframe, theme, sticky, Date.now(), data.agents)

    // Hosts pinned to the solid like cities on a globe. REAL addresses, not
    // invented ones: these are the machines this box actually talks to, carrying
    // the address the name resolved to and coloured by whether it answered.
    // Everything else on this screen is real, and a solid studded with
    // plausible-looking fiction would be the one thing you could not trust.
    const points = !reach ? [] : [...(reach.net || []), ...(reach.ssh || [])]
      .map((e) => ({
        label: e.ip || e.label,
        // The same continuous scale the PING and SSH rows use, from the same
        // function -- a host's dot on the solid and its row in the panel are
        // the same colour because they are literally the same computation.
        colour: (ping && ping.latencyHex && ping.latencyHex(theme, e.ms, e.state)) || theme.dim,
      }))

    // --- the demo ----------------------------------------------------------
    // It draws ALONE: a resolving banner next to a rotating solid, a telemetry
    // panel and a CPU graph would be four things competing for the eye, and
    // the whole point of a demo is that it is the thing you are looking at.
    if (MODE === 'demo' && demo) {
      demo.render({ grid, rows, cols, frame: aframe, theme, fg, dim, mix,
        word: data.host || os.hostname().split('.')[0] })
    }

    // --- solid geometry ---------------------------------------------------
    if (MODE !== 'rain' && MODE !== 'demo' && geo) {
      // Spin tracks load per core, so the thing visibly works harder when the
      // box does. That is the readout, not decoration.
      // Same agent count the breath uses, so the two signals agree about how
      // busy things are rather than each having its own opinion.
      const spin = geo.spinFactor(os.loadavg()[0],
        (stats && stats.cores) || os.cpus().length, data.busy)
      // Spin tracks the machine's load; the breath tracks how many agents are
      // actually working. Two different questions, so two different signals --
      // a box can be busy with one agent or idle with six waiting.
      geo.render({ grid, rows, cols, frame: aframe, theme, fg, dim, spin,
        step: STEP, right,
        bottom: graphH, top: bannerH, points, pulse: geo.pulseFor(data.busy) })
    }

    // --- rain ---------------------------------------------------------------
    if ((MODE === 'rain' || !geo) && MODE !== 'demo') columns.forEach((col, x) => {
      if (x >= mainW) return                    // leave the panel's columns alone
      const bannerFloor = bannerH
      col.y += col.speed * STEP
      if (col.y - col.len > rows) Object.assign(col, makeColumn(rows), { y: -col.len })
      const head = Math.floor(col.y)
      for (let i = 0; i < col.len; i++) {
        const y = head - i
        if (y < bannerFloor || y >= rows) continue
        const ch = col.word && i < col.word.length
          ? col.word[col.word.length - 1 - i]
          : GLYPHS[(x * 31 + y * 17 + Math.floor(aframe / 3)) % GLYPHS.length]
        // Head is bright, tail fades to nothing: the whole trick of the effect.
        const colour = i === 0 ? fg(theme.fg)
          : col.word ? fg(theme.info)
            : dim(theme.accent, Math.max(0.12, 1 - i / col.len))
        grid[y][x] = colour + ch
      }
    })

    // Agent nodes and the HUD used to float over the middle of the pane. They
    // live in the telemetry panel now: the same information, in a column that
    // does not cut through the solid or fight the graph for the bottom rows.

    // --- CPU over time -----------------------------------------------------
    if (graphH && stats && stats.cpuHistory) {
      panel.renderGraph({ grid, rows, cols, theme, fg, dim,
        history: stats.cpuHistory, height: graphH })
    }

    // --- telemetry panel ---------------------------------------------------
    if (right) {
      panel.render({ grid, rows, cols, frame: aframe, theme, fg, dim,
        stats, agents: data.agents, claude: data.claude,
        // The panel gets a SHORT ssh list: its rows are a display budget, while
        // the globe above pins every tracked host. Without this the panel would
        // grow to thirteen ssh rows on a tall pane and crowd out everything else.
        ping: reach && { net: reach.net, ssh: (reach.ssh || []).slice(0, PANEL_SSH_ROWS) },
        meta: { theme: theme.name, host: data.host, uptimeHours: data.up } })
    }

    writeFrame(out, grid, rows, cols)
  }

  // The timer is restartable because the frame rate is a function of the
  // terminal's width, and the terminal can be resized under us.
  let timer = null
  const retime = () => {
    FPS = fpsFor(cols)
    setQuant(Number(process.env.TMARCHY_SAVER_QUANT) || quantFor(cols))
    TICK = Math.round(1000 / FPS)
    STEP = BASE_FPS / FPS
    if (timer) clearInterval(timer)
    timer = setInterval(onTick, TICK)
  }
  retime()
}

main()
