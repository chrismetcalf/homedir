#!/usr/bin/env bash
# tmux-ssh — fuzzy-pick a host and open an SSH session on it.
#
# "Known hosts" is not a usable source here: ~/.ssh/known_hosts is hashed
# (HashKnownHosts), so it lists no readable names at all, and ~/.ssh/config is
# an Include plus a Host * catch-all. Tailscale is where the hosts actually
# are, so the picker merges:
#
#   [ssh]  Host entries from ~/.ssh/config and whatever it Includes
#   [net]  nodes from `tailscale status`, dimmed when offline
#
# Rows are "TARGET<TAB>KIND<TAB>DISPLAY" exactly as tmux-goto does it, with fzf
# on --with-nth=3.., so the host is never recovered from display text.
#
# Enter opens a new window named for the host; Ctrl-V splits the current window
# instead. The window name matters: tmarchy's tab shows it, and a window opened
# with -n keeps that name rather than tracking the running command.
#
# Sourced with TMUX_SSH_LIB=1 it defines its functions and exits.
set -uo pipefail

TMUX_SSH_SELF="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
    TMUX_SSH_SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
fi
TMUX_SSH_LIBDIR="$(dirname "$TMUX_SSH_SELF")/lib"
# shellcheck source=lib/tmux-frecency.sh
[ -r "$TMUX_SSH_LIBDIR/tmux-frecency.sh" ] && . "$TMUX_SSH_LIBDIR/tmux-frecency.sh"

GLYPH_HOST='󰢹'

C_ACCENT=""
C_DIM=""
C_RESET=""

# Same conversion as tmux-goto and tmux-keys: eight themes give #rrggbb, jewel
# gives colourNNN, anything else yields no colour rather than a broken escape.
ansi_for() {
    local v="${1:-}"
    case "$v" in
        '#'??????)
            printf '\033[38;2;%d;%d;%dm' \
                "$((16#${v:1:2}))" "$((16#${v:3:2}))" "$((16#${v:5:2}))" ;;
        colour[0-9]*|color[0-9]*)
            printf '\033[38;5;%dm' "${v#colo*r}" ;;
    esac
}

load_theme() {
    C_ACCENT=$(ansi_for "$(tmux show -gv @theme-remote 2>/dev/null)")
    C_DIM=$(ansi_for "$(tmux show -gv @theme-dim 2>/dev/null)")
    if [ -n "$C_ACCENT$C_DIM" ]; then C_RESET=$'\033[0m'; else C_RESET=""; fi
}

# A host is pasted straight into a command line, so anything outside the set
# that can appear in a real hostname or user@host is rejected outright. A
# crafted ~/.ssh/config or tailscale node name must not be able to append a
# second command.
valid_host() {
    case "${1:-}" in
        "") return 1 ;;
        *[!A-Za-z0-9._@-]*) return 1 ;;
        -*) return 1 ;;
        *) return 0 ;;
    esac
}

# Host lines from an ssh config. Patterns are skipped: "Host *" matches
# everything and is a rule, not a machine you can connect to.
hosts_from_ssh_config() {
    printf '%s\n' "${1:-}" \
        | sed -n 's/^[[:space:]]*[Hh]ost[[:space:]]\+//p' \
        | tr ' \t' '\n\n' \
        | grep -v '^$' \
        | grep -v '[*?!]' \
        | sort -u
}

# ~/.ssh/config is mostly an Include here, so the hosts live one file deeper.
# Globs and ~ are expanded, since ssh accepts both. One level only: nested
# includes are not a thing in this config and following them blindly invites a
# loop.
read_ssh_config() {
    local main="${1:-$HOME/.ssh/config}" dir text line target
    [ -r "$main" ] || return 0
    text=$(cat "$main")
    printf '%s\n' "$text"
    dir=$(dirname "$main")
    printf '%s\n' "$text" | sed -n 's/^[[:space:]]*[Ii]nclude[[:space:]]\+//p' | while read -r line; do
        # One Include line may name several targets.
        for target in $line; do
            # ssh accepts ~ and globs here and both were silently dropped: a
            # conf.d/*.conf layout -- a common way to organise this file --
            # contributed no hosts at all, with nothing to say so.
            case "$target" in
                '~/'*) target="$HOME/${target#\~/}" ;;
            esac
            case "$target" in
                /*) ;;
                *)  target="$dir/$target" ;;
            esac
            # Deliberately unquoted: this is where the glob expands. A pattern
            # matching nothing stays literal and the -r test discards it. The
            # cost is that a path containing spaces is split, which ssh config
            # paths effectively never have -- and quoting would disable the
            # globbing this exists to support.
            for path in $target; do
                [ -r "$path" ] && cat "$path"
            done
        done
    done
}

# `tailscale status` columns are: ip, host, owner, os, then a free-text state
# that contains "offline" for nodes that are down.
hosts_from_tailscale() {
    printf '%s\n' "${1:-}" | awk '
        NF >= 4 && $1 ~ /^[0-9]+\./ {
            host = $2; os = $4
            rest = ""
            for (i = 5; i <= NF; i++) rest = rest " " $i
            state = (rest ~ /offline/) ? "offline" : "online"
            print host "\t" os "\t" state
        }'
}

# known_hosts, for the entries that are readable. Hashing is per-host config:
# Debian/Ubuntu set HashKnownHosts yes in /etc/ssh/ssh_config, which turns every
# name into |1|... and makes the file useless here -- but macOS leaves it off,
# so on those machines this is a real source, and sometimes the only one.
#
# Entry shapes handled: comma-separated aliases on one line, [host]:port for a
# non-standard port, and a leading @cert-authority / @revoked marker.
hosts_from_known_hosts() {
    printf '%s\n' "${1:-}" | awk '
        /^[[:space:]]*(#|$)/ { next }
        {
            field = $1
            # @cert-authority and @revoked shift the host into field 2.
            if (field ~ /^@/) field = $2
            if (field ~ /^\|1\|/) next          # hashed: unreadable by design
            n = split(field, names, ",")
            for (i = 1; i <= n; i++) {
                h = names[i]
                sub(/^\[/, "", h)                # [host]:port -> host
                sub(/\]:[0-9]+$/, "", h)
                if (h == "" || h ~ /[*?!]/) continue
                print h
            }
        }' | sort -u
}

rows_from_sources() {
    local cfg_hosts="${1:-}" ts="${2:-}" kh="${3:-}" host os state seen=""
    while IFS= read -r host; do
        [ -n "$host" ] || continue
        valid_host "$host" || continue
        seen="${seen}${host}"$'\n'
        printf '%s\tcfg\t%s%s [ssh] %s%s\n' \
            "$host" "$C_ACCENT" "$GLYPH_HOST" "$host" "${C_ACCENT:+$C_RESET}"
    done <<< "$cfg_hosts"

    while IFS=$'\t' read -r host os state; do
        [ -n "$host" ] || continue
        valid_host "$host" || continue
        # An ssh-config entry wins: it may carry a user, port or ProxyJump that
        # the bare tailscale name would lose.
        printf '%s\n' "$seen" | grep -qxF -- "$host" && continue
        seen="${seen}${host}"$'\n'
        if [ "$state" = offline ]; then
            printf '%s\tnet\t%s%s [net] %s  (%s, offline)%s\n' \
                "$host" "$C_DIM" "$GLYPH_HOST" "$host" "$os" "${C_DIM:+$C_RESET}"
        else
            printf '%s\tnet\t%s [net] %s  (%s)\n' \
                "$host" "$GLYPH_HOST" "$host" "$os"
        fi
    done <<< "$ts"

    # Last: anything ssh already knows about that the other two missed.
    while IFS= read -r host; do
        [ -n "$host" ] || continue
        valid_host "$host" || continue
        printf '%s\n' "$seen" | grep -qxF -- "$host" && continue
        seen="${seen}${host}"$'\n'
        printf '%s\tkh\t%s%s [kh]  %s%s\n' \
            "$host" "$C_DIM" "$GLYPH_HOST" "$host" "${C_DIM:+$C_RESET}"
    done <<< "$kh"
}

# The host is the key: stable, and already field 1. Nothing hidden needs to
# become searchable here -- unlike the other two pickers, the thing you act on
# is the thing you read.
frecency_key_ssh() {
    printf '%s' "${1%%$'\t'*}"
}

collect_rows() {
    frecency_sort \
        "$(rows_from_sources \
            "$(hosts_from_ssh_config "$(read_ssh_config)")" \
            "$(hosts_from_tailscale "$(tailscale status 2>/dev/null)")" \
            "$(hosts_from_known_hosts "$(cat "$HOME/.ssh/known_hosts" 2>/dev/null)")")" \
        "$(frecency_path ssh)" \
        frecency_key_ssh
}

# Enter opens a window, Ctrl-V splits. Both name the target so tmarchy's tab
# reads as the host rather than "ssh".
act_on() {
    local row="${1:-}" key="${2:-}" host
    [ -n "$row" ] || return 0
    host=${row%%$'\t'*}
    valid_host "$host" || {
        printf 'tmux-ssh: refusing an implausible host name\n' >&2
        return 1
    }
    case "$key" in
        ctrl-v) tmux split-window -h -c "#{pane_current_path}" "ssh $host" ;;
        *)      tmux new-window -n "$host" "ssh $host" ;;
    esac
}

main() {
    TMUX_SSH_MAIN_RAN=1
    if ! command -v fzf >/dev/null 2>&1; then
        printf 'tmux-ssh: fzf is not installed\n' >&2
        exit 1
    fi
    load_theme
    local out key choice rows
    rows=$(collect_rows)
    if [ -z "$rows" ]; then
        printf '\ntmux-ssh: no hosts to offer.\n\n'
        if ! type frecency_sort >/dev/null 2>&1; then
            printf '  the shared ranking library did not load:\n'
            printf '    %s/tmux-frecency.sh\n' "$TMUX_SSH_LIBDIR"
            printf '  bin/lib/ is a recent addition -- run:  bin/gitfix\n\n'
        fi
        printf '  ssh config   %s host(s) in %s\n' \
            "$(hosts_from_ssh_config "$(read_ssh_config)" | grep -c .)" "$HOME/.ssh/config"
        printf '  known_hosts  %s readable, %s hashed (unreadable by design)\n' \
            "$(hosts_from_known_hosts "$(cat "$HOME/.ssh/known_hosts" 2>/dev/null)" | grep -c .)" \
            "$(awk '$1 ~ /^\|1\|/' "$HOME/.ssh/known_hosts" 2>/dev/null | grep -c .)"
        if ! command -v tailscale >/dev/null 2>&1; then
            printf '  tailscale    not installed on this host\n'
        else
            printf '  tailscale    %s node(s)\n' \
                "$(hosts_from_tailscale "$(tailscale status 2>/dev/null)" | grep -c .)"
        fi
        printf '\n  ~/.ssh/config.local is per-host and deliberately NOT in the\n'
        printf '  repo, so a fresh checkout has only the Host * catch-all, which\n'
        printf '  is a rule rather than a machine. known_hosts is hashed and\n'
        printf '  yields no readable names either.\n'
        printf '\n  [any key] close  '
        IFS= read -r -n1 -s _ </dev/tty 2>/dev/null || true
        exit 0
    fi
    # --tiebreak=index so equal-scoring matches keep the frecency order above;
    # the default `length` would rank by hostname width instead.
    out=$(printf '%s\n' "$rows" | fzf --ansi --expect=ctrl-v --tiebreak=index \
        --delimiter=$'\t' --with-nth=3.. \
        --prompt='ssh to > ' --height=100% --reverse --no-multi) || exit 0
    key=$(printf '%s\n' "$out" | head -1)
    choice=$(printf '%s\n' "$out" | sed -n '2p')
    frecency_record "$(frecency_path ssh)" "$(frecency_key_ssh "$choice")"
    act_on "$choice" "$key"
}

doctor() {
    printf 'tmux-ssh doctor\n\n'
    printf '  host           %s %s\n' "$(uname -s)" "$(uname -m)"
    printf '  lib dir        %s\n' "$TMUX_SSH_LIBDIR"
    printf '  frecency_sort  %s\n' "$(type -t frecency_sort 2>/dev/null || echo MISSING)"
    printf '\n  ssh config     %s\n' "$HOME/.ssh/config"
    printf '    readable     %s\n' "$([ -r "$HOME/.ssh/config" ] && echo yes || echo NO)"
    printf '    Include ->   %s\n' \
        "$(sed -n 's/^[[:space:]]*[Ii]nclude[[:space:]]\+//p' "$HOME/.ssh/config" 2>/dev/null | tr '\n' ' ')"
    printf '    config.local %s\n' "$([ -r "$HOME/.ssh/config.local" ] && echo present || echo ABSENT)"
    printf '    usable hosts %s\n' "$(hosts_from_ssh_config "$(read_ssh_config)" | grep -c .)"
    printf '\n  known_hosts    %s\n' "$HOME/.ssh/known_hosts"
    printf '    readable     %s\n' \
        "$(hosts_from_known_hosts "$(cat "$HOME/.ssh/known_hosts" 2>/dev/null)" | grep -c .)"
    printf '    hashed       %s (HashKnownHosts; unreadable by design)\n' \
        "$(awk '$1 ~ /^\|1\|/' "$HOME/.ssh/known_hosts" 2>/dev/null | grep -c .)"
    printf '\n  tailscale      %s\n' "$(command -v tailscale || echo MISSING)"
    if command -v tailscale >/dev/null 2>&1; then
        printf '    status exit  %s\n' "$(tailscale status >/dev/null 2>&1; echo $?)"
        printf '    nodes        %s\n' "$(hosts_from_tailscale "$(tailscale status 2>/dev/null)" | grep -c .)"
    fi
    printf '\n  collect_rows   %s rows\n' "$(collect_rows 2>/dev/null | grep -c .)"
}

case "${1:-}" in
    --doctor) [ "${TMUX_SSH_LIB:-}" = "1" ] || { doctor; exit 0; } ;;
esac

[ "${TMUX_SSH_LIB:-}" = "1" ] || main "$@"
