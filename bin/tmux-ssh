#!/usr/bin/env bash
# tmux-ssh — fuzzy-pick a host and open an SSH session on it.
#
# "Known hosts" is not a usable source here: ~/.ssh/known_hosts is hashed
# (HashKnownHosts), so it lists no readable names at all, and ~/.ssh/config is
# an Include plus a Host * catch-all. Tailscale is where the hosts actually
# are, so the picker merges:
#
#   [ssh]  Host entries from ~/.ssh/config and whatever it Includes
#   [net]  nodes from `tailscale status`, dimmed when offline
#
# Rows are "TARGET<TAB>KIND<TAB>DISPLAY" exactly as tmux-goto does it, with fzf
# on --with-nth=3.., so the host is never recovered from display text.
#
# Enter opens a new window named for the host; Ctrl-V splits the current window
# instead. The window name matters: tmarchy's tab shows it, and a window opened
# with -n keeps that name rather than tracking the running command.
#
# Sourced with TMUX_SSH_LIB=1 it defines its functions and exits.
set -uo pipefail

# shellcheck source=lib/tmux-frecency.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/tmux-frecency.sh"

GLYPH_HOST='󰢹'

C_ACCENT=""
C_DIM=""
C_RESET=""

# Same conversion as tmux-goto and tmux-keys: eight themes give #rrggbb, jewel
# gives colourNNN, anything else yields no colour rather than a broken escape.
ansi_for() {
    local v="${1:-}"
    case "$v" in
        '#'??????)
            printf '\033[38;2;%d;%d;%dm' \
                "$((16#${v:1:2}))" "$((16#${v:3:2}))" "$((16#${v:5:2}))" ;;
        colour[0-9]*|color[0-9]*)
            printf '\033[38;5;%dm' "${v#colo*r}" ;;
    esac
}

load_theme() {
    C_ACCENT=$(ansi_for "$(tmux show -gv @theme-remote 2>/dev/null)")
    C_DIM=$(ansi_for "$(tmux show -gv @theme-dim 2>/dev/null)")
    if [ -n "$C_ACCENT$C_DIM" ]; then C_RESET=$'\033[0m'; else C_RESET=""; fi
}

# A host is pasted straight into a command line, so anything outside the set
# that can appear in a real hostname or user@host is rejected outright. A
# crafted ~/.ssh/config or tailscale node name must not be able to append a
# second command.
valid_host() {
    case "${1:-}" in
        "") return 1 ;;
        *[!A-Za-z0-9._@-]*) return 1 ;;
        -*) return 1 ;;
        *) return 0 ;;
    esac
}

# Host lines from an ssh config. Patterns are skipped: "Host *" matches
# everything and is a rule, not a machine you can connect to.
hosts_from_ssh_config() {
    printf '%s\n' "${1:-}" \
        | sed -n 's/^[[:space:]]*[Hh]ost[[:space:]]\+//p' \
        | tr ' \t' '\n\n' \
        | grep -v '^$' \
        | grep -v '[*?!]' \
        | sort -u
}

# ~/.ssh/config is mostly an Include here, so the hosts live one file deeper.
# One level only: nested includes are not a thing in this config and following
# them blindly invites a loop.
read_ssh_config() {
    local main="${1:-$HOME/.ssh/config}" dir text line target
    [ -r "$main" ] || return 0
    text=$(cat "$main")
    printf '%s\n' "$text"
    dir=$(dirname "$main")
    printf '%s\n' "$text" | sed -n 's/^[[:space:]]*[Ii]nclude[[:space:]]\+//p' | while read -r line; do
        for target in $line; do
            case "$target" in
                /*) [ -r "$target" ] && cat "$target" ;;
                *)  [ -r "$dir/$target" ] && cat "$dir/$target" ;;
            esac
        done
    done
}

# `tailscale status` columns are: ip, host, owner, os, then a free-text state
# that contains "offline" for nodes that are down.
hosts_from_tailscale() {
    printf '%s\n' "${1:-}" | awk '
        NF >= 4 && $1 ~ /^[0-9]+\./ {
            host = $2; os = $4
            rest = ""
            for (i = 5; i <= NF; i++) rest = rest " " $i
            state = (rest ~ /offline/) ? "offline" : "online"
            print host "\t" os "\t" state
        }'
}

rows_from_sources() {
    local cfg_hosts="${1:-}" ts="${2:-}" host os state seen=""
    while IFS= read -r host; do
        [ -n "$host" ] || continue
        valid_host "$host" || continue
        seen="${seen}${host}"$'\n'
        printf '%s\tcfg\t%s%s [ssh] %s%s\n' \
            "$host" "$C_ACCENT" "$GLYPH_HOST" "$host" "${C_ACCENT:+$C_RESET}"
    done <<< "$cfg_hosts"

    while IFS=$'\t' read -r host os state; do
        [ -n "$host" ] || continue
        valid_host "$host" || continue
        # An ssh-config entry wins: it may carry a user, port or ProxyJump that
        # the bare tailscale name would lose.
        printf '%s\n' "$seen" | grep -qxF -- "$host" && continue
        if [ "$state" = offline ]; then
            printf '%s\tnet\t%s%s [net] %s  (%s, offline)%s\n' \
                "$host" "$C_DIM" "$GLYPH_HOST" "$host" "$os" "${C_DIM:+$C_RESET}"
        else
            printf '%s\tnet\t%s [net] %s  (%s)\n' \
                "$host" "$GLYPH_HOST" "$host" "$os"
        fi
    done <<< "$ts"
}

# The host is the key: stable, and already field 1. Nothing hidden needs to
# become searchable here -- unlike the other two pickers, the thing you act on
# is the thing you read.
frecency_key_ssh() {
    printf '%s' "${1%%$'\t'*}"
}

collect_rows() {
    frecency_sort \
        "$(rows_from_sources \
            "$(hosts_from_ssh_config "$(read_ssh_config)")" \
            "$(hosts_from_tailscale "$(tailscale status 2>/dev/null)")")" \
        "$(frecency_path ssh)" \
        frecency_key_ssh
}

# Enter opens a window, Ctrl-V splits. Both name the target so tmarchy's tab
# reads as the host rather than "ssh".
act_on() {
    local row="${1:-}" key="${2:-}" host
    [ -n "$row" ] || return 0
    host=${row%%$'\t'*}
    valid_host "$host" || {
        printf 'tmux-ssh: refusing an implausible host name\n' >&2
        return 1
    }
    case "$key" in
        ctrl-v) tmux split-window -h -c "#{pane_current_path}" "ssh $host" ;;
        *)      tmux new-window -n "$host" "ssh $host" ;;
    esac
}

main() {
    TMUX_SSH_MAIN_RAN=1
    if ! command -v fzf >/dev/null 2>&1; then
        printf 'tmux-ssh: fzf is not installed\n' >&2
        exit 1
    fi
    load_theme
    local out key choice
    # --tiebreak=index so equal-scoring matches keep the frecency order above;
    # the default `length` would rank by hostname width instead.
    out=$(collect_rows | fzf --ansi --expect=ctrl-v --tiebreak=index \
        --delimiter=$'\t' --with-nth=3.. \
        --prompt='ssh to > ' --height=100% --reverse --no-multi) || exit 0
    key=$(printf '%s\n' "$out" | head -1)
    choice=$(printf '%s\n' "$out" | sed -n '2p')
    frecency_record "$(frecency_path ssh)" "$(frecency_key_ssh "$choice")"
    act_on "$choice" "$key"
}

[ "${TMUX_SSH_LIB:-}" = "1" ] || main "$@"
