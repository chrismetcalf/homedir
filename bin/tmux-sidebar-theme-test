#!/usr/bin/env bash
# Test that tmux-window-sidebar follows the tmarchy theme
set -euo pipefail

SIDEBAR="/Users/chris.metcalf/.homedir/bin/tmux-window-sidebar"
FAILURES=0

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    FAILURES=$((FAILURES + 1))
}

pass() {
    printf 'PASS: %s\n' "$1"
}

# Test 1: Verify theme library is sourced
if ! grep -q '^. ".*lib/tmux-theme.sh"' "$SIDEBAR"; then
    fail "Theme library not sourced"
else
    pass "Theme library sourced"
fi

# Test 2: Verify hardcoded colors are removed
if grep -q '38;5;203\|38;5;214\|38;5;78\|38;5;245\|38;5;67\|38;5;250' "$SIDEBAR"; then
    fail "Hardcoded 256-color indices still present"
else
    pass "No hardcoded 256-color indices"
fi

# Test 3: Verify SUBCOL is removed
if grep -q '^SUBCOL=' "$SIDEBAR"; then
    fail "SUBCOL variable still present"
else
    pass "SUBCOL variable removed"
fi

# Test 4: Verify theme_colours function exists
if ! grep -q '^theme_colours()' "$SIDEBAR"; then
    fail "theme_colours function not found"
else
    pass "theme_colours function exists"
fi

# Test 5: Verify theme_load and theme_colours are called in draw
if ! grep -q 'theme_load; theme_colours' "$SIDEBAR"; then
    fail "theme_load and theme_colours not called in draw"
else
    pass "theme_load and theme_colours called in draw"
fi

# Test 6: Verify theme color variables are used
# C_WAIT/C_BUSY/C_DONE/C_IDLE are used inside color_for function
if ! grep -q 'C_WAIT=\|C_BUSY=\|C_DONE=\|C_IDLE=' "$SIDEBAR"; then
    fail "State color variables not defined"
else
    pass "State color variables defined"
fi

# C_NAME, C_HEAD, C_SUB are used directly in the code
declare -a direct_vars=("C_NAME" "C_HEAD" "C_SUB")
for var in "${direct_vars[@]}"; do
    if ! grep -q "\${$var}" "$SIDEBAR"; then
        fail "Theme variable $var not used"
    else
        pass "Theme variable $var used"
    fi
done

# Test 7: Verify active row uses left rule glyph, not full-width background
if grep -q '48;5;236m' "$SIDEBAR"; then
    fail "Full-width background (48;5;236m) still present in active row"
else
    pass "Full-width background removed"
fi

if ! grep -q '▌' "$SIDEBAR"; then
    fail "Left rule glyph (▌) not found"
else
    pass "Left rule glyph (▌) present"
fi

# Test 8: Verify padding computation is removed
if grep -q 'plain=.*>${idx}' "$SIDEBAR"; then
    fail "Old padding computation still present"
else
    pass "Old padding computation removed"
fi

# Test 9: Verify active row format
if ! grep -q '\${C_HEAD}▌\${RESET}\${col}\${idx} \${nm}\${tagpart}\${RESET}' "$SIDEBAR"; then
    fail "Active row format incorrect"
else
    pass "Active row format correct"
fi

# Test 10: Verify non-active row format
if ! grep -q ' \${col}\${idx}\${RESET} \${C_NAME}\${nm}\${tagpart}\${RESET}' "$SIDEBAR"; then
    fail "Non-active row format incorrect"
else
    pass "Non-active row format correct"
fi

# Test 11: Verify header uses C_HEAD
if ! grep -q '\${C_HEAD} WINDOWS\${RESET}' "$SIDEBAR"; then
    fail "Header does not use C_HEAD"
else
    pass "Header uses C_HEAD"
fi

# Test 12: Verify tagpart uses C_SUB
if ! grep -q 'tagpart=" \${C_SUB}\${tag}"' "$SIDEBAR"; then
    fail "tagpart does not use C_SUB"
else
    pass "tagpart uses C_SUB"
fi

# Test 13: Verify syntax is valid
if ! bash -n "$SIDEBAR" 2>/dev/null; then
    fail "Syntax check failed"
else
    pass "Syntax valid"
fi

# Test 14: Verify color_for returns complete SGR escapes
# The new color_for should return the full escape from ansi_for, not a bare index
if grep -q "printf '203'\|printf '214'\|printf '78'\|printf '245'" "$SIDEBAR"; then
    fail "color_for still returns bare indices"
else
    pass "color_for returns complete escapes"
fi

# Test 15: Verify theme marker is appended to tmux display-message call
if ! grep -q 'tmux display-message.*#{@theme-bg}' "$SIDEBAR"; then
    fail "Theme marker (@theme-bg) not appended to display-message"
else
    pass "Theme marker appended to display-message"
fi

# Test 16: Verify lastTheme variable exists to track theme changes
if ! grep -q '^lastTheme=' "$SIDEBAR"; then
    fail "lastTheme tracking variable not found"
else
    pass "lastTheme tracking variable exists"
fi

# Test 17: Verify theme_invalidate is called when theme changes
if ! grep -q 'theme_invalidate' "$SIDEBAR"; then
    fail "theme_invalidate not called"
else
    pass "theme_invalidate called on theme change"
fi

# Test 18: Verify theme is parsed from display-message output
if ! grep -q 'theme="\${3:-}"' "$SIDEBAR"; then
    fail "Theme not parsed from display-message output"
else
    pass "Theme parsed from display-message output"
fi

# Test 19: Verify theme comparison logic exists
if ! grep -q '\[ "$theme" != "$lastTheme" \]' "$SIDEBAR"; then
    fail "Theme comparison logic not found"
else
    pass "Theme comparison logic exists"
fi

# Test 20: Verify no extra tmux calls added (still only one display-message)
tmux_calls=$(grep -c 'tmux display-message' "$SIDEBAR" || true)
if [ "$tmux_calls" -ne 1 ]; then
    fail "Expected 1 tmux display-message call, found $tmux_calls"
else
    pass "No extra tmux calls (still 1 display-message)"
fi

# Test 21: Verify theme_invalidate function exists in lib
THEME_LIB="/Users/chris.metcalf/.homedir/bin/lib/tmux-theme.sh"
if ! grep -q '^theme_invalidate()' "$THEME_LIB"; then
    fail "theme_invalidate function not found in lib/tmux-theme.sh"
else
    pass "theme_invalidate function exists in lib"
fi

# Test 22: Verify theme_invalidate clears _THEME_LOADED
if ! grep -A3 '^theme_invalidate()' "$THEME_LIB" | grep -q '_THEME_LOADED=""'; then
    fail "theme_invalidate does not clear _THEME_LOADED"
else
    pass "theme_invalidate clears _THEME_LOADED"
fi

# Test 23: Verify theme_load is called AFTER invalidation check
# This is critical: invalidation must happen before loading
if ! awk '/theme_invalidate/{found=1} found && /theme_load/{print; exit}' "$SIDEBAR" | grep -q 'theme_load'; then
    fail "theme_load not called after invalidation"
else
    pass "theme_load called after invalidation check"
fi

# Test 24: Verify unused locals (plain, pad) removed
if grep -q 'local.*\bplain\b' "$SIDEBAR"; then
    fail "Unused local 'plain' still present"
else
    pass "Unused local 'plain' removed"
fi

if grep -q 'local.*\bpad\b' "$SIDEBAR"; then
    fail "Unused local 'pad' still present"
else
    pass "Unused local 'pad' removed"
fi

printf '\n%d tests, %d failures\n' 26 "$FAILURES"
exit "$FAILURES"
