#!/usr/bin/env bash
# tmux-sidebar-selftest — fixture-driven tests for bin/tmux-window-sidebar.
#
# Runs twice: once under whatever `#!/usr/bin/env bash` found (Homebrew's 5.x
# here), then the WHOLE suite again under /bin/bash 3.2 via a re-exec guarded
# by SIDEBAR_SELFTEST_INNER. See the bottom of the file for why that is a
# re-exec of everything rather than a handful of re-run assertions.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Every nested interpreter has to be THIS interpreter, never a bare `bash`.
# Several assertions below source the sidebar in a child shell to call
# git_refresh, and a bare `bash` resolves through PATH -- to Homebrew's 5.x
# here, even inside the /bin/bash 3.2 re-run at the bottom of this file. That
# made the 3.2 run a lie for exactly the functions the 3.2 constraint exists
# to protect: measured, a `declare -A` reintroduced into lookup_mtime (the fix
# pass 1 defect form) passed the entire suite under both interpreters until
# this was fixed. $BASH is the running shell's own path.
SELF_BASH="${BASH:-/bin/bash}"

FAILED=0
pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"; FAILED=1; }
assert_eq() { [ "$2" = "$3" ] && pass "$1" || fail "$1" "$2" "$3"; }

# The layout functions measure with ${#s} and slice with ${s: -n}, which count
# CHARACTERS under a UTF-8 LC_CTYPE and BYTES under C/POSIX. The glyphs and the
# ellipsis are multibyte, so the exact-width assertions below are only
# meaningful in the first case; probe for it rather than assume it.
_u='…'
if [ "${#_u}" -eq 1 ]; then UTF8_CTYPE=1; else UTF8_CTYPE=0; fi

# Fixtures live under /tmp, never in the repo.
TMPROOT=$(mktemp -d /tmp/sidebar-selftest.XXXXXX)
cleanup_fixtures() { rm -rf "$TMPROOT"; }
trap cleanup_fixtures EXIT

# Commits need an identity and `git init` is noisy about the default branch.
gitq() { git -c user.email=selftest@invalid -c user.name=selftest \
              -c init.defaultBranch=main -c commit.gpgsign=false "$@"; }

export TMUX_SIDEBAR_LIB=1
# shellcheck source=/dev/null
. "$DIR/tmux-window-sidebar"

echo "tmux-window-sidebar selftest (bash ${BASH_VERSION%%(*})"

# age_str / trunc_left / recency_of return through the _ret global rather than
# stdout, precisely so the refresh path never forks. That means $(age_str 60)
# captures the EMPTY STRING, not "1m" -- call first, then assert on $_ret.
# Do not add *_print wrappers to the production file to make $(...) work: that
# is test-only scaffolding in the daemon, and it reintroduces the fork.
echo "age_str"
age_str 59;    assert_eq "59s"    "59s" "$_ret"
age_str 60;    assert_eq "60s"    "1m"  "$_ret"
age_str 3599;  assert_eq "3599s"  "59m" "$_ret"
age_str 3600;  assert_eq "3600s"  "1h"  "$_ret"
age_str 86399; assert_eq "86399s" "23h" "$_ret"
age_str 86400; assert_eq "86400s" "1d"  "$_ret"
# Buckets, not rounding: 90s is one minute ago, it has not been touched twice.
age_str 90;    assert_eq "90s buckets down" "1m" "$_ret"

echo "trunc_left"
trunc_left bin/g 12;            assert_eq "short path is untouched" "bin/g" "$_ret"
# The basename is what identifies a file -- the opposite of the window list.
trunc_left bin/lib/theme.sh 13; assert_eq "keeps the basename" "…lib/theme.sh" "$_ret"
trunc_left abcde 5;             assert_eq "exact fit is untouched" "abcde" "$_ret"

echo "parse_status"
# NUL-framed records, as `git status --porcelain -z` emits them. A rename or
# copy is TWO records -- "R  <new>" then "<old>" -- and the origin record must
# be consumed, or it is read as a separate still-present file. The input cannot
# be held in a variable (bash strings cannot contain NUL), so printf pipes it.
OUT=$(printf ' M bin/a\0?? fresh.txt\0 D gone.txt\0A  added.txt\0R  rn-new.txt\0rn-old.txt\0 R wt-new.txt\0wt-old.txt\0' | parse_status)
assert_eq "modified"  "modified"  "$(printf '%s\n' "$OUT" | grep 'bin/a'     | cut -f1)"
assert_eq "untracked" "untracked" "$(printf '%s\n' "$OUT" | grep 'fresh.txt' | cut -f1)"
assert_eq "deleted"   "deleted"   "$(printf '%s\n' "$OUT" | grep 'gone.txt'  | cut -f1)"
assert_eq "added"     "added"     "$(printf '%s\n' "$OUT" | grep 'added.txt' | cut -f1)"
# The new name is the one that exists on disk, so it is the one to stat.
assert_eq "rename keeps the new name" "rn-new.txt" "$(printf '%s\n' "$OUT" | grep 'rn-new' | cut -f2)"
# R/C can land in EITHER column; the second-record rule is the same.
assert_eq "worktree-column rename keeps the new name" "wt-new.txt" "$(printf '%s\n' "$OUT" | grep 'wt-new' | cut -f2)"
# The origin-record pin has to be the WHOLE path set, not `grep -c rn-old`.
# A leaked origin record is not emitted verbatim: it is parsed as an ordinary
# record, so the first three bytes are eaten as the XY field and the separator
# and `rn-old.txt` surfaces as a row for `old.txt`. Every substring grep for
# the origin name therefore passes against the leak it was written to catch
# (measured -- removing the consuming `read` fails only the assertions below).
assert_eq "one row per change, origin records dropped" "6" "$(printf '%s\n' "$OUT" | wc -l | tr -d ' ')"
assert_eq "no origin record leaks through as a row" \
    "added.txt bin/a fresh.txt gone.txt rn-new.txt wt-new.txt" \
    "$(printf '%s\n' "$OUT" | cut -f2 | LC_ALL=C sort | tr '\n' ' ' | sed 's/ *$//')"

echo "parse_status unmerged"
# `*D*` used to match before `*A*` and there was no unmerged case at all, so
# DU/UD -- "deleted by us"/"deleted by them", conflicts in which the worktree
# DOES contain a file awaiting resolution -- were labelled `deleted`. The
# existence partition is independent of the state string, so the row then also
# got a real mtime and rendered `- del-us.txt  4s`: a deletion glyph with a
# fresh timestamp, for the single most action-requiring state a working tree
# can be in. AA (both added) was swallowed by `*A*` the same way.
#
# DD (both deleted) is genuinely gone and must KEEP falling through to *D*.
UOUT=$(printf 'UU both.txt\0AA addadd.txt\0DU del-us.txt\0UD del-them.txt\0DD del-both.txt\0AU add-us.txt\0UA add-them.txt\0' | parse_status)
ustate() { printf '%s\n' "$UOUT" | awk -F'\t' -v p="$1" '$2 == p { print $1 }'; }
assert_eq "UU (both modified) is unmerged"    "unmerged" "$(ustate both.txt)"
assert_eq "AA (both added) is unmerged"       "unmerged" "$(ustate addadd.txt)"
assert_eq "DU (deleted by us) is unmerged"    "unmerged" "$(ustate del-us.txt)"
assert_eq "UD (deleted by them) is unmerged"  "unmerged" "$(ustate del-them.txt)"
assert_eq "AU (added by us) is unmerged"      "unmerged" "$(ustate add-us.txt)"
assert_eq "UA (added by them) is unmerged"    "unmerged" "$(ustate add-them.txt)"
assert_eq "DD (both deleted) stays deleted"   "deleted"  "$(ustate del-both.txt)"

echo "recency_of"
recency_of 1000 1010;  assert_eq "just now"  "now"    "$_ret"
recency_of 1000 1400;  assert_eq "this hour" "recent" "$_ret"
recency_of 1000 90000; assert_eq "older"     "old"    "$_ret"
recency_of - 1000;     assert_eq "no mtime is old" "old" "$_ret"

echo "changed_rows"
NOW=1000000
L=$(printf '%s\t%s\t%s\n' \
    999988 modified bin/a \
    999940 added    bin/b \
    -      deleted  bin/gone)
R=$(changed_rows "$L" "$NOW" 24 10)
assert_eq "one row per file" "3" "$(printf '%s\n' "$R" | wc -l | tr -d ' ')"
printf '%s\n' "$R" | head -1 | cut -f2 | grep -q '●' && pass "modified glyph" || fail "modified glyph" "●" "$(printf '%s\n' "$R" | head -1 | cut -f2)"
printf '%s\n' "$R" | sed -n 2p | cut -f2 | grep -q '+' && pass "added glyph" || fail "added glyph" "+" "$(printf '%s\n' "$R" | sed -n 2p | cut -f2)"
printf '%s\n' "$R" | tail -1 | cut -f2 | grep -q '−' && pass "deleted glyph" || fail "deleted glyph" "−" "$(printf '%s\n' "$R" | tail -1 | cut -f2)"
printf '%s\n' "$R" | head -1 | cut -f2 | grep -q '12s' && pass "age is rendered" || fail "age is rendered" "12s" "$(printf '%s\n' "$R" | head -1 | cut -f2)"
# A deleted file has no mtime: stat failed on it. An em dash, never "0s" --
# that would claim the file was touched a moment ago.
printf '%s\n' "$R" | tail -1 | cut -f2 | grep -q '—' && pass "deleted shows no age" || fail "deleted shows no age" "—" "$(printf '%s\n' "$R" | tail -1 | cut -f2)"
assert_eq "max caps the rows" "2" "$(changed_rows "$L" "$NOW" 24 2 | wc -l | tr -d ' ')"
# TWO guards enforce this and they MASK EACH OTHER: `[ "$max" -gt 0 ] || return
# 0` at the top of changed_rows and `[ "$n" -ge "$max" ] && break` in the loop,
# which fires immediately at 0 >= 0. Removing either one ALONE leaves the other
# holding and this assertion still passes, so a single-guard sabotage of it is
# vacuous. To verify it, delete BOTH -- the same treatment, for the same
# reason, that tmarchy/test/saver-graph.test.js gives its band bound. The
# defence in depth is worth keeping: `max` reaches here from a tmux option.
assert_eq "zero max yields nothing" "" "$(changed_rows "$L" "$NOW" 24 0)"

# Field 1 is the recency class the caller paints the row with. It is a separate
# output from the rendered text and was previously never asserted at all.
assert_eq "recency field: fresh file is now" "now" "$(printf '%s\n' "$R" | head -1 | cut -f1)"
assert_eq "recency field: no mtime is old"   "old" "$(printf '%s\n' "$R" | tail -1 | cut -f1)"

# The two glyphs the fixture above never reaches.
L2=$(printf '%s\t%s\t%s\n' \
    999988 untracked bin/u \
    900000 modified  bin/oldie \
    999990 mystery   bin/q)
R2=$(changed_rows "$L2" "$NOW" 24 10)
printf '%s\n' "$R2" | head -1 | cut -f2 | grep -q '○' && pass "untracked glyph" || fail "untracked glyph" "○" "$(printf '%s\n' "$R2" | head -1 | cut -f2)"
printf '%s\n' "$R2" | tail -1 | cut -f2 | grep -q '·' && pass "unknown state falls back to ·" || fail "unknown state falls back to ·" "·" "$(printf '%s\n' "$R2" | tail -1 | cut -f2)"
assert_eq "recency field: an hour-old mtime is old" "old" "$(printf '%s\n' "$R2" | sed -n 2p | cut -f1)"

# An unmerged file EXISTS, so it has a real mtime and a real age -- what it
# must not have is the deletion glyph. Pinned both ways round: the conflict
# glyph is present AND the deletion glyph is not, since a fallthrough to the
# `*)` case would drop the deletion glyph too and a one-sided assertion would
# not tell those apart.
L3=$(printf '%s\t%s\t%s\n' 999988 unmerged bin/conflicted)
R3=$(changed_rows "$L3" "$NOW" 24 10 | cut -f2)
printf '%s\n' "$R3" | grep -q '≠' && pass "unmerged glyph" || fail "unmerged glyph" "≠" "$R3"
printf '%s\n' "$R3" | grep -q '−' \
    && fail "unmerged is not drawn as a deletion" "no − glyph" "$R3" \
    || pass "unmerged is not drawn as a deletion"
printf '%s\n' "$R3" | grep -q '·' \
    && fail "unmerged has its own glyph, not the unknown-state fallback" "no · glyph" "$R3" \
    || pass "unmerged has its own glyph, not the unknown-state fallback"
printf '%s\n' "$R3" | grep -q '12s' \
    && pass "unmerged keeps its real age" || fail "unmerged keeps its real age" "12s" "$R3"

# The name budget is computed AFTER the age string, not from a fixed allowance
# of four characters. age_str's days branch is unbounded, so a five-character
# age ("1000d" -- a submodule in this repo is already at 942d) against a hard
# `w - 6` rendered 25 columns in a 24-column pane, wrapped, and shifted every
# row below it. The name has to shrink instead.
LW=$(printf '%s\t%s\t%s\n' 913600000 added bin/eighteen-chars)
RW=$(changed_rows "$LW" 1000000000 24 10)
RW_TEXT=$(printf '%s\n' "$RW" | cut -f2)
printf '%s\n' "$RW_TEXT" | grep -q '1000d' && pass "five-character age is rendered" || fail "five-character age is rendered" "1000d" "$RW_TEXT"
if [ "$UTF8_CTYPE" = "1" ]; then
    assert_eq "w=24 row with a 5-char age is exactly 24 columns" "24" "${#RW_TEXT}"
else
    echo "  SKIP w=24 row with a 5-char age is exactly 24 columns (LC_CTYPE is not UTF-8; \${#s} counts bytes)"
fi

# The gap clamp -- `[ "$pad" -lt 1 ] && pad=1` -- is LIVE, but only in a
# one-column band, which is why deleting it used to pass the whole suite. It
# matters exactly at `w == 4 + ${#age}` with a name that has been truncated to
# its 3-character floor: there pad computes to 0 and the unclamped printf emits
# NO separator, so the row reads `●…/a12s` with the name and the age run
# together. One column narrower, at pad == -1, `%*s` with a negative width
# left-justifies in a single column and emits the same space the clamp would --
# so a sabotage tested at any other width is indistinguishable from correct
# code. w=7 against a three-character age is the band.
#
# @sidebar-width is user-settable and nothing rejects a small value, so this is
# reachable. The row over-runs w by one column here; that is the documented
# contract in changed_rows (an unreadable row is worse than a wrapped one).
PC=$(changed_rows "$(printf '%s\t%s\t%s\n' 999988 modified bin/a)" "$NOW" 7 10 | cut -f2)
case "$PC" in
    *' 12s') pass "the name and the age never abut (w=7, the pad-clamp band)" ;;
    *)       fail "the name and the age never abut (w=7, the pad-clamp band)" \
                  "a space before the age" "$PC" ;;
esac
if [ "$UTF8_CTYPE" = "1" ]; then
    assert_eq "below the fit width the row over-runs rather than losing the gap" "8" "${#PC}"
else
    echo "  SKIP below the fit width the row over-runs rather than losing the gap (LC_CTYPE is not UTF-8)"
fi

echo "git_refresh batching"
# Pin ONE stat invocation regardless of file count. Count actual stat forks.
# The initialization probe (testing . for BSD vs GNU) doesn't count; only the
# git_refresh call itself should invoke stat, and only once for all files.
REAL_STAT=$(command -v stat || true)
if [ -z "$REAL_STAT" ]; then
    fail "stat is on PATH" "a stat binary" "none found"
    REAL_STAT=/nonexistent/stat
fi
TMPD="$TMPROOT/batching"
STATBIN="$TMPD/bin"
mkdir -p "$STATBIN"
# The shim must exec the REAL stat, resolved above rather than hardcoded:
# /usr/bin/stat is the macOS path and not where GNU coreutils puts it.
cat > "$STATBIN/stat" << STATEOF
#!/bin/bash
# Only count if COUNTING is set (after initialization)
if [ "\$COUNTING" = "1" ]; then
    echo "1" >> "\$STAT_LOG"
fi
exec "$REAL_STAT" "\$@"
STATEOF
chmod +x "$STATBIN/stat"

export STAT_LOG="$TMPD/stat-count"
(
    cd "$TMPD"
    gitq init -q
    echo a > a.txt
    echo b > b.txt
    echo c > c.txt
    gitq add .
    gitq commit -q -m "initial"
    echo aa >> a.txt
    echo bb >> b.txt
    echo cc >> c.txt

    # Source the script first (this runs the initialization probe), then start counting
    env PATH="$STATBIN:$PATH" STAT_LOG="$STAT_LOG" COUNTING=0 TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c \
        '. '"$DIR"'/tmux-window-sidebar; COUNTING=1 git_refresh . >/dev/null'
)

if [ -f "$STAT_LOG" ]; then
    COUNT=$(wc -l < "$STAT_LOG" | tr -d ' ')
else
    COUNT=0
fi
assert_eq "stat called exactly once for 3 files" "1" "$COUNT"

# Pin correct pairing when a deleted file is among present ones. Index-based
# pairing would shift every file after the deleted one onto the wrong mtime.
#
# Note the fixture is driven with `git -C` and the repo path is passed to
# git_refresh, rather than `cd`-ing inside a ( ... ). No assertion may live in
# a subshell: `fail` sets FAILED=1 in the SUBSHELL, which is discarded, and it
# returns 0, so the subshell's exit status reports success either way -- a
# failing assertion would print FAIL and the suite would still exit 0.
TMPD2="$TMPROOT/deletion"
mkdir -p "$TMPD2"
gitq -C "$TMPD2" init -q
echo a > "$TMPD2/a.txt"
echo b > "$TMPD2/b.txt"
echo c > "$TMPD2/c.txt"
gitq -C "$TMPD2" add .
gitq -C "$TMPD2" commit -q -m "initial"
echo aa >> "$TMPD2/a.txt"
echo bb >> "$TMPD2/b.txt"
echo cc >> "$TMPD2/c.txt"
# a.txt, b.txt, c.txt all modified. Delete b.txt.
rm "$TMPD2/b.txt"

# Run git_refresh; verify a.txt and c.txt still have their real mtimes.
OUT=$(TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c '. '"$DIR"'/tmux-window-sidebar; git_refresh "$1"' _ "$TMPD2")

# a.txt should have a numeric mtime (not "-")
A_MTIME=$(printf '%s\n' "$OUT" | grep 'a.txt$' | cut -f1)
[ "$A_MTIME" != "-" ] && [ "$A_MTIME" -gt 0 ] 2>/dev/null && \
    pass "a.txt has numeric mtime despite deleted b.txt" || \
    fail "a.txt has numeric mtime despite deleted b.txt" "numeric > 0" "$A_MTIME"

# c.txt should have a numeric mtime (not "-")
C_MTIME=$(printf '%s\n' "$OUT" | grep 'c.txt$' | cut -f1)
[ "$C_MTIME" != "-" ] && [ "$C_MTIME" -gt 0 ] 2>/dev/null && \
    pass "c.txt has numeric mtime despite deleted b.txt" || \
    fail "c.txt has numeric mtime despite deleted b.txt" "numeric > 0" "$C_MTIME"

# b.txt should have "-" mtime
B_MTIME=$(printf '%s\n' "$OUT" | grep 'b.txt$' | cut -f1)
assert_eq "b.txt (deleted) has '-' mtime" "-" "$B_MTIME"

echo "git_refresh -z parsing"
# Everyday filenames that plain `--porcelain` would QUOTE: v1 wraps any path
# with a space in double quotes, and under the default core.quotePath=true
# octal-escapes every non-ASCII byte. Nothing downstream un-quotes it, so the
# path never matches on disk, never reaches stat, gets mtime "-", renders an em
# dash instead of an age and buckets as `old` -- three silent wrongs at once.
# The pin is therefore "this path has a real mtime", not "this path appears".
ZD="$TMPROOT/zparse"
mkdir -p "$ZD"
printf 'a\n' > "$ZD/with space.txt"
printf 'b\n' > "$ZD/café.txt"
printf 'c\n' > "$ZD/oldname.txt"
gitq -C "$ZD" init -q
gitq -C "$ZD" add -A
gitq -C "$ZD" commit -q -m initial
printf 'x\n' >> "$ZD/with space.txt"
printf 'y\n' >> "$ZD/café.txt"
gitq -C "$ZD" mv oldname.txt newname.txt
# A dangling symlink is a real, changed file. `[ -e ]` alone is FALSE for one,
# so without the `|| [ -L ]` companion it is partitioned off as deleted and
# reported with no mtime -- the same three silent wrongs as a quoted path.
ln -s /nonexistent/target "$ZD/dangling"
ZOUT=$(TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c '. '"$DIR"'/tmux-window-sidebar; git_refresh "$1"' _ "$ZD")

Z_SPACE=$(printf '%s\n' "$ZOUT" | grep 'with space.txt$' | cut -f1)
[ -n "$Z_SPACE" ] && [ "$Z_SPACE" != "-" ] && [ "$Z_SPACE" -gt 0 ] 2>/dev/null && \
    pass "path with a space gets a real mtime" || \
    fail "path with a space gets a real mtime" "numeric > 0" "${Z_SPACE:-<no row>}"

Z_UTF8=$(printf '%s\n' "$ZOUT" | grep 'café.txt$' | cut -f1)
[ -n "$Z_UTF8" ] && [ "$Z_UTF8" != "-" ] && [ "$Z_UTF8" -gt 0 ] 2>/dev/null && \
    pass "non-ASCII path gets a real mtime" || \
    fail "non-ASCII path gets a real mtime" "numeric > 0" "${Z_UTF8:-<no row>}"

# Under -z a rename is two records. The new name is what exists on disk; the
# origin record, if leaked, becomes a phantom row for a file that is gone.
assert_eq "rename yields exactly one row, for the new name" "1" \
    "$(printf '%s\n' "$ZOUT" | grep -c 'newname.txt$' | tr -d ' ')"
# Same reasoning as the parse_status set assertion above: a leaked origin
# record surfaces with its first three bytes eaten, as a row for `name.txt`,
# so grepping for `oldname.txt` would pass against the very leak it names.
assert_eq "no phantom rows: the whole path set is exactly the four changes" \
    "café.txt dangling newname.txt with space.txt" \
    "$(printf '%s\n' "$ZOUT" | cut -f3 | LC_ALL=C sort | tr '\n' ' ' | sed 's/ *$//')"

Z_LINK=$(printf '%s\n' "$ZOUT" | grep 'dangling$' | cut -f1)
[ -n "$Z_LINK" ] && [ "$Z_LINK" != "-" ] && [ "$Z_LINK" -gt 0 ] 2>/dev/null && \
    pass "broken symlink gets a real mtime" || \
    fail "broken symlink gets a real mtime" "numeric > 0" "${Z_LINK:-<no row>}"

echo "lookup_mtime cursor walk"
# lookup_mtime STEPS a cursor through _STAT_LINES instead of scanning the whole
# stat output per path (which was O(n^2) over a refresh -- see the timing pin
# below). Both halves of that need pinning separately, because an
# implementation can be fast and wrong or correct and quadratic.
stat_split "$(printf '111 /r/a\n222 /r/b\n333 /r/c\n')"
# Counts the lines, which catches a split that drops or merges them. It does
# NOT test the "once" half -- that there is one split per refresh rather than
# one per path is carried entirely by the timing pin below, which is why both
# exist.
assert_eq "stat_split yields one array element per stat line" "3" "$_STAT_N"
lookup_mtime /r/a; assert_eq "cursor step 1" "111" "$_ret"
assert_eq "the cursor advanced" "1" "$_STAT_I"
lookup_mtime /r/b; assert_eq "cursor step 2" "222" "$_ret"
# The position is VERIFIED, never trusted. Asking out of step must return the
# queried path's own mtime, not whatever sits under the cursor -- an
# index-blind implementation would answer 111 here.
_STAT_I=0
lookup_mtime /r/c; assert_eq "out-of-step query resyncs by name, not by index" "333" "$_ret"
assert_eq "the resync moved the cursor past the match" "3" "$_STAT_I"
# A path stat never reported (a deletion) must not borrow a neighbour's mtime.
_STAT_I=0
lookup_mtime /r/absent; assert_eq "a path absent from the stat output gets -" "-" "$_ret"

# A MISS MUST LEAVE THE CURSOR WHERE IT WAS. This is the third property the
# O(n) design rests on and the only one that was unpinned: the two assertions
# above cover resync-by-name and the "-" return, but nothing performed a
# successful lookup AFTER a failed one, so the recovery path was half-tested.
#
# The defect form is one line -- setting _STAT_I=$_STAT_N before returning "-",
# on the reasoning that the scan reached the end so the cursor may as well
# record it. Verified invisible: applied to a copy, the ENTIRE suite passed,
# 0 FAIL, exit 0 on both interpreters. What it costs in production is that one
# file losing its stat line (racing the -e test, or an unreadable parent) makes
# every SUBSEQUENT row in that refresh render "-" and bucket `old` -- the same
# three-wrong-behaviours-at-once failure the -z comment block exists to
# prevent, arriving by a different door, and at 1 Hz in Task 6 that is the
# whole section flickering to "nothing here is recent".
#
# So the fixture has a HOLE: stat reported /r/a and /r/c but not /r/b, exactly
# as a mid-batch stat failure leaves it. Walking a, b, c in order must yield
# 111, -, 333 -- the sabotage yields 111, -, - instead.
assert_eq "a miss leaves the cursor unmoved" "0" "$_STAT_I"
stat_split "$(printf '111 /r/a\n333 /r/c\n')"
lookup_mtime /r/a; HOLE="$_ret"
lookup_mtime /r/b; HOLE="$HOLE $_ret"
lookup_mtime /r/c; HOLE="$HOLE $_ret"
assert_eq "a dropped stat line costs only its own row, not every row after it" \
    "111 - 333" "$HOLE"

# Pin that lookup_mtime writes nothing to stdout. This is the property that
# makes the no-fork calling convention work: lookup_mtime returns via _ret,
# so a naive mtime=$(lookup_mtime ...) captures empty string and breaks rows.
# The existing mtime correctness assertions catch that naive reintroduction,
# but cannot catch the working-but-forking form (with a printf to capture _ret).
# Pinning that lookup_mtime produces no stdout is robust against both.
LOOKUP_OUT="$TMPROOT/lookup-stdout"
(
    TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c '
        . '"$DIR"'/tmux-window-sidebar
        # Simulate one batched stat output: "mtime filename" per line.
        stat_split "1234567890 /repo/file.txt"
        # Call lookup_mtime and redirect its stdout to a file
        lookup_mtime "/repo/file.txt" > "'"$LOOKUP_OUT"'"
        # Verify _ret was set correctly (proves we tested the right thing)
        [ "$_ret" = "1234567890" ] || exit 1
    '
)
LOOKUP_STATUS=$?
# Verify stdout file is empty
LOOKUP_SIZE=$(wc -c < "$LOOKUP_OUT" | tr -d ' ')
[ "$LOOKUP_STATUS" -eq 0 ] && [ "$LOOKUP_SIZE" -eq 0 ] && \
    pass "lookup_mtime writes nothing to stdout" || \
    fail "lookup_mtime writes nothing to stdout" "empty stdout, _ret=1234567890" "status=$LOOKUP_STATUS size=$LOOKUP_SIZE"

echo "git_refresh conflict"
# The unmerged codes above, produced by a REAL merge rather than by hand-built
# -z records -- so this also pins that git still spells them that way and that
# the worktree really does contain the DU file. `git rm` on our side plus a
# modification on theirs is what produces DU; the reverse produces UD.
CFD="$TMPROOT/conflict"
mkdir -p "$CFD"
gitq -C "$CFD" init -q
printf 'base\n' > "$CFD/both.txt"
printf 'base\n' > "$CFD/victim.txt"
gitq -C "$CFD" add -A
gitq -C "$CFD" commit -q -m base
gitq -C "$CFD" checkout -q -b side
printf 'side\n' > "$CFD/both.txt"
printf 'side\n' > "$CFD/victim.txt"
gitq -C "$CFD" commit -q -am side
gitq -C "$CFD" checkout -q main
printf 'main\n' > "$CFD/both.txt"
gitq -C "$CFD" rm -q victim.txt
# `add -A` as well as the `git rm`: `commit -m` without it would leave the
# both.txt edit uncommitted, and the merge would then decline rather than
# conflict -- which is how the first version of this fixture reported ` M`.
gitq -C "$CFD" add -A
gitq -C "$CFD" commit -q -m main
gitq -C "$CFD" merge side >/dev/null 2>&1   # expected to conflict

# Precondition: the fixture must actually be in the state this is about, or a
# passing assertion below means nothing.
CF_CODES=$(git -C "$CFD" status --porcelain -z 2>/dev/null | tr '\0' '\n' \
    | awk 'NF { printf "%s:%s ", substr($0,1,2), substr($0,4) }' | sed 's/ *$//')
if [ "$CF_CODES" = "UU:both.txt DU:victim.txt" ] && [ -f "$CFD/victim.txt" ]; then
    CFOUT=$(TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c '. '"$DIR"'/tmux-window-sidebar; git_refresh "$1"' _ "$CFD")
    assert_eq "a real UU conflict is unmerged" "unmerged" \
        "$(printf '%s\n' "$CFOUT" | awk -F'\t' '$3 == "both.txt" { print $2 }')"
    # The whole point of I3: the file is ON DISK, so labelling it deleted gave
    # it a deletion glyph next to a real, fresh timestamp.
    assert_eq "a real DU conflict is unmerged, not deleted" "unmerged" \
        "$(printf '%s\n' "$CFOUT" | awk -F'\t' '$3 == "victim.txt" { print $2 }')"
    CF_MTIME=$(printf '%s\n' "$CFOUT" | awk -F'\t' '$3 == "victim.txt" { print $1 }')
    [ -n "$CF_MTIME" ] && [ "$CF_MTIME" != "-" ] && [ "$CF_MTIME" -gt 0 ] 2>/dev/null \
        && pass "the DU file is present on disk and gets a real mtime" \
        || fail "the DU file is present on disk and gets a real mtime" "numeric > 0" "${CF_MTIME:-<no row>}"
    # End to end: the rendered row must not carry the deletion glyph.
    #
    # The negative and the positive below are a PAIR and neither is redundant.
    # The negative alone passes vacuously on empty input -- if the awk pattern
    # ever stopped matching (a longer fixture path truncated past `victim` at
    # w=24) CF_ROW would be empty, grep would find no deletion glyph, and the
    # assertion would report success having tested nothing. The positive is
    # what proves a row was found at all. Do not delete either as duplicative.
    CF_ROW=$(changed_rows "$(printf '%s\n' "$CFOUT")" "$(date +%s)" 24 10 \
        | awk -F'\t' '/victim/ { print $2 }')
    printf '%s\n' "$CF_ROW" | grep -q '−' \
        && fail "the rendered DU row is not a deletion" "no − glyph" "$CF_ROW" \
        || pass "the rendered DU row is not a deletion"
    printf '%s\n' "$CF_ROW" | grep -q '≠' \
        && pass "the rendered DU row carries the conflict glyph" \
        || fail "the rendered DU row carries the conflict glyph" "≠" "$CF_ROW"
else
    fail "conflict fixture is in the expected state" \
        "UU:both.txt DU:victim.txt with victim.txt on disk" \
        "$CF_CODES (victim.txt on disk: $([ -f "$CFD/victim.txt" ] && echo yes || echo no))"
fi

echo "git_refresh ordering"
# "Newest first" is not decoration: it is the load-bearing input to
# changed_rows's `max` truncation. Unsorted, the CHANGED section shows an
# arbitrary subset of a busy repo rather than what you just touched, and the
# deleted rows (mtime "-", which sorts as 0 and therefore last under -r) float
# to the TOP. Nothing errors; the section just lies.
#
# This was entirely unpinned: deleting ` | sort -t$'\t' -k1,1nr` outright, and
# reversing it to -k1,1n, both passed the whole suite. The two set-comparison
# assertions that look like they might have caught it pipe through their own
# LC_ALL=C sort before comparing, so they are order-blind BY CONSTRUCTION --
# they test set membership on purpose and are left that way.
#
# The names are chosen so neither defect form can pass by accident: git status
# lists these alphabetically (gone, mid, new, old), which is neither the
# expected order nor its reverse.
OD="$TMPROOT/ordering"
mkdir -p "$OD"
gitq -C "$OD" init -q
for f in old mid new gone; do printf 'a\n' > "$OD/$f.txt"; done
gitq -C "$OD" add -A
gitq -C "$OD" commit -q -m initial
for f in old mid new; do printf 'b\n' >> "$OD/$f.txt"; done
rm "$OD/gone.txt"
# Staggered by years, so a coarse filesystem timestamp cannot collapse them.
touch -t 202001010000 "$OD/old.txt"
touch -t 202101010000 "$OD/mid.txt"
touch -t 202201010000 "$OD/new.txt"
OOUT=$(TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c '. '"$DIR"'/tmux-window-sidebar; git_refresh "$1"' _ "$OD")
# Precondition: four rows, or "the order is right" is a claim about nothing.
assert_eq "ordering fixture yields four rows" "4" \
    "$(printf '%s\n' "$OOUT" | wc -l | tr -d ' ')"
assert_eq "git_refresh orders newest first" "new.txt mid.txt old.txt" \
    "$(printf '%s\n' "$OOUT" | grep -v '^-' | cut -f3 | tr '\n' ' ' | sed 's/ *$//')"
assert_eq "the deleted row sorts last, never first" "gone.txt" \
    "$(printf '%s\n' "$OOUT" | tail -1 | cut -f3)"
assert_eq "the deleted row is the one with no mtime" "-" \
    "$(printf '%s\n' "$OOUT" | tail -1 | cut -f1)"

echo "git_refresh timing"
# lookup_mtime used to linear-scan the whole stat output once per changed
# path, which is O(n^2) over a refresh. Nothing else in this suite would have
# caught it: correctness was unaffected, only cost -- and Task 6 drives
# git_refresh at 1 Hz against a ~45 ms budget.
#
# Two compounding costs, both specific to 3.2 -- the interpreter the bash-3.2
# constraint exists to protect: the scan itself, and a TEMP FILE per changed
# path, because bash backs `<<<` with a $TMPDIR file until 5.1 (`stat -f
# '%HT' /dev/fd/0 <<< hi` reports `Regular File` under 3.2.57 and `Fifo File`
# under 5.3.15). Neither dominates -- measured at 150 files under 3.2, the
# per-path here-string form costs 736 ms and the same scan over a pre-split
# array costs 401 ms, so the temp file is roughly 45% of the excess.
#
# WHY A RATIO AND NOT A CEILING. This pin asserts t(300)/t(40), not a
# millisecond bound, and that is a correction of an earlier version of this
# file rather than a free choice. The ceiling was 400 ms with a comment
# claiming it sat "3.1x above the slowest passing case and 2.8x below the
# fastest failing one". Re-measured twice independently, the failing side was
# never anywhere near that. Min of 3 after a warm-up, idle host:
#
#                                  /bin/bash 3.2   homebrew 5.3
#   cursor walk (correct)                    119             88
#   per-path scan over the array             966            661
#
# So the real headroom above a 400 ms ceiling was 1.65x, not 2.8x -- and that
# is the dangerous direction: a host 1.65x faster than this M-series Mac puts
# the QUADRATIC form under the ceiling and the pin passes against the very
# defect it exists to catch, silently and forever. An absolute bound cannot
# be made safe here, because the thing being pinned is a complexity class and
# the bound is in units of host speed.
#
# A ratio has no such dependence. Measured t(300)/t(40):
#
#                                  /bin/bash 3.2   homebrew 5.3
#   cursor walk (correct)                   2.70           2.67
#   per-path scan over the array           18.2           15.4
#
# Linear work is ~2.7x for 7.5x the files (the per-refresh floor -- one git,
# one stat, one sort -- does not grow), quadratic work is 15-18x. A threshold
# of 6 clears both sides by more than 2x on both interpreters.
#
# The residual risk inverts usefully, which is the other reason to prefer it:
# a load spike landing on the DENOMINATOR produces a falsely LOW ratio, i.e. a
# false pass. For a regression pin that is the right way round to fail.
#
# Both measurements take the min of 3 runs. A single sample of the 300-file
# case measured 242 ms under synthetic load against 113 ms idle, so one
# sample of each would flap on a busy host for no reason connected to the
# property being tested.
#
# This is deliberately NOT a proxy for the ~45 ms budget. It pins the
# COMPLEXITY CLASS, which is the thing that regresses silently; the budget is
# a separate question that no timing assertion can own portably.
#
# BSD date has no %N, so this times with TIMEFORMAT rather than two clock reads.
# Two fixtures, because the pin is a ratio between them.
build_timing_repo() {   # $1 = dir, $2 = file count
    local d="$1" n="$2" i=0
    mkdir -p "$d"
    gitq -C "$d" init -q
    while [ "$i" -lt "$n" ]; do printf 'a\n' > "$d/f$i.txt"; i=$((i + 1)); done
    gitq -C "$d" add -A
    gitq -C "$d" commit -q -m initial
    i=0
    while [ "$i" -lt "$n" ]; do printf 'b\n' >> "$d/f$i.txt"; i=$((i + 1)); done
}

# Min of 3 timed refreshes, in ms. BSD date has no %N, so this times with
# TIMEFORMAT rather than two clock reads.
time_refresh_ms() {     # $1 = repo dir
    TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c '
        . '"$DIR"'/tmux-window-sidebar
        git_refresh "$1" >/dev/null     # warm the git index and the page cache
        TIMEFORMAT=%R
        best=""
        for _k in 1 2 3; do
            t=$( { time git_refresh "$1" >/dev/null ; } 2>&1 | tail -1 )
            ms=$(awk -v v="$t" "BEGIN{printf \"%d\", v * 1000}")
            if [ -z "$best" ] || [ "$ms" -lt "$best" ]; then best=$ms; fi
        done
        printf "%s\n" "$best"
    ' _ "$1"
}

TD="$TMPROOT/timing"
TD40="$TMPROOT/timing40"
build_timing_repo "$TD" 300
build_timing_repo "$TD40" 40

# Precondition FIRST: a git_refresh that returned nothing would be instant and
# would sail through the ceiling below.
TIMING_ROWS=$(TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c \
    '. '"$DIR"'/tmux-window-sidebar; git_refresh "$1"' _ "$TD" | wc -l | tr -d ' ')
assert_eq "timing fixture really has 300 changed files" "300" "$TIMING_ROWS"
TIMING_ROWS40=$(TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c \
    '. '"$DIR"'/tmux-window-sidebar; git_refresh "$1"' _ "$TD40" | wc -l | tr -d ' ')
assert_eq "the ratio's denominator fixture really has 40 changed files" "40" "$TIMING_ROWS40"

T300=$(time_refresh_ms "$TD")
T40=$(time_refresh_ms "$TD40")
# x100 so the ratio can be compared with shell integer arithmetic.
TIMING_RATIO=$(awk -v a="$T300" -v b="$T40" 'BEGIN{ if (b+0 <= 0) print -1; else printf "%d", (a / b) * 100 }' 2>/dev/null)
[ -n "$TIMING_RATIO" ] && [ "$TIMING_RATIO" -gt 0 ] 2>/dev/null && [ "$TIMING_RATIO" -lt 600 ] 2>/dev/null \
    && pass "git_refresh scales linearly, not quadratically (t300/t40 = $(awk -v r="$TIMING_RATIO" 'BEGIN{printf "%.2f", r/100}'), ${T300}/${T40} ms)" \
    || fail "git_refresh scales linearly, not quadratically" "t300/t40 under 6.00" \
        "$(awk -v r="${TIMING_RATIO:-0}" 'BEGIN{printf "%.2f", r/100}') (${T300:-?}/${T40:-?} ms)"

echo "budget"
# WINDOWS takes what it NEEDS, up to half the pane -- not half unconditionally.
budget 40 3; assert_eq "few windows take few rows" "3" "$_BUDGET_W"
budget 40 30; assert_eq "many windows cap at half"  "20" "$_BUDGET_W"
budget 40 3; assert_eq "changed gets the remainder" "33" "$_BUDGET_C"
# A heading with nothing under it reads as broken rather than absent, so the
# section goes header and all. This is the screensaver panel's rule.
budget 9 4; assert_eq "changed is dropped entirely when it cannot fit" "0" "$_BUDGET_C"
budget 9 4; assert_eq "windows still render in a tiny pane" "4" "$_BUDGET_W"

echo "regression pins"
# --ignore-submodules is 305 ms vs 32 ms in this nine-submodule repo. Nothing
# else would catch its removal: the sidebar would still be correct, just a
# third of a core. Pinned BEHAVIOURALLY -- grepping the production file for the
# flag name is satisfied by the file's own doc comment explaining the flag,
# which is exactly how this pin was vacuous before.
#
# Modern git refuses a file:// submodule without protocol.file.allow=always,
# which is the usual reason this fixture "does not work".
SUBI="$TMPROOT/sub-inner"
SUBT="$TMPROOT/sub-top"
mkdir -p "$SUBI" "$SUBT"
gitq -C "$SUBI" init -q
printf 'a\n' > "$SUBI/a.txt"
gitq -C "$SUBI" add -A
gitq -C "$SUBI" commit -q -m inner
gitq -C "$SUBT" init -q
gitq -C "$SUBT" -c protocol.file.allow=always submodule add -q "$SUBI" sub >/dev/null 2>&1
printf 'x\n' > "$SUBT/top.txt"
gitq -C "$SUBT" add -A >/dev/null 2>&1
gitq -C "$SUBT" commit -q -m top >/dev/null 2>&1
printf 'dirty\n' >> "$SUBT/sub/a.txt"   # dirty submodule worktree
printf 'edit\n'  >> "$SUBT/top.txt"     # an ordinary change, so the repo is not silent

# Precondition: without the flag, git MUST report the submodule. If it does not
# the fixture is broken and a passing assertion would mean nothing, so say so
# and fall back to grepping the whole command string (which, unlike the bare
# flag name, does not appear in the file's prose).
if git -C "$SUBT" status --porcelain -z 2>/dev/null | tr '\0' '\n' | grep -q '^ M sub$'; then
    SUBOUT=$(TMUX_SIDEBAR_LIB=1 "$SELF_BASH" -c '. '"$DIR"'/tmux-window-sidebar; git_refresh "$1"' _ "$SUBT")
    # Proves the refresh ran at all, so "no sub row" is not "no rows".
    assert_eq "submodule fixture: the ordinary change is reported" "1" \
        "$(printf '%s\n' "$SUBOUT" | cut -f3 | grep -cx 'top.txt' | tr -d ' ')"
    assert_eq "git status ignores a dirty submodule" "0" \
        "$(printf '%s\n' "$SUBOUT" | cut -f3 | grep -cx 'sub' | tr -d ' ')"
else
    echo "  NOTE submodule fixture unavailable on this host; falling back to a command-string grep"
    grep -q 'status --porcelain -z --ignore-submodules' "$DIR/tmux-window-sidebar" \
        && pass "git status ignores submodules (command-string grep)" \
        || fail "git status ignores submodules (command-string grep)" "present" "missing"
fi

# Red means "an agent needs you". Not a deleted file, not an old one, not a
# conflict. Verify recency_of never returns 'wait', which would map to @theme-wait.
allvals=""
for delta in 0 100 500 1000 5000 10000 100000; do
    recency_of $((1000000 - delta)) 1000000
    allvals="$allvals $_ret"
done
# Guard against the empty-string form of this test passing vacuously: the loop
# above used to call a wrapper that no longer exists, so $allvals was blank and
# the grep trivially found nothing.
assert_eq "recency_of returned a value for every delta" "7" "$(printf '%s\n' $allvals | wc -l | tr -d ' ')"
printf '%s\n' "$allvals" | grep -qw 'wait' \
    && fail "recency_of must never return 'wait'" "only now/recent/old" "found wait" \
    || pass "recency_of never returns 'wait'"

# Pin that no RENDERED row in any recency class carries @theme-wait (red). This
# is the constraint on file state: red is reserved for "an agent needs you".
# The renderer maps recency to colour (`now`→C_HEAD, `recent`→C_NAME, `old`→C_IDLE),
# which are accent/fg/dim, never wait. Test all three buckets.
RENDER_PIN=$(printf '%s\t%s\t%s\n' \
    999988 modified bin/now \
    999600 modified bin/recent \
    900000 modified bin/old)
RENDER_OUT=$(changed_rows "$RENDER_PIN" 1000000 24 10)
# The integration is in draw(), which paints based on the recency field (field 1).
# Verify the three expected classes appear, so a renderer that silently dropped
# field 1 cannot pass this.
assert_eq "the fixture yields all three recency classes" "now old recent" \
    "$(printf '%s\n' "$RENDER_OUT" | cut -f1 | LC_ALL=C sort | tr '\n' ' ' | sed 's/ *$//')"
# None of those three can map to 'wait' in any integration -- draw() is the only
# thing that reads field 1, and it is tested here by what changed_rows PRODUCES.
printf '%s\n' "$RENDER_OUT" | cut -f1 | grep -qw 'wait' \
    && fail "no file recency class is 'wait'" "only now/recent/old" "found wait in output" \
    || pass "no file recency class is 'wait'"

# --- bash 3.2 -----------------------------------------------------------------
# This repo deploys to macOS boxes without Homebrew, where /usr/bin/env bash is
# /bin/bash 3.2.57. Re-running a handful of assertions there is not enough: fix
# pass 1 shipped a `declare -A` that made git_refresh return ZERO rows under 3.2
# while passing under 5.x, and it was in a function none of those few assertions
# touched. So the WHOLE suite re-runs, behind SIDEBAR_SELFTEST_INNER so the
# inner run does not recurse.
if [ "${SIDEBAR_SELFTEST_INNER:-}" != "1" ]; then
    echo
    case "${BASH_VERSION:-}" in
        3.2*)
            echo "bash 3.2 re-run: not needed (this run IS bash ${BASH_VERSION%%(*})"
            ;;
        *)
            if [ -x /bin/bash ]; then
                B32=$(/bin/bash --version 2>&1 | head -1 | sed 's/.*version //; s/(.*//')
                case "$B32" in
                    3.2*)
                        echo "whole suite under /bin/bash $B32"
                        SIDEBAR_SELFTEST_INNER=1 /bin/bash "$DIR/tmux-sidebar-selftest" 2>&1 | sed 's/^/  | /'
                        INNER=${PIPESTATUS[0]}
                        [ "$INNER" -eq 0 ] \
                            && pass "whole suite passes under bash $B32" \
                            || fail "whole suite passes under bash $B32" "exit 0" "exit $INNER"
                        ;;
                    *)
                        echo "bash 3.2 re-run: SKIPPED (/bin/bash is $B32, not 3.2)"
                        ;;
                esac
            else
                echo "bash 3.2 re-run: SKIPPED (/bin/bash not present)"
            fi
            ;;
    esac
fi

echo
[ "$FAILED" = "0" ] && echo "all passed" || echo "FAILURES"
exit "$FAILED"
