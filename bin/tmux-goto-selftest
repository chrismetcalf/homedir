#!/usr/bin/env bash
# tmux-goto-selftest — fixture-driven tests for bin/tmux-goto.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAILED=0

pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"; FAILED=1; }
assert_eq() { [ "$2" = "$3" ] && pass "$1" || fail "$1" "$2" "$3"; }
assert_contains() { case "$3" in *"$2"*) pass "$1" ;; *) fail "$1" "to contain: $2" "$3" ;; esac; }

export TMUX_GOTO_LIB=1
# shellcheck source=/dev/null
. "$DIR/tmux-goto"

echo "tmux-goto selftest"
echo "library mode"
assert_eq "sourcing does not run main" "" "${TMUX_GOTO_MAIN_RAN:-}"
assert_eq "rows_from_lists is defined" "function" "$(type -t rows_from_lists)"
assert_eq "act_on is defined"          "function" "$(type -t act_on)"

echo "rows_from_lists"

SESS=$'main\t3\nother\t1'
WINS=$'@1\tmain\t1\thomedir\t\n@2\tmain\t2\totto-relay\twait\n@9\tother\t1\tmy project\t\n@7\tmain\t4\tidle-win\tidle'
# Three panes across two windows: main:1 has one (so it MERGES with its
# window row) and main:2 has two (so it does not). %3 carries no title, which
# is what the command fall-back is asserted against.
PANES=$'%1\tmain\t1\thomedir\tzsh\tzsh\n%2\tmain\t2\totto-relay\tnode\t✳ otto\n%3\tmain\t2\totto-relay\tbash\t'

out=$(rows_from_lists "$SESS" "$WINS" "$PANES")

# NOT one row per input line any more: nine inputs, eight rows, because
# main:1 and its only pane are one merged row.
assert_eq "nine inputs, eight rows" "8" "$(printf '%s\n' "$out" | wc -l)"

# Target must be field 1 so the action never has to parse display text.
assert_eq "session target is the name" "main" "$(printf '%s\n' "$out" | grep -m1 'sess' | cut -f1)"
# By kind, not by first match: pane rows carry the window name too, and since
# they now sort above the window rows a grep -m1 would answer with the pane.
assert_eq "window target is the id"    "@2"   \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="win" && $3 ~ /otto-relay/ {print $1}')"
assert_eq "pane target is the id"      "%2"   "$(printf '%s\n' "$out" | grep -m1 'node' | cut -f1)"

# Tags let a query be narrowed by typing "win" / "pane" / "sess".
printf '%s\n' "$out" | cut -f3 | grep -q '\[sess\]' && pass "session rows tagged" || fail "session rows tagged" "[sess]" "$(printf '%s\n' "$out" | cut -f3 | head -1)"
printf '%s\n' "$out" | cut -f3 | grep -q '\[win\]'  && pass "window rows tagged"  || fail "window rows tagged" "[win]" "$(printf '%s\n' "$out" | cut -f3 | head -3)"
printf '%s\n' "$out" | cut -f3 | grep -q '\[pane\]' && pass "pane rows tagged"    || fail "pane rows tagged" "[pane]" "$(printf '%s\n' "$out" | cut -f3 | tail -2)"

# The running command is what you actually recognise among worktree-named windows.
printf '%s\n' "$out" | grep -q 'node' && pass "pane rows show the command" || fail "pane rows show the command" "node" "$out"

# Scout state marks agents waiting on you; an unset state renders nothing, not an empty "<>".
printf '%s\n' "$out" | grep -q 'wait' && pass "scout state shown when set" || fail "scout state shown when set" "wait" "$out"
# Pin the whole row rather than grepping for one marker shape: an earlier
# version of this assertion looked for empty square brackets while the row
# renders angle brackets, so it passed no matter how broken the guard was.
assert_eq "unset scout state renders nothing" \
    "$(printf '@9\twin\t󰖯 [win]      other:1 my project  @9\t\twin:other:my project')" \
    "$(printf '%s\n' "$out" | grep -m1 'my project')"

# "idle" is the common case — marking every idle window defeats the point of a
# marker, which is to make the windows wanting your attention stand out.
assert_eq "idle state renders no marker" \
    "$(printf '@7\twin\t󰖯 [win]      main:4 idle-win  @7\tidle\twin:main:idle-win')" \
    "$(printf '%s\n' "$out" | grep -m1 'idle-win')"

# A window name with a space must survive intact.
printf '%s\n' "$out" | grep -q 'my project' && pass "spaces in names survive" || fail "spaces in names survive" "my project" "$out"

echo "act_on"

# A tmux shim records the commands act_on would issue, so this needs no server.
SHIM=$(mktemp -d)
tmux() { printf '%s\n' "$*" >> "$SHIM/calls"; }

: > "$SHIM/calls"
act_on "$(printf 'main\tsess\t󰆍 [sess] main  (3 windows)')"
grep -q "switch-client -t main" "$SHIM/calls" \
  && pass "session row switches client" || fail "session row switches client" "switch-client -t main" "$(cat "$SHIM/calls")"

: > "$SHIM/calls"
act_on "$(printf '@2\twin\t󰖯 [win]  main:2 otto-relay')"
grep -q "select-window -t @2" "$SHIM/calls" \
  && pass "window row selects the window" || fail "window row selects the window" "select-window -t @2" "$(cat "$SHIM/calls")"

: > "$SHIM/calls"
act_on "$(printf '%%2\tpane\t󱂬 [pane] main:2 otto-relay  node')"
grep -q "select-pane -t %2" "$SHIM/calls" \
  && pass "pane row selects the pane" || fail "pane row selects the pane" "select-pane -t %2" "$(cat "$SHIM/calls")"

# A session name may legally start with @ or %. Dispatching on the target's
# first character would route "@release" to select-window; the row's own tag is
# the only thing that actually knows what it is.
: > "$SHIM/calls"
act_on "$(printf '@release\tsess\t󰆍 [sess] @release  (1 windows)')"
grep -q "switch-client -t @release" "$SHIM/calls" \
  && pass "sigil-named session still switches client" || fail "sigil-named session still switches client" "switch-client -t @release" "$(cat "$SHIM/calls")"

: > "$SHIM/calls"
act_on "$(printf '%%odd\tsess\t󰆍 [sess] %%odd  (1 windows)')"
grep -q "switch-client -t %odd" "$SHIM/calls" \
  && pass "percent-named session still switches client" || fail "percent-named session still switches client" "switch-client -t %odd" "$(cat "$SHIM/calls")"

: > "$SHIM/calls"
act_on ""
assert_eq "empty selection does nothing" "" "$(cat "$SHIM/calls")"

unset -f tmux
# Not "" — this box (like any box this tool runs on) has a real /usr/bin/tmux
# on PATH, so type -t reports "file" once the shim function is gone. What
# proves the shim is actually gone is that it's no longer "function".
[ "$(type -t tmux)" != "function" ] \
  && pass "tmux shim removed" || fail "tmux shim removed" "not function" "$(type -t tmux)"
rm -rf "$SHIM"

echo "against a real server"

# The shim above proves only which command act_on *intends* to run. It cannot
# tell whether tmux accepts it -- which is what let a real dispatch bug through
# once already. This block drives the tool against a throwaway server.
#
# -L gives it its own socket and -f /dev/null stops it sourcing the real
# config: without the second flag it pulls in tpm and leaks an autoreload
# watcher that outlives the kill-server below. Never a bare kill-server here;
# that would take down the user's live session.
if ! [ -x /usr/bin/tmux ]; then
    echo "  skip (no /usr/bin/tmux)"
else
    SOCK="tmux-goto-selftest-$$"
    TT() { /usr/bin/tmux -L "$SOCK" "$@"; }

    if ! TT -f /dev/null new-session -d -s gototest -n first -x 80 -y 24 2>/dev/null; then
        echo "  skip (could not start a throwaway server)"
    else
        TT new-window -t gototest -n second
        # Window 0 is split, so it keeps a window row AND a row per pane;
        # window 1 stays single-paned, so it merges. Window 2 is the active
        # one and is excluded, which is why a third window is needed to see
        # window 1's row at all.
        TT split-window -d -t gototest:0
        TT new-window -t gototest -n third
        active_before=$(TT list-windows -t gototest -F '#{window_index} #{window_active}' | awk '$2==1{print $1}')
        assert_eq "third window starts active" "2" "$active_before"

        first_id=$(TT list-windows -t gototest -F '#{window_id} #{window_index}' | awk '$2==0{print $1}')
        # head -1: window 0 has two panes now, and both match.
        first_pane=$(TT list-panes -a -F '#{pane_id} #{window_index}' | awk '$2==0{print $1}' | head -1)
        second_id=$(TT list-windows -t gototest -F '#{window_id} #{window_index}' | awk '$2==1{print $1}')
        second_pane=$(TT list-panes -a -F '#{pane_id} #{window_index}' | awk '$2==1{print $1}' | head -1)

        tmux() { TT "$@"; }

        rows=$(collect_rows)
        printf '%s\n' "$rows" | grep -q "^${first_id}$(printf '\t')" \
          && pass "real server: window row present" || fail "real server: window row present" "$first_id" "$rows"
        printf '%s\n' "$rows" | grep -q "^${first_pane}$(printf '\t')" \
          && pass "real server: a split window still has pane rows" \
          || fail "real server: a split window still has pane rows" "$first_pane" "$rows"
        # The merge, against a real server rather than a fixture: one row for
        # the single-pane window, carrying its pane id, and no row of its own
        # for that pane.
        srow=$(printf '%s\n' "$rows" | grep -m1 "^${second_id}$(printf '\t')")
        case "$srow" in
            *"[win/pane]"*"$second_pane"*) pass "real server: the single-pane window is merged" ;;
            *) fail "real server: the single-pane window is merged" "[win/pane] … $second_pane" "$srow" ;;
        esac
        assert_eq "real server: and its pane has no row of its own" "0" \
            "$(printf '%s\n' "$rows" | grep -c "^${second_pane}$(printf '\t')")"

        # The case that matters: a target in a window that is NOT active. A
        # same-window check would pass even if nothing moved.
        act_on "$(printf '%s\n' "$rows" | grep -m1 "^${first_id}$(printf '\t')")"
        assert_eq "real server: window row changes active window" "0" \
            "$(TT list-windows -t gototest -F '#{window_index} #{window_active}' | awk '$2==1{print $1}')"

        TT select-window -t gototest:1
        act_on "$(printf '%s\n' "$rows" | grep -m1 "^${first_pane}$(printf '\t')")"
        assert_eq "real server: a pane row changes active window" "0" \
            "$(TT list-windows -t gototest -F '#{window_index} #{window_active}' | awk '$2==1{print $1}')"

        unset -f tmux
        TT kill-server 2>/dev/null
        TT list-sessions >/dev/null 2>&1 \
          && fail "throwaway server cleaned up" "no server" "still running" || pass "throwaway server cleaned up"

        # kill-server leaves the socket file behind. One dead file per run is
        # not harmless here: /tmp bloat is a documented cause of box-wide lag
        # in this repo, since it makes every temp-file op O(n).
        rm -f "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$SOCK"
        [ -e "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)/$SOCK" ] \
          && fail "throwaway socket removed" "gone" "still on disk" || pass "throwaway socket removed"
    fi
    unset -f TT
fi

echo "glyphs"

# A plan in this repo once shipped icon glyphs that were literally empty
# strings, and nothing caught it. Assert they carry real bytes and that every
# row type actually renders one.
[ -n "$GLYPH_SESS" ] && [ -n "$GLYPH_WIN" ] && [ -n "$GLYPH_PANE" ] \
  && pass "glyphs are non-empty" || fail "glyphs are non-empty" "3 non-empty" "sess=$GLYPH_SESS win=$GLYPH_WIN pane=$GLYPH_PANE"

assert_eq "glyphs are distinct" "3" \
    "$(printf '%s\n%s\n%s\n' "$GLYPH_SESS" "$GLYPH_WIN" "$GLYPH_PANE" | LC_ALL=C sort -u | wc -l)"

# Compare against literal glyphs, NOT against $GLYPH_*: reading the expected
# value out of the same variable under test made this vacuous -- with an empty
# GLYPH_WIN the old grep "^$GLYPH_WIN " degraded to "^ ", which the row's own
# leading space matched, so a blank glyph passed. Pick the row by its kind
# field rather than by line number: the fixtures carry two sessions, so line 2
# is not the first window row.
assert_eq "session rows lead with a glyph" "󰆍" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="sess"{print $3; exit}' | cut -d' ' -f1)"
assert_eq "window rows lead with a glyph" "󰖯" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="win"{print $3; exit}' | cut -d' ' -f1)"
assert_eq "pane rows lead with a glyph" "󱂬" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="pane"{print $3; exit}' | cut -d' ' -f1)"

# The typed tag is what makes a query narrowable; a glyph cannot be typed.
printf '%s\n' "$out" | cut -f3 | grep -q '\[win\]' \
  && pass "tag survives alongside the glyph" || fail "tag survives alongside the glyph" "[win]" "$(printf '%s\n' "$out" | cut -f3 | head -3)"

# Field 2 is the kind and fzf never shows it; act_on depends on it exactly.
# Panes ahead of windows is the ranking (see rows_from_lists): frecency_sort
# breaks ties on input order, so this sequence IS "a pane outranks a window it
# ties with".
assert_eq "kind field is exact" "sess sess pane pane win win win win" \
    "$(printf '%s\n' "$out" | cut -f2 | tr '\n' ' ' | sed 's/ $//')"

echo "state decoration"

# Eight themes give #rrggbb, jewel gives colourNNN. A theme this cannot parse
# must yield no colour rather than leak a broken escape into the picker.
assert_eq "hex becomes truecolor ansi" "$(printf '\033[38;2;247;118;142m')" "$(ansi_for '#f7768e')"
assert_eq "colourNNN becomes 256-colour ansi" "$(printf '\033[38;5;203m')" "$(ansi_for 'colour203')"
assert_eq "colorNNN spelling works too" "$(printf '\033[38;5;78m')" "$(ansi_for 'color78')"
assert_eq "a named colour yields nothing" "" "$(ansi_for 'chartreuse')"
assert_eq "an empty colour yields nothing" "" "$(ansi_for '')"
assert_eq "a short hex yields nothing" "" "$(ansi_for '#abc')"

# Glyph AND word: if a terminal boxes the glyph, "wait" still reads.
printf '%s\n' "$out" | grep -q '󰀦 wait' \
  && pass "wait renders glyph and word" || fail "wait renders glyph and word" "󰀦 wait" "$(printf '%s\n' "$out" | awk -F"\t" '$2=="win"')"

DONEWINS=$'@5\tmain\t9\tbuild\tdone'
out3=$(rows_from_lists "" "$DONEWINS" "")
printf '%s\n' "$out3" | grep -q '󰄬 done' \
  && pass "done renders glyph and word" || fail "done renders glyph and word" "󰄬 done" "$out3"

# scout marks the window, but the agent is a pane -- the pane row is as likely
# to be the one picked, so it inherits its window's state.
assert_eq "both panes of a window inherit its state" "2" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="pane" && $3 ~ /otto-relay/' | grep -c '󰀦 wait')"

echo "a single-pane window merges with its pane"
# The whole row, exactly, because every part of it is load-bearing: the
# [win/pane] tag (typeable as either word), the pane's title where the window
# row used to show nothing, BOTH ids so the %pane can still be typed or handed
# to tmarchy-agent, the window's own id as the target, and the WINDOW frecency
# key -- which is what keeps this picker's accumulated ranking and keeps
# promote_and_filter's pin (a window-id match) working.
assert_eq "the merged row is the window row, with the pane folded in" \
    "$(printf '@1\twin\t󰖯 [win/pane] main:1 homedir  zsh  @1 %%1\t\twin:main:homedir')" \
    "$(printf '%s\n' "$out" | grep -m1 '^@1')"
assert_eq "its kind stays win, so act_on selects the window" "win" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$1=="@1" {print $2}')"
assert_eq "and its key stays the window's" "win:main:homedir" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$1=="@1" {print $5}')"
# The pane is still reachable -- it is named in the merged row -- but it no
# longer has a row of its own, which is the duplicate this removes.
assert_eq "the pane id is still in the display" "1" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$1=="@1" {print $3}' | grep -c '%1')"
assert_eq "and the merged window contributes exactly one row" "1" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$3 ~ /main:1 homedir/' | grep -c .)"
# A split window keeps both kinds: the window row means "go there, whichever
# pane was active", which a pane-only list cannot say.
assert_eq "a split window is not merged" "[win]" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$1=="@2" {print $3}' | grep -o '\[win[^]]*\]')"
assert_eq "and still lists each of its panes" "3" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$3 ~ /otto-relay/' | grep -c .)"
# Fails OPEN: a window with no panes in the list is not a real tmux state, so
# it means the pane list was empty or truncated -- and losing the only row for
# a window is worse than keeping one that is merely redundant.
assert_eq "a window we saw no panes for keeps a plain row" "[win]" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$1=="@9" {print $3}' | grep -o '\[win[^]]*\]')"
# Same rule from the other side: suppression keys on a merged row having been
# emitted, not on the pane count, so an orphan pane keeps its row.
assert_eq "a pane whose window is absent keeps its row" "1" \
    "$(rows_from_lists "" "" "$(printf '%%9\tmain\t1\tw\tnode\t')" | grep -c .)"

# The claim that made merging cheap rather than a redesign: promote_and_filter
# pins the previously-active window by matching a WINDOW id against the row's
# target, and a merged row still carries one -- so Enter-is-alt-tab needed no
# change. Give the merged row the pane's id instead and the pin matches
# nothing, silently, while every row still looks right.
PIN=$(promote_and_filter "$out" "@2" "%2" "" "@1")
assert_eq "the last-window pin lands on a merged row" "@1" \
    "$(printf '%s\n' "$PIN" | head -1 | cut -f1)"
assert_eq "and the pinned row is not repeated below it" "1" \
    "$(printf '%s\n' "$PIN" | cut -f1 | grep -cx '@1')"

echo "the window sidebar is not a destination"
# prefix + W puts a 24-column strip of chrome in every window, and it would do
# double damage here: a junk row of its own, AND every window ceasing to look
# single-paned, which is what the merge keys on.
SBWINS=$'@5\tmain\t9\twsb\t'
SBPANES=$'%5\tmain\t9\twsb\tbash\tbash\t1\n%6\tmain\t9\twsb\tclaude\t✳ x\t0'
sbout=$(rows_from_lists "" "$SBWINS" "$SBPANES")
assert_eq "a window holding a sidebar and one agent yields one row" "1" \
    "$(printf '%s\n' "$sbout" | grep -c .)"
assert_eq "and that row is merged, not a plain window row" "1" \
    "$(printf '%s\n' "$sbout" | grep -c '\[win/pane\]')"
assert_eq "it names the agent pane, not the sidebar" "1" \
    "$(printf '%s\n' "$sbout" | grep -c '✳ x')"
assert_eq "the sidebar pane id appears nowhere" "0" \
    "$(printf '%s\n' "$sbout" | grep -c '%5')"
assert_contains "the panes query asks tmux for the sidebar flag" '#{@sidebar-pane}' \
    "$(grep 'list-panes -a' "$DIR/tmux-goto")"

# Session names are user-supplied and may contain glob characters, so the state
# lookup compares with = rather than matching the stored key as a shell pattern.
# Two sessions, both window 1: "a*" is waiting, "ab" is not. Treated as a
# pattern, the key "a*:1" matches the OTHER session's "ab:1" and hands it a wait
# it never had -- a red row pointing at a window that wants nothing. The index
# does not save you here the way it would for a bare "*", which is why the
# fixture needs two session names rather than two windows.
GLOBWINS=$'@1\ta*\t1\tone\twait\n@2\tab\t1\ttwo\t'
# Two panes per window, so neither merges and the PANE rows this is about
# still exist.
GLOBPANES=$'%1\ta*\t1\tone\tclaude\n%3\ta*\t1\tone\tzsh\n%2\tab\t1\ttwo\tzsh\n%4\tab\t1\ttwo\tzsh'
globout=$(rows_from_lists "" "$GLOBWINS" "$GLOBPANES")
assert_eq "a glob session name does not smear state onto another session" "0" \
    "$(printf '%s\n' "$globout" | awk -F'\t' '$2=="pane" && $1=="%2"' | grep -c '󰀦 wait')"
assert_eq "and the pane that should have it, has it" "1" \
    "$(printf '%s\n' "$globout" | awk -F'\t' '$2=="pane" && $1=="%1"' | grep -c '󰀦 wait')"

# Tint is theme-driven: set the colour globals and the whole row is wrapped.
C_WAIT=$(printf '\033[38;2;1;2;3m'); C_RESET=$(printf '\033[0m')
tinted=$(rows_from_lists "" "$WINS" "" | awk -F'\t' '$2=="win" && $3 ~ /otto-relay/ {print $3}')
plain=$(rows_from_lists "" "$WINS" "" | awk -F'\t' '$2=="win" && $3 ~ /home-assistant|homedir/ {print $3; exit}')
C_WAIT=""; C_RESET=""

case "$tinted" in
    "$(printf '\033[38;2;1;2;3m')"*"$(printf '\033[0m')"*) pass "stateful row is wrapped in the theme colour" ;;
    *) fail "stateful row is wrapped in the theme colour" "escape ... reset" "$(printf '%s' "$tinted" | cat -v)" ;;
esac
case "$plain" in
    *$(printf '\033')*) fail "unmarked row carries no escape" "no escape" "$(printf '%s' "$plain" | cat -v)" ;;
    *) pass "unmarked row carries no escape" ;;
esac

echo "frecency"

# The key must survive a tmux restart. Window ids do not: @2 is a different
# window after every restart, so keying on the target would rank nothing.
assert_eq "a window key is session and name, not the id" "win:main:otto-relay" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="win" && $3 ~ /otto-relay/ {print $5}')"
assert_eq "a session key is its name" "sess:main" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="sess"{print $5; exit}')"
assert_eq "a pane key includes its command" "pane:main:otto-relay:node" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="pane" && $1=="%2" {print $5}')"
assert_eq "frecency_key_goto reads the last field" "win:main:otto-relay" \
    "$(frecency_key_goto "$(printf '%s\n' "$out" | awk -F'\t' '$2=="win" && $3 ~ /otto-relay/')")"

# fzf can only match what it displays, so the id has to be IN the display.
printf '%s\n' "$out" | awk -F'\t' '$2=="win" && $3 ~ /otto-relay/ {print $3}' | grep -q '@2' \
  && pass "the target id is visible so it can be typed" \
  || fail "the target id is visible" "@2" "$(printf '%s\n' "$out" | awk -F'\t' '$2=="win"{print $3}')"
# A session's target is its name, already the label; repeating it is noise.
assert_eq "a session row does not repeat its name" "1" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="sess"{print $3; exit}' | grep -o 'main' | grep -c .)"

# Every row must have exactly the five fields act_on, the filter and fzf
# depend on: target, kind, display, state, frecency key.
assert_eq "every row has five fields" "0" \
    "$(printf '%s\n' "$out" | awk -F'\t' 'NF != 5' | grep -c .)"

echo "promote_and_filter"
PF=$'main\tsess\tS main\t\tsess:main
other\tsess\tS other\t\tsess:other
@1\twin\tW one\t\twin:main:one
@2\twin\tW two\twait\twin:main:two
@3\twin\tW three\t\twin:main:three
%1\tpane\tP one\t\tpane:main:one:zsh
%2\tpane\tP two\t\tpane:main:two:zsh'

got=$(promote_and_filter "$PF" "@1" "%1" "main" "@3")

# The point of the exercise: prefix + u then Enter goes back where you were.
assert_eq "the last window leads the list" "@3" "$(printf '%s\n' "$got" | head -1 | cut -f1)"
# Jumping to where you already are is not a destination.
assert_eq "the current window is gone" "0" "$(printf '%s\n' "$got" | cut -f1 | grep -cx '@1')"
assert_eq "the current pane is gone" "0" "$(printf '%s\n' "$got" | cut -f1 | grep -cx '%1')"
assert_eq "the current session is gone" "0" "$(printf '%s\n' "$got" | cut -f1 | grep -cx 'main')"
# Promoting must move the row, not copy it.
assert_eq "the promoted row appears once" "1" "$(printf '%s\n' "$got" | cut -f1 | grep -cx '@3')"
assert_eq "everything else survives" "other @2 %2" \
    "$(printf '%s\n' "$got" | tail -n +2 | cut -f1 | tr '\n' ' ' | sed 's/ $//')"
# Other sessions are still somewhere to go.
assert_eq "another session is kept" "1" "$(printf '%s\n' "$got" | cut -f1 | grep -cx 'other')"
assert_eq "the promoted row keeps all five fields" "5" \
    "$(printf '%s\n' "$got" | head -1 | awk -F'\t' '{print NF}')"

# A fresh session has no last window at all.
got2=$(promote_and_filter "$PF" "@1" "%1" "main" "")
assert_eq "with no last window nothing is pinned" "other" "$(printf '%s\n' "$got2" | head -1 | cut -f1)"
assert_eq "and filtering still happens" "0" "$(printf '%s\n' "$got2" | cut -f1 | grep -cx '@1')"

# The last window can name a window that is no longer listed.
got3=$(promote_and_filter "$PF" "@1" "%1" "main" "@99")
assert_eq "an unknown last window drops nothing" "4" "$(printf '%s\n' "$got3" | grep -c .)"

# A session named like a glob must not match other rows through a case pattern.
PF2=$'*\tsess\tS star\tsess:*\n@5\twin\tW five\twin:main:five'
assert_eq "a glob-like session name filters only itself" "@5" \
    "$(promote_and_filter "$PF2" "" "" "*" "" | cut -f1 | tr '\n' ' ' | sed 's/ $//')"

echo "the shipped fzf invocation"
# Read the script itself. Both of the last bugs in this area were verified
# against a synthetic fixture rather than against what actually ships, so this
# asserts on the source.
SRC=$(cat "$DIR/tmux-goto")

# --with-nth=3.. would DISPLAY field 4, which is the frecency key.
printf '%s' "$SRC" | grep -q -- "--with-nth=3 " \
  && pass "fzf is told to show only field 3" \
  || fail "fzf shows only field 3" "--with-nth=3" "$(printf '%s' "$SRC" | grep -o -- '--with-nth=[0-9.]*')"
printf '%s' "$SRC" | grep -q -- "--with-nth=3\.\." \
  && fail "field 4 is not displayed" "no --with-nth=3.." "found --with-nth=3.." \
  || pass "field 4 is not displayed"
# Without this, fzf breaks ties by row length and the frecency sort is undone.
printf '%s' "$SRC" | grep -q -- "--tiebreak=index" \
  && pass "ties fall back to the frecency order" \
  || fail "ties fall back to the frecency order" "--tiebreak=index" "absent"

echo "infrastructure sessions"
# A leading underscore means "summoned from a key", not a destination.
HIDDEN=$'main\t3\n_btop\t1\nother\t1'
hid=$(rows_from_lists "$HIDDEN" "" "")
assert_eq "an _ session is not offered" "0" "$(printf '%s\n' "$hid" | cut -f1 | grep -cx '_btop')"
assert_eq "ordinary sessions still are" "2" "$(printf '%s\n' "$hid" | grep -c .)"
assert_eq "and they keep their order" "main other" \
    "$(printf '%s\n' "$hid" | cut -f1 | tr '\n' ' ' | sed 's/ $//')"
# Only the leading position counts: a name merely containing _ is a real session.
UND=$'my_session\t1'
assert_eq "an underscore elsewhere is not hidden" "1" \
    "$(rows_from_lists "$UND" "" "" | grep -c .)"

echo "pane rows show the title, and key on the command"
# A pane running an agent is titled by Claude Code itself, which beats the
# fifth "claude" in a column of them. But the title moves on /rename, so the
# frecency key must stay on the command or the ranking resets every rename.
assert_contains "an agent pane displays its title" "✳ otto" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="pane" && $1=="%2" {print $3}')"
assert_eq "...and still keys on the command" "pane:main:otto-relay:node" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="pane" && $1=="%2" {print $5}')"
assert_eq "the title is nowhere in the key" "0" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="pane" {print $5}' | grep -c '✳')"
# A pane that set no title reports the HOSTNAME, so tmux resolves the fallback
# in the format and this stays pure -- no host_short needed here.
assert_contains "a titleless pane still shows its command" "bash" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$2=="pane" && $1=="%3" {print $3}')"
# And the merged row takes its label from its pane the same way.
assert_contains "a merged row shows its pane's label" "zsh" \
    "$(printf '%s\n' "$out" | awk -F'\t' '$1=="@1" {print $3}')"
# An empty label must not blank the column.
assert_contains "an empty label falls back to the command" "node" \
    "$(rows_from_lists "" "" "$(printf '%%9\tmain\t1\tw\tnode\t')" | cut -f3)"
assert_contains "the panes query asks tmux for the fallback" '#{==:#{pane_title},#{host_short}}' \
    "$(grep 'list-panes -a' "$DIR/tmux-goto")"

echo "state filter"
# @2 (otto-relay) is wait and both its panes inherit it, so three of the eight
# rows are wait.
assert_eq "filter_by_state all is identity" "8" "$(filter_by_state "$out" all | grep -c .)"
assert_eq "a wait filter keeps the window and both panes inheriting it" "3" \
    "$(filter_by_state "$out" wait | grep -c .)"
# Pane first, window second: the filter preserves the ranking order, and the
# ranking now puts a pane above the window it ties with.
assert_eq "and keeps exactly those three targets" "%2 %3 @2" \
    "$(filter_by_state "$out" wait | cut -f1 | tr '\n' ' ' | sed 's/ $//')"
# A session has no scout state of its own, so it has nothing to match and must
# drop out rather than ride along on every filter.
assert_eq "session rows drop out of a state filter" "0" \
    "$(filter_by_state "$out" wait | cut -f3 | grep -c '\[sess\]')"
assert_eq "a filter nothing matches yields nothing" "0" "$(filter_by_state "$out" done | grep -c .)"
assert_eq "state_of_row reads field 4" "wait" \
    "$(state_of_row "$(printf '%s\n' "$out" | awk -F'\t' '$2=="win" && $3 ~ /otto-relay/')")"
assert_eq "an unset state reads as empty, not as the key" "" \
    "$(state_of_row "$(printf '%s\n' "$out" | awk -F'\t' '$2=="win" && $3 ~ /main:1 homedir/')")"

echo "counts and header"
assert_eq "counts_line tallies the rows given it" "wait=3 busy=0 done=0 total=8" "$(counts_line "$out")"
# A merged row is counted ONCE, where the window and its pane used to be
# counted twice -- the header now says how many places want you, not how many
# rows mention them.
assert_contains "header marks the active filter" "[wait(3)]" "$(header_line "$out" wait)"
assert_contains "header keeps the other counts visible" "done(0)" "$(header_line "$out" wait)"
assert_contains "header totals under all" "[all(8)]" "$(header_line "$out" all)"
# ctrl-i IS Tab, and most rows here carry no state at all, so an idle filter
# would mean "almost everything". It gets no key and must not advertise one.
assert_eq "no key is advertised for idle" "0" "$(header_line "$out" all | grep -c 'idle(')"

echo "bindings"
assert_contains "display still shows field 3 only" "--with-nth=3 " "$(cat "$DIR/tmux-goto")"
assert_eq "all four filter keys are bound" "4" "$(grep -c 'ctrl-[wbda]:reload' "$DIR/tmux-goto")"
GOTO_BINDS="$(grep 'reload(' "$DIR/tmux-goto" | grep -v '^[[:space:]]*#')"
assert_contains "reload bodies go through \$RL, not a pasted path" 'reload($RL' "$GOTO_BINDS"
assert_eq "no binding interpolates the resolved path" "0" \
    "$(printf '%s\n' "$GOTO_BINDS" | grep -c 'TMUX_GOTO_LIBDIR\|[$]DIR')"

echo "panes outrank the windows they tie with"
RANKF="$(mktemp)"; : > "$RANKF"
RANK_ROWS="$(rows_from_lists "" "$WINS" "$PANES")"
assert_eq "an unused list ranks every pane above every window" "pane win" \
    "$(frecency_sort "$RANK_ROWS" "$RANKF" frecency_key_goto | cut -f2 | uniq | tr '\n' ' ' | sed 's/ $//')"
# The other half, and the reason this is a tie-break rather than a partition
# after the sort: a window you actually use keeps its place. A partition would
# pass the assertion above while burying an hourly window under every pane.
printf 'win:main:otto-relay\t9\t%s\n' "$(date +%s)" > "$RANKF"
assert_eq "a used window still outranks the panes" "win" \
    "$(frecency_sort "$RANK_ROWS" "$RANKF" frecency_key_goto | head -1 | cut -f2)"
assert_eq "and it is the used one, not just any window" "win:main:otto-relay" \
    "$(frecency_sort "$RANK_ROWS" "$RANKF" frecency_key_goto | head -1 | cut -f5)"
rm -f "$RANKF"

echo "esc clears the filter, and only when there is one"
ESCF="$(mktemp)"
printf 'wait\n' > "$ESCF"
ESC_FILTERED="$(TMUX_GOTO_STATE="$ESCF" env -u TMUX_GOTO_LIB "$DIR/tmux-goto" --esc)"
assert_contains "esc reloads every state while a filter is on" \
    'reload("$TMUX_GOTO_SELF" --rows all)' "$ESC_FILTERED"
assert_contains "and puts the header back with it" \
    'transform-header("$TMUX_GOTO_SELF" --header all)' "$ESC_FILTERED"
printf 'all\n' > "$ESCF"
assert_eq "esc is a plain abort with no filter on" "abort" \
    "$(TMUX_GOTO_STATE="$ESCF" env -u TMUX_GOTO_LIB "$DIR/tmux-goto" --esc)"
assert_eq "an unreadable state file aborts rather than clearing" "abort" \
    "$(TMUX_GOTO_STATE=/nonexistent/goto-state env -u TMUX_GOTO_LIB "$DIR/tmux-goto" --esc)"
assert_eq "and so does no state file at all" "abort" \
    "$(env -u TMUX_GOTO_STATE -u TMUX_GOTO_LIB "$DIR/tmux-goto" --esc)"
printf 'all\n' > "$ESCF"
TMUX_GOTO_STATE="$ESCF" env -u TMUX_GOTO_LIB "$DIR/tmux-goto" --rows all >/dev/null
printf 'all\n' > "$ESCF"
TMUX_GOTO_STATE="$ESCF" env -u TMUX_GOTO_LIB "$DIR/tmux-goto" --rows wait >/dev/null
assert_eq "--rows records the state it was asked for" "wait" "$(cat "$ESCF")"
rm -f "$ESCF"
assert_contains "the esc binding reaches this script through the environment" \
    'esc:transform(\"\$TMUX_GOTO_SELF\" --esc)' "$(grep 'esc:transform' "$DIR/tmux-goto")"
assert_eq "the header advertises the clear only while filtered" "1 0" \
    "$(header_line "$out" wait | grep -c 'esc clear') $(header_line "$out" all | grep -c 'esc clear')"

echo "sabotage proofs"
sabotage() {
    local file="$1" label="$2" expr="$3" fn="$4" broken
    broken="$(mktemp)"; sed "$expr" "$file" > "$broken"; chmod +x "$broken"
    if cmp -s "$broken" "$file"; then
        fail "sabotage '$label' changed nothing" "a modified copy" "byte-identical file"
        rm -f "$broken"; return
    fi
    if "$fn" "$broken" >/dev/null 2>&1; then
        fail "sabotage not caught: $label" "the check fails against broken code" "it passed"
    else
        pass "sabotage caught: $label"
    fi
    rm -f "$broken"
}

# Each check sources the BROKEN copy in a subshell and asserts something
# POSITIVE about it -- an exact key, an exact count, a present marker. A check
# asserting only an absence would be satisfied by a sabotage that merely
# crashed the source, which is the vacuity bin/claude-restore-plugins-selftest
# shipped twice on its first run.
chk_key_is_last() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "$SESS" "$WINS" "$PANES")
      r=$(printf '%s\n' "$o" | awk -F'\t' '$2=="win" && $3 ~ /otto-relay/')
      [ "$(frecency_key_goto "$r")" = "win:main:otto-relay" ] )
}
chk_filter_narrows() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "$SESS" "$WINS" "$PANES")
      [ "$(filter_by_state "$o" wait | grep -c .)" = 3 ] )
}
chk_header_marks_active() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "$SESS" "$WINS" "$PANES")
      header_line "$o" wait | grep -q '\[wait(' )
}

# THE trap this row shape was designed around. frecency_key_goto reads the LAST
# field, so a state appended after the key silently BECOMES the frecency key:
# the ranking this picker is built on is destroyed while every row still looks
# perfectly correct on screen. That is why state sits at field 4.
sabotage "$DIR/tmux-goto" "state lands after the frecency key" \
    's#\\t%s\\twin:%s:%s\\n#\\twin:%s:%s\\t%s\\n#' chk_key_is_last
sabotage "$DIR/tmux-goto" "filter_by_state treats every filter as all" \
    's#\[ "$want" = all \]#true#' chk_filter_narrows
sabotage "$DIR/tmux-goto" "the header stops marking the active filter" \
    's#item="\[$item\]"#:#' chk_header_marks_active

chk_pane_shows_title() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "$SESS" "$WINS" "$PANES")
      printf '%s\n' "$o" | awk -F'\t' '$1=="%2" {print $3}' | grep -q '✳ otto' )
}
chk_pane_keys_on_command() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "$SESS" "$WINS" "$PANES")
      [ "$(printf '%s\n' "$o" | awk -F'\t' '$1=="%2" {print $5}')" = "pane:main:otto-relay:node" ] )
}

sabotage "$DIR/tmux-goto" "pane rows go back to showing the bare command" \
    's#"$wname" "$label"#"$wname" "$cmd"#' chk_pane_shows_title
# The expensive mistake: keying on the title means every /rename resets that
# pane's frecency, so the ranking silently decays while the rows look right.
sabotage "$DIR/tmux-goto" "the frecency key moves onto the title" \
    's#"$state" "$sess" "$wname" "$cmd"#"$state" "$sess" "$wname" "$label"#' \
    chk_pane_keys_on_command

chk_panes_before_windows() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "" "$WINS" "$PANES")
      [ "$(printf '%s\n' "$o" | cut -f2 | uniq | tr '\n' ' ')" = "pane win " ] )
}
chk_merges_single_pane() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "" "$WINS" "$PANES")
      [ "$(printf '%s\n' "$o" | awk -F'\t' '$1=="@1" {print $3}' | grep -c '\[win/pane\]')" = 1 ] )
}
chk_no_duplicate_pane_row() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "" "$WINS" "$PANES")
      [ "$(printf '%s\n' "$o" | awk -F'\t' '$3 ~ /main:1 homedir/' | grep -c .)" = 1 ] )
}
chk_pin_reaches_merged_row() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "" "$WINS" "$PANES")
      r=$(promote_and_filter "$o" "@2" "%2" "" "@1" | head -1)
      [ "${r%%$'\t'*}" = "@1" ] )
}
chk_sidebar_excluded() {
    ( export TMUX_GOTO_LIB=1; . "$1" 2>/dev/null || exit 1
      o=$(rows_from_lists "" "$SBWINS" "$SBPANES")
      [ "$(printf '%s\n' "$o" | grep -c .)" = 1 ] && printf '%s\n' "$o" | grep -q '✳ x' )
}
chk_esc_clears() {
    local f out; f="$(mktemp)"; printf 'wait\n' > "$f"
    out="$(TMUX_GOTO_STATE="$f" env -u TMUX_GOTO_LIB "$1" --esc 2>/dev/null)"; rm -f "$f"
    case "$out" in *'reload('*'--rows all'*) return 0 ;; esac
    return 1
}
chk_esc_aborts_unfiltered() {
    [ "$(env -u TMUX_GOTO_STATE -u TMUX_GOTO_LIB "$1" --esc 2>/dev/null)" = "abort" ]
}

# Holding the window rows back is the whole ranking: print them in their own
# loop and panes fall below them again, with every row still looking correct.
sabotage "$DIR/tmux-goto" "window rows print before the panes again" \
    's#wrows="$wrows$row"#printf "%s" "$row"#' chk_panes_before_windows
sabotage "$DIR/tmux-goto" "a single-pane window stops merging" \
    's#if \[ "$n" = 1 \]; then#if false; then#' chk_merges_single_pane
# The other half: merge the window row but keep the pane row too, and the
# duplicate is back with nothing on screen to say which to pick.
sabotage "$DIR/tmux-goto" "the merged window's pane row comes back" \
    's#\[ "$found" = 1 \] && continue##' chk_no_duplicate_pane_row
# Enter-is-alt-tab, which the merge quietly depends on keeping.
sabotage "$DIR/tmux-goto" "a merged row carries its pane's id as the target" \
    's#"$id" "$STATE_COLOUR" "$GLYPH_WIN" "$sess" "$idx" "$wname" "$plabel"#"$ppane" "$STATE_COLOUR" "$GLYPH_WIN" "$sess" "$idx" "$wname" "$plabel"#' \
    chk_pin_reaches_merged_row
# With the sidebar on, ignoring the flag costs BOTH things at once: a chrome
# row in the picker and every window losing its merge.
sabotage "$DIR/tmux-goto" "the sidebar flag is ignored" \
    's#\[ "$sb" = "1" \] && continue##g' chk_sidebar_excluded
sabotage "$DIR/tmux-goto" "esc aborts even with a filter on" \
    "s#printf 'reload(%s all).*#printf abort#" chk_esc_clears
sabotage "$DIR/tmux-goto" "an unknown state reads as filtered, so esc never exits" \
    's#${s:-all}#${s:-wait}#' chk_esc_aborts_unfiltered

exit "$FAILED"
