#!/usr/bin/env bash
# tmux-theme-selftest — tests for bin/lib/tmux-theme.sh.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAILED=0

pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"; FAILED=1; }
assert_eq() { [ "$2" = "$3" ] && pass "$1" || fail "$1" "$2" "$3"; }

# shellcheck source=lib/tmux-theme.sh
. "$DIR/lib/tmux-theme.sh"

echo "tmux-theme selftest"

echo "theme_get (one batched read, cached per process)"
# A stubbed tmux, so this needs no server: the point is the PARSE, and the
# counter proves the batching rather than merely the answers.
#
# The call counter is a FILE, not a variable. _theme_load reads its tmux through
# a process substitution, so the stub runs in a subshell and an incremented
# variable would die with it -- leaving a counter stuck at 0 that "passes"
# whether the cache exists or not.
THEME_TALLY=$(mktemp "${TMPDIR:-/tmp}/tmux-theme-selftest.XXXXXX")
trap 'rm -f "$THEME_TALLY"' EXIT
tmux() {
    printf 'x\n' >> "$THEME_TALLY"
    cat <<'STUB'
status-interval 5
@theme-accent "#7aa2f7"
@theme-accent-alt "#bb9af7"
@theme-bat tokyonight_night
@theme-blank
@theme-jewel colour214
@theme-spaced "tokyo night"
status-right "#{?#{@bar-quota},@theme-decoy #f00,}"
STUB
}
_theme_reset() { _THEME_LOADED=""; _THEME_NAMES=(); _THEME_VALUES=(); : > "$THEME_TALLY"; }

_theme_reset
assert_eq "a quoted hex loses its quotes"    "#7aa2f7"          "$(theme_get accent)"
assert_eq "a hyphenated key resolves"        "#bb9af7"          "$(theme_get accent-alt)"
assert_eq "an unquoted value passes through" "tokyonight_night" "$(theme_get bat)"
assert_eq "jewel's colourNNN survives"       "colour214"        "$(theme_get jewel)"
# An option set to nothing prints as the bare name with no separator, so the
# naive ${line#* } leaves the NAME as the value -- i.e. "@theme-blank".
assert_eq "an empty option is empty, not its own name" "" "$(theme_get blank)"
assert_eq "an absent key yields nothing"     ""                 "$(theme_get nope)"
# @theme-nvim and @theme-bat are theme NAMES, not colours, so a value with a
# space in it is legal. Splitting on the LAST space instead of the first would
# return "night" here and still look like a plausible answer.
assert_eq "a value containing a space survives whole" "tokyo night" "$(theme_get spaced)"

# Note there is deliberately no assertion that a @theme-* reference inside
# status-right (in the stub above) is ignored. The prefix test is a filter, not
# a guard: such a line's first token is `status-right`, which survives
# ${name#@theme-} unchanged and so can never collide with a theme key. An
# assertion on it passes whether the filter is there or not -- verified by
# loosening the pattern to *@theme-* and watching nothing fail.

# The whole reason this exists: N lookups must cost ONE tmux invocation, not N.
# Counting in this shell (no subshell) is what makes the cache observable --
# theme_get is normally called inside $(...), where a cache filled by the child
# dies with it, which is why theme_load exists and why fzf_theme_opts calls it.
_theme_reset
theme_load
for k in accent accent-alt bat jewel blank nope accent accent; do theme_get "$k" >/dev/null; done
assert_eq "eight lookups cost one tmux call" "1" "$(grep -c . "$THEME_TALLY")"

unset -f tmux
_theme_reset

echo "ansi_for"
assert_eq "hex becomes truecolor ansi" "$(printf '\033[38;2;122;162;247m')" "$(ansi_for '#7aa2f7')"
assert_eq "colourNNN becomes 256-colour ansi" "$(printf '\033[38;5;214m')" "$(ansi_for 'colour214')"
assert_eq "colorNNN spelling works too" "$(printf '\033[38;5;78m')" "$(ansi_for 'color78')"
assert_eq "a named colour yields nothing" "" "$(ansi_for 'periwinkle')"
assert_eq "a short hex yields nothing" "" "$(ansi_for '#abc')"
assert_eq "empty yields nothing" "" "$(ansi_for '')"

echo "fzf_colour"
# fzf takes hex or a bare number. It does NOT understand tmux's colourNNN, and
# one unparseable value makes fzf reject the entire --color argument.
assert_eq "hex passes through" "#7aa2f7" "$(fzf_colour '#7aa2f7')"
assert_eq "colourNNN loses its prefix" "214" "$(fzf_colour 'colour214')"
assert_eq "colorNNN too" "78" "$(fzf_colour 'color78')"
assert_eq "a named colour yields nothing" "" "$(fzf_colour 'rebeccapurple')"
assert_eq "empty yields nothing" "" "$(fzf_colour '')"

echo "fzf_theme_opts"
# A stub theme, so this needs no tmux server and no live theme.
theme_get() {
    case "${1:-}" in
        bg)         printf '#1a1b26' ;;
        fg)         printf '#c0caf5' ;;
        dim)        printf '#565f89' ;;
        accent)     printf '#7aa2f7' ;;
        accent-alt) printf '#bb9af7' ;;
        border)     printf '#3b4261' ;;
        done)       printf '#9ece6a' ;;
        busy)       printf '#e0af68' ;;
    esac
}
opts=$(fzf_theme_opts)

printf '%s' "$opts" | grep -q '^--color=' \
  && pass "it emits a single --color token" || fail "it emits a --color token" "--color=..." "$opts"
assert_eq "the token has no spaces to split on" "1" "$(printf '%s' "$opts" | wc -w | tr -d ' ')"
for pair in 'fg:#c0caf5' 'bg:#1a1b26' 'hl:#7aa2f7' 'prompt:#7aa2f7' 'pointer:#bb9af7' 'border:#3b4261' 'info:#565f89' 'marker:#9ece6a' 'spinner:#e0af68'; do
    printf '%s' "$opts" | grep -q -- "$pair" \
      && pass "maps $pair" || fail "maps $pair" "$pair" "$opts"
done
# The selected row keeps the theme foreground on a lifted background.
printf '%s' "$opts" | grep -q -- 'bg+:#3b4261' \
  && pass "the selected row lifts its background" || fail "selected row background" "bg+:#3b4261" "$opts"

# jewel is the one theme using tmux's colourNNN spelling. One unconverted value
# would make fzf reject the whole argument, losing every colour in it.
theme_get() {
    case "${1:-}" in
        bg) printf 'colour235' ;; fg) printf 'colour253' ;;
        accent) printf 'colour214' ;; border) printf 'colour238' ;;
    esac
}
opts=$(fzf_theme_opts)
assert_eq "colourNNN themes are converted" "0" "$(printf '%s' "$opts" | grep -c 'colour')"
printf '%s' "$opts" | grep -q 'accent\|214' \
  && pass "and the numeric form survives" || fail "numeric form survives" "214" "$opts"

# A bare tmux, or tmarchy not loaded: emit nothing rather than a half spec.
theme_get() { printf ''; }
assert_eq "no theme yields no flag at all" "" "$(fzf_theme_opts)"

# An unparseable colour must drop only itself, not poison the rest.
theme_get() {
    case "${1:-}" in
        bg) printf '#1a1b26' ;; fg) printf 'chartreuse' ;; accent) printf '#7aa2f7' ;;
    esac
}
opts=$(fzf_theme_opts)
printf '%s' "$opts" | grep -q 'bg:#1a1b26' \
  && pass "a bad colour does not poison the others" || fail "a bad colour is isolated" "bg:#1a1b26" "$opts"
assert_eq "and the bad one is simply absent" "0" "$(printf '%s' "$opts" | grep -c 'chartreuse')"
assert_eq "no empty key is emitted" "0" "$(printf '%s' "$opts" | grep -c ':,\|:$')"

# The helper must not leak into the sourcing shell.
assert_eq "the internal helper is cleaned up" "" "$(type -t _fzf_add)"

exit "$FAILED"
