#!/usr/bin/env bash
# Persistent per-window sidebar pane: a narrow left column listing every window
# in the session (index, truncated name, tmux-scout state color) and highlighting
# the session's active window. Auto-refreshes ~1/s, repaints instantly on resize,
# and styles to the powerline scout palette (203 wait, 214 busy, 78 done, 245 idle).
#
# Spawned focus-safe by tmux-sidebar-ensure; not meant to be run by hand. Toggle
# the whole feature with `prefix + W` (tmux-sidebar-toggle). Width is pinned to
# @sidebar-width by tmux-sidebar-resize on the window-resized hook.
set -u

PANE="${TMUX_PANE:-}"
[ -n "$PANE" ] || [ "${TMUX_SIDEBAR_LIB:-}" = "1" ] || exit 0

# shellcheck source=lib/tmux-theme.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/tmux-theme.sh"

ESC=$'\033'
RESET="${ESC}[0m"

# The theme is read once per draw, not per row: theme_load caches one
# `tmux show -g` in the calling shell and theme_get scans it with builtins.
# Twelve `tmux show -gv` forks per redraw is what made prefix + u take 2s.
#
# Subagents keep their OWN colour rather than sharing the row's state colour.
# The four state colours already mean specific things, and a window can be in
# any of them WHILE running subagents -- two independent facts, so one colour
# cannot carry both. @theme-info is the secondary data colour, deliberately
# neither a red nor an amber: subagents running is activity, not a problem.
theme_colours() {
    C_WAIT=$(ansi_for "$(theme_get wait)")
    C_BUSY=$(ansi_for "$(theme_get busy)")
    C_DONE=$(ansi_for "$(theme_get done)")
    C_IDLE=$(ansi_for "$(theme_get dim)")
    C_NAME=$(ansi_for "$(theme_get fg)")
    C_HEAD=$(ansi_for "$(theme_get accent)")
    C_SUB=$(ansi_for "$(theme_get info)")
}

color_for() {
    case "$1" in
    wait) printf '%s' "$C_WAIT" ;;
    busy) printf '%s' "$C_BUSY" ;;
    done) printf '%s' "$C_DONE" ;;
    *)    printf '%s' "$C_IDLE" ;;
    esac
}

# --- changed files -----------------------------------------------------------

# Seconds -> the shortest honest label. Buckets, not rounding: 90s is "1m",
# because a file touched a minute and a half ago was touched once.
# Assigns result to _ret global to avoid subshell fork.
age_str() {
    local s="${1:-0}"
    if   [ "$s" -lt 60 ];    then _ret="${s}s"
    elif [ "$s" -lt 3600 ];  then _ret="$((s / 60))m"
    elif [ "$s" -lt 86400 ]; then _ret="$((s / 3600))h"
    else                          _ret="$((s / 86400))d"
    fi
}
# Wrapper for tests that expect output
age_str_print() { age_str "$@"; printf '%s' "$_ret"; }

# Truncate from the LEFT, keeping the basename. The opposite of the window
# list, and deliberately: for a file the basename identifies it, for a window
# the prefix does.
# Assigns result to _ret global to avoid subshell fork.
trunc_left() {
    local s="${1:-}" w="${2:-10}"
    [ "$w" -lt 2 ] && w=2
    if [ "${#s}" -le "$w" ]; then _ret="$s"
    else _ret="…${s: -$((w - 1))}"; fi
}
# Wrapper for tests that expect output
trunc_left_print() { trunc_left "$@"; printf '%s' "$_ret"; }

# git status --porcelain on stdin -> "state \t relpath". Pure.
parse_status() {
    local line xy path
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        xy="${line:0:2}"
        path="${line:3}"
        # "R  old -> new": the new name is the one that exists on disk.
        case "$path" in *" -> "*) path="${path#* -> }" ;; esac
        case "$xy" in
            '??') printf 'untracked\t%s\n' "$path" ;;
            *D*)  printf 'deleted\t%s\n'   "$path" ;;
            *A*)  printf 'added\t%s\n'     "$path" ;;
            *)    printf 'modified\t%s\n'  "$path" ;;
        esac
    done
}

# Which colour a row takes. Colour carries RECENCY because that is the
# headline; the glyph carries git state. @theme-wait is not in this set at
# any bucket -- red means "an agent needs you" everywhere else here.
# Assigns result to _ret global to avoid subshell fork.
recency_of() {
    local m="${1:-}" now="${2:-0}" d
    if { [ -z "$m" ] || [ "$m" = "-" ]; }; then _ret='old'; return 0; fi
    d=$((now - m))
    if   [ "$d" -lt 300 ];  then _ret='now'
    elif [ "$d" -lt 3600 ]; then _ret='recent'
    else                         _ret='old'
    fi
}
# Wrapper for tests that expect output
recency_of_print() { recency_of "$@"; printf '%s' "$_ret"; }

# "mtime \t state \t path" lines -> "recency \t rendered" lines. Pure, so the
# layout is testable without a repo, a tmux server or a clock.
changed_rows() {
    local lines="${1:-}" now="${2:-0}" w="${3:-24}" max="${4:-0}"
    local mtime state path glyph age name namew pad n=0 recency
    [ "$max" -gt 0 ] || return 0
    [ -n "$lines" ] || return 0
    # gutter(1) + name + gap(1) + age(up to 4)
    namew=$((w - 6)); [ "$namew" -lt 3 ] && namew=3
    while IFS=$'\t' read -r mtime state path; do
        [ -n "$path" ] || continue
        [ "$n" -ge "$max" ] && break
        case "$state" in
            modified)  glyph='●' ;;
            added)     glyph='+' ;;
            untracked) glyph='○' ;;
            deleted)   glyph='−' ;;
            *)         glyph='·' ;;
        esac
        # A deleted path has no mtime -- stat failed on it. An em dash, never
        # "0s", which would claim it had just been touched.
        if [ -n "$mtime" ] && [ "$mtime" != "-" ]; then
            age_str "$((now - mtime))"
            age="$_ret"
        else
            age='—'
        fi
        trunc_left "$path" "$namew"
        name="$_ret"
        recency_of "$mtime" "$now"
        recency="$_ret"
        pad=$((w - 1 - ${#name} - ${#age}))
        [ "$pad" -lt 1 ] && pad=1
        printf '%s\t%s%s%*s%s\n' "$recency" \
            "$glyph" "$name" "$pad" '' "$age"
        n=$((n + 1))
    done <<< "$lines"
}

# Repo -> "mtime \t state \t path" lines, newest first.
#
# --ignore-submodules is MANDATORY, not a tuning knob: measured in this repo
# it is 305 ms without and 32 ms with, because there are nine submodules. At
# the sidebar's redraw rate the first number is a third of a core per window,
# which is the 2026-08-21 fork-storm shape. bin/tmux-sidebar-selftest pins it.
#
# ONE stat for every path, never one per file -- a fork per changed file is
# the cost this design exists to avoid. A deleted path makes stat fail, so its
# mtime is "-", which sorts last numerically and renders no age.
git_refresh() {
    local repo="${1:-}" pairs paths state path line mtime name
    local -a path_array
    [ -n "$repo" ] || return 0
    pairs=$(git -C "$repo" status --porcelain --ignore-submodules 2>/dev/null | parse_status)
    [ -n "$pairs" ] || return 0

    # Collect all paths for batched stat
    while IFS=$'\t' read -r state path; do
        [ -n "$path" ] || continue
        path_array+=("$repo/$path")
    done <<< "$pairs"

    # ONE stat call for all paths. Deleted paths are absent from output (stat
    # fails on them). Parse by NAME, never by index -- an index-based pairing
    # would shift every file after a deleted one onto the wrong mtime.
    declare -A mtime_map
    if [ "${#path_array[@]}" -gt 0 ]; then
        while IFS= read -r line; do
            # Parse: mtime up to first space, remainder is name
            mtime="${line%% *}"
            name="${line#* }"
            mtime_map["$name"]="$mtime"
        done < <(stat "${_STAT_FMT[@]}" "${path_array[@]}" 2>/dev/null || true)
    fi

    # Pair each file with its mtime (or "-" if deleted)
    while IFS=$'\t' read -r state path; do
        [ -n "$path" ] || continue
        mtime="${mtime_map["$repo/$path"]:-"-"}"
        printf '%s\t%s\t%s\n' "$mtime" "$state" "$path"
    done <<< "$pairs" | sort -t$'\t' -k1,1nr
}

# BSD and GNU stat disagree on every flag. Resolved once, not per call.
# Format includes filename so batched stat can pair results by name.
if stat -f '%m %N' . >/dev/null 2>&1; then _STAT_FMT=(-f '%m %N'); else _STAT_FMT=(-c '%Y %n'); fi

cleanup() { printf '%s[?25h%s\n' "$ESC" "$RESET"; }

lastW=""
lastTheme=""
draw() {
	local info W NP theme namew active idx scout name col nm ln
	# Dimensions + pane count + theme marker. The marker (@theme-bg) is last so a
	# value containing special characters won't disturb earlier fields. If we're
	# the only pane left (the main shell exited), self-destruct so the window
	# doesn't linger as a lone sidebar.
	info=$(tmux display-message -p -t "$PANE" '#{pane_width} #{window_panes} #{@theme-bg}' 2>/dev/null) || exit 0
	# shellcheck disable=SC2086
	set -- $info
	W="${1:-24}"
	NP="${2:-2}"
	theme="${3:-}"
	[ "${NP:-2}" -le 1 ] && exit 0
	# Invalidate the theme cache if the marker changed. This costs nothing: the
	# marker is appended to an existing tmux call, so no extra fork, and the
	# invalidate is builtins only.
	if [ "$theme" != "$lastTheme" ]; then
		theme_invalidate
		lastTheme="$theme"
	fi
	theme_load; theme_colours
	namew=$((W - 4))
	[ "$namew" -lt 3 ] && namew=3

	local lines=()
	lines+=("${C_HEAD} WINDOWS${RESET}")
	lines+=("")
	# `subs` is @scout-subagents, written per window by tmarchy-tick: how many
	# Task subagents that window's agents have running. Rendered as a suffix on
	# the row rather than as extra rows, because a subagent is not somewhere you
	# can navigate to -- listing it like a window would imply it is.
	#
	# The name is read LAST because it is the only field that may contain
	# spaces; `read -r active idx scout subs name` puts the rest of the line in
	# `name`, so a window called "my long name" survives. Reordering these
	# breaks that silently.
	while read -r active idx scout subs name; do
		col=$(color_for "$scout")
		tag=""
		[ "$subs" != "0" ] && [ -n "$subs" ] && tag="+${subs}"
		# The suffix eats into the name's budget rather than overflowing the
		# pane: at 24 columns there is no room for both in full.
		local avail=$namew
		[ -n "$tag" ] && avail=$((namew - ${#tag} - 1))
		[ "$avail" -lt 3 ] && avail=3
		nm="$name"
		[ "${#nm}" -gt "$avail" ] && nm="${nm:0:$((avail - 1))}…"
		# The tag is coloured SEPARATELY from the name, so it is built as its own
		# escape run rather than concatenated into $nm.
		tagpart=""
		[ -n "$tag" ] && tagpart=" ${C_SUB}${tag}"
		if [ "$active" = "1" ]; then
			lines+=("${C_HEAD}▌${RESET}${col}${idx} ${nm}${tagpart}${RESET}")
		else
			lines+=(" ${col}${idx}${RESET} ${C_NAME}${nm}${tagpart}${RESET}")
		fi
	done < <(tmux list-windows -t "$PANE" \
		-F '#{window_active} #{window_index} #{?@scout-state,#{@scout-state},none} #{?@scout-subagents,#{@scout-subagents},0} #{window_name}' 2>/dev/null)

	# On a width change (terminal resize) wipe the whole pane first, so
	# reflowed/wrapped leftovers from the old width don't linger.
	[ "$W" != "$lastW" ] && printf '%s[2J' "$ESC"
	lastW="$W"

	# Repaint from home; clear each line to EOL, then clear below the list.
	printf '%s[H' "$ESC"
	for ln in "${lines[@]}"; do
		printf '%s%s[K\r\n' "$ln" "$ESC"
	done
	printf '%s[J' "$ESC"
}

if [ "${TMUX_SIDEBAR_LIB:-}" != "1" ]; then
	trap cleanup EXIT INT TERM
	printf '%s[?25l' "$ESC" # hide cursor

	# Redraw promptly on resize: a no-op WINCH trap interrupts the wait below so the
	# loop repaints immediately (with a full clear) instead of up to a second later.
	trap ':' WINCH

	while :; do
		draw
		sleep 1 &
		sp=$!
		wait "$sp" 2>/dev/null
		kill "$sp" 2>/dev/null
	done
fi
