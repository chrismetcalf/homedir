#!/usr/bin/env bash
# Persistent per-window sidebar pane: a narrow left column listing every window
# in the session (index, truncated name, tmux-scout state color) and highlighting
# the session's active window. Auto-refreshes ~1/s, repaints instantly on resize,
# and styles to the powerline scout palette (203 wait, 214 busy, 78 done, 245 idle).
#
# Spawned focus-safe by tmux-sidebar-ensure; not meant to be run by hand. Toggle
# the whole feature with `prefix + W` (tmux-sidebar-toggle). Width is pinned to
# @sidebar-width by tmux-sidebar-resize on the window-resized hook.
set -u

PANE="${TMUX_PANE:-}"
[ -n "$PANE" ] || exit 0

# shellcheck source=lib/tmux-theme.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/tmux-theme.sh"

ESC=$'\033'
RESET="${ESC}[0m"

# The theme is read once per draw, not per row: theme_load caches one
# `tmux show -g` in the calling shell and theme_get scans it with builtins.
# Twelve `tmux show -gv` forks per redraw is what made prefix + u take 2s.
#
# Subagents keep their OWN colour rather than sharing the row's state colour.
# The four state colours already mean specific things, and a window can be in
# any of them WHILE running subagents -- two independent facts, so one colour
# cannot carry both. @theme-info is the secondary data colour, deliberately
# neither a red nor an amber: subagents running is activity, not a problem.
theme_colours() {
    C_WAIT=$(ansi_for "$(theme_get wait)")
    C_BUSY=$(ansi_for "$(theme_get busy)")
    C_DONE=$(ansi_for "$(theme_get done)")
    C_IDLE=$(ansi_for "$(theme_get dim)")
    C_NAME=$(ansi_for "$(theme_get fg)")
    C_HEAD=$(ansi_for "$(theme_get accent)")
    C_SUB=$(ansi_for "$(theme_get info)")
}

color_for() {
    case "$1" in
    wait) printf '%s' "$C_WAIT" ;;
    busy) printf '%s' "$C_BUSY" ;;
    done) printf '%s' "$C_DONE" ;;
    *)    printf '%s' "$C_IDLE" ;;
    esac
}

cleanup() { printf '%s[?25h%s\n' "$ESC" "$RESET"; }
trap cleanup EXIT INT TERM
printf '%s[?25l' "$ESC" # hide cursor

lastW=""
lastTheme=""
draw() {
	local info W NP theme namew active idx scout name col nm ln
	# Dimensions + pane count + theme marker. The marker (@theme-bg) is last so a
	# value containing special characters won't disturb earlier fields. If we're
	# the only pane left (the main shell exited), self-destruct so the window
	# doesn't linger as a lone sidebar.
	info=$(tmux display-message -p -t "$PANE" '#{pane_width} #{window_panes} #{@theme-bg}' 2>/dev/null) || exit 0
	# shellcheck disable=SC2086
	set -- $info
	W="${1:-24}"
	NP="${2:-2}"
	theme="${3:-}"
	[ "${NP:-2}" -le 1 ] && exit 0
	# Invalidate the theme cache if the marker changed. This costs nothing: the
	# marker is appended to an existing tmux call, so no extra fork, and the
	# invalidate is builtins only.
	if [ "$theme" != "$lastTheme" ]; then
		theme_invalidate
		lastTheme="$theme"
	fi
	theme_load; theme_colours
	namew=$((W - 4))
	[ "$namew" -lt 3 ] && namew=3

	local lines=()
	lines+=("${C_HEAD} WINDOWS${RESET}")
	lines+=("")
	# `subs` is @scout-subagents, written per window by tmarchy-tick: how many
	# Task subagents that window's agents have running. Rendered as a suffix on
	# the row rather than as extra rows, because a subagent is not somewhere you
	# can navigate to -- listing it like a window would imply it is.
	#
	# The name is read LAST because it is the only field that may contain
	# spaces; `read -r active idx scout subs name` puts the rest of the line in
	# `name`, so a window called "my long name" survives. Reordering these
	# breaks that silently.
	while read -r active idx scout subs name; do
		col=$(color_for "$scout")
		tag=""
		[ "$subs" != "0" ] && [ -n "$subs" ] && tag="+${subs}"
		# The suffix eats into the name's budget rather than overflowing the
		# pane: at 24 columns there is no room for both in full.
		local avail=$namew
		[ -n "$tag" ] && avail=$((namew - ${#tag} - 1))
		[ "$avail" -lt 3 ] && avail=3
		nm="$name"
		[ "${#nm}" -gt "$avail" ] && nm="${nm:0:$((avail - 1))}…"
		# The tag is coloured SEPARATELY from the name, so it is built as its own
		# escape run rather than concatenated into $nm.
		tagpart=""
		[ -n "$tag" ] && tagpart=" ${C_SUB}${tag}"
		if [ "$active" = "1" ]; then
			lines+=("${C_HEAD}▌${RESET}${col}${idx} ${nm}${tagpart}${RESET}")
		else
			lines+=(" ${col}${idx}${RESET} ${C_NAME}${nm}${tagpart}${RESET}")
		fi
	done < <(tmux list-windows -t "$PANE" \
		-F '#{window_active} #{window_index} #{?@scout-state,#{@scout-state},none} #{?@scout-subagents,#{@scout-subagents},0} #{window_name}' 2>/dev/null)

	# On a width change (terminal resize) wipe the whole pane first, so
	# reflowed/wrapped leftovers from the old width don't linger.
	[ "$W" != "$lastW" ] && printf '%s[2J' "$ESC"
	lastW="$W"

	# Repaint from home; clear each line to EOL, then clear below the list.
	printf '%s[H' "$ESC"
	for ln in "${lines[@]}"; do
		printf '%s%s[K\r\n' "$ln" "$ESC"
	done
	printf '%s[J' "$ESC"
}

# Redraw promptly on resize: a no-op WINCH trap interrupts the wait below so the
# loop repaints immediately (with a full clear) instead of up to a second later.
trap ':' WINCH

while :; do
	draw
	sleep 1 &
	sp=$!
	wait "$sp" 2>/dev/null
	kill "$sp" 2>/dev/null
done
