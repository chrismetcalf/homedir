#!/usr/bin/env bash
# Ensure a window has the sidebar pane, if the feature is enabled (@sidebar on).
# Idempotent and focus-safe: splits a narrow left pane running tmux-window-sidebar
# without stealing focus. Called by tmux-sidebar-toggle (once per window) and by
# the after-select-window / after-new-window hooks (current window).
#
# Arg 1: target window id (defaults to the current window).
set -u

[ "$(tmux show-option -gqv @sidebar)" = "on" ] || exit 0
win="${1:-$(tmux display-message -p '#{window_id}')}"

# NEVER sidebar the Otto relay window: the relay addresses its panes by index
# (main:otto-relay.0/1/2 = sonnet/opus/voice, per /opt/otto/.env), so inserting a
# sidebar pane at index 0 shifts them and every relay request fails with "no signal".
case "$(tmux display-message -p -t "$win" '#{window_name}')" in
	otto-relay) exit 0 ;;
esac

width="$(tmux show-option -gqv @sidebar-width)"
width="${width:-24}"

# Already has a sidebar pane? Re-pin its width (a resize while this window was
# hidden may have let it drift) and we're done.
existing="$(tmux list-panes -t "$win" -F '#{@sidebar-pane}|#{pane_id}' 2>/dev/null |
	awk -F'|' '$1=="1"{print $2; exit}')"
if [ -n "$existing" ]; then
	tmux resize-pane -x "$width" -t "$existing" 2>/dev/null
	exit 0
fi

# -h horizontal split, -b before (left side), -d keep focus on the current pane.
p="$(tmux split-window -hb -l "$width" -d -t "$win" -P -F '#{pane_id}' \
	"exec $HOME/bin/tmux-window-sidebar")" || exit 0
[ -n "$p" ] && tmux set-option -p -t "$p" @sidebar-pane 1
