#!/usr/bin/env node
// tmux-agents-rows — classify live agent sessions and print picker rows.
//
// Pure data: bin/tmux-agents renders these through fzf. Kept separate because
// the stale filtering and the sort are where this can go silently wrong, and a
// separate file can be tested against a fixture with no tmux and no fzf --
// PROVIDED the caller also stubs TMUX_AGENTS_CAPTURE_<id> for every pane its
// fixture exercises through the pane-content fallback below. Leaving one
// unstubbed does not error; it silently shells out to a real `tmux
// capture-pane` on that pane id, which is a live-server dependent test.
//
// Reads ~/.tmux-scout/status.json with JSON.parse only -- NOT through scout's
// scripts/picker/sync + render the way bin/tmux-scout-next-wait does -- so it
// still works on a host where the tpm plugin has not been installed yet.
const fs = require('node:fs')
const path = require('node:path')
const { execSync } = require('node:child_process')
const { sessionState, paneIsPrompting, isStale } = require(path.join(__dirname, '..', 'tmarchy', 'lib', 'scout'))

function tmux(args) {
  try {
    return execSync('tmux ' + args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
  } catch (_) { return '' }
}

// The bar's wait state is sessionState() UNION paneIsPrompting(): scout's
// needsAttention hook never fires for a session started before the
// PermissionRequest hook was registered, so tmarchy/lib/scout.js's paneStates()
// scrapes the pane for a live approval dialog as a fallback. This picker exists
// to answer "is anything blocked on me" -- missing exactly the sessions that
// fallback was built for would defeat the point. Mirrored here rather than
// shared code because paneStates() rolls panes up into windows and this needs
// per-pane rows; the predicate itself (paneIsPrompting) is shared.
//
// Test override: TMUX_AGENTS_CAPTURE_<paneid-without-%> supplies capture-pane
// output for one pane with no tmux server, e.g. TMUX_AGENTS_CAPTURE_12='...'
// stubs pane %12. Falls through to a real `tmux capture-pane` when unset.
function capturePane(pane) {
  const key = 'TMUX_AGENTS_CAPTURE_' + pane.replace(/^%/, '')
  if (key in process.env) return process.env[key]
  return tmux("capture-pane -p -t '" + pane + "'")
}

const STATUS = process.env.TMUX_AGENTS_STATUS
  || path.join(process.env.HOME || '', '.tmux-scout/status.json')
const NOW = Number(process.env.TMUX_AGENTS_NOW) || Date.now()

// --state narrows the emitted rows; --counts prints the tallies and exits.
//
// The filter lives HERE rather than as a grep in the picker, because a row's
// state is sessionState() UNION paneIsPrompting() and this repo has already
// paid once for that predicate existing twice -- lib/scout.js's paneStates()
// and tmux-scout-next-wait held byte-identical copies, and the suite now greps
// for a re-inlined `needsAttention ||` to stop them re-forking. A bash-side
// `grep WAIT` over display text would be a third definition, keyed on a label
// rather than on the classifier, and it would keep passing after the label
// changed shape.
const STATES = ['wait', 'busy', 'done', 'idle']
let want = 'all'
let countsOnly = false
// --json exists for bin/tmarchy-agent (and the skill behind it), so a consumer
// that needs structured data reuses THIS classifier instead of parsing the
// picker's display text back apart. Same reason state became its own field.
let jsonOnly = false
for (let i = 2; i < process.argv.length; i++) {
  const a = process.argv[i]
  if (a === '--counts') { countsOnly = true; continue }
  if (a === '--json') { jsonOnly = true; continue }
  if (a === '--state') { want = process.argv[++i] || ''; continue }
  if (a.startsWith('--state=')) { want = a.slice('--state='.length); continue }
  process.stderr.write('tmux-agents-rows: unknown argument: ' + a + '\n')
  process.exit(2)
}
// Exit 2 on an unknown state, NEVER fall back to showing everything: a typo in
// a key binding would then look exactly like the filter quietly not working,
// which is the hardest kind of bug to see in a picker that is already full of
// rows.
if (want !== 'all' && !STATES.includes(want)) {
  process.stderr.write('tmux-agents-rows: unknown --state ' + JSON.stringify(want)
    + ' (want one of ' + STATES.join(', ') + ', all)\n')
  process.exit(2)
}

// Live panes and the current pane come from the environment when set, so the
// selftest needs no tmux server.
const livePanes = new Set(
  (process.env.TMUX_AGENTS_PANES !== undefined
    ? process.env.TMUX_AGENTS_PANES
    : tmux("list-panes -a -F '#{pane_id}'")
  ).split(/\s+/).filter(Boolean))
const current = (process.env.TMUX_AGENTS_CURRENT !== undefined
  ? process.env.TMUX_AGENTS_CURRENT
  : tmux("display-message -p '#{pane_id}'")).trim()

// Exit 3 on unreadable/unparseable, NOT 0. The picker distinguishes the two:
// "no live agents" and "your status file is corrupt" are different answers, and
// silently returning zero rows for the second would print the first.
let doc
try {
  doc = JSON.parse(fs.readFileSync(STATUS, 'utf8'))
} catch (e) {
  process.stderr.write('tmux-agents-rows: cannot read ' + STATUS + ': ' + e.message + '\n')
  process.exit(3)
}
// "null" and "42" both pass JSON.parse but are not a status document ("null"
// is the one that actually crashes: doc.sessions on null throws a TypeError,
// so the picker would see exit 1, not 3, and report "no live agents" for a
// file that is actually broken).
if (typeof doc !== 'object' || doc === null) {
  process.stderr.write('tmux-agents-rows: ' + STATUS + ' did not parse to a JSON object\n')
  process.exit(3)
}

// Duration is measured from a DIFFERENT field per state. One clock would be
// tidier and wrong: a busy agent updates constantly, so lastUpdated is ~0s for
// exactly the rows where the number matters most.
function since(s, state) {
  // A row promoted to wait by the pane-content fallback below has no
  // lastHookAt at all -- scout never saw a hook fire for it, that's the whole
  // reason it needed the fallback. Falling back to lastUpdated (the session
  // record is still being written while the pane sits on a dialog) gives it a
  // real duration instead of ms=-1 -- which would render "--" and, worse, sort
  // it dead last among waits, burying exactly the row Finding 3 exists to
  // surface at the bottom of its own group.
  if (state === 'wait') return s.lastHookAt || s.lastUpdated
  if (state === 'busy') return s.turnStartedAt
  return s.turnEndedAt || s.lastUpdated
}

function human(ms) {
  if (!ms || ms < 0) return '—'
  const sec = Math.floor(ms / 1000)
  if (sec < 60) return sec + 's'
  if (sec < 3600) return Math.floor(sec / 60) + 'm' + String(sec % 60).padStart(2, '0') + 's'
  if (sec < 86400) return Math.floor(sec / 3600) + 'h'
  return Math.floor(sec / 86400) + 'd'
}

const ORDER = { wait: 0, busy: 1, done: 2, idle: 3 }
const rows = []
for (const s of Object.values(doc.sessions || {})) {
  if (!s.tmuxPane || s.tmuxPane === current) continue
  // Stale two ways, and the pane list WINS BOTH WAYS. It was already the
  // stricter test -- scout's flag lags, which is how 36 dead entries
  // accumulated in a 587K file -- but the flag can also be wrong in the other
  // direction, declaring a live session dead because scout asked the wrong
  // tmux server. That one is worse: it hides the agent that is asking you a
  // question. isStale() in lib/scout.js is the single definition; both
  // failures are covered by the same call.
  if (isStale(s, livePanes)) continue
  if (!livePanes.has(s.tmuxPane)) continue
  let state = sessionState(s)
  // Pane-content fallback, same as paneStates(): sessionState() alone misses a
  // live approval dialog on a hookless session (needsAttention never fires),
  // which is exactly the case this picker exists to surface.
  if (state !== 'wait' && paneIsPrompting(capturePane(s.tmuxPane))) state = 'wait'
  if (!state) continue
  const from = since(s, state)
  rows.push({
    pane: s.tmuxPane,
    state,
    ms: from ? NOW - from : -1,
    label: path.basename(s.workingDirectory || '') || '?',
    detail: s.activeTool || s.currentActivity || '',
  })
}

// wait and busy: longest first, because the longest-blocked agent is the point.
// idle: most recent first, mirroring tmux-goto's instinct of keeping
// where-you-just-were within reach. Different directions on purpose.
rows.sort((a, b) => (ORDER[a.state] - ORDER[b.state])
  || (a.state === 'idle' ? a.ms - b.ms : b.ms - a.ms))

// Counts are taken from the UNFILTERED set, which is what lets the picker's
// header read `wait(2) busy(1)` while the list itself shows only waits. A
// filtered count would collapse to "the rows you can already see".
const counts = { wait: 0, busy: 0, done: 0, idle: 0 }
for (const r of rows) counts[r.state]++

if (countsOnly) {
  process.stdout.write(STATES.map((s) => s + '=' + counts[s]).join(' ')
    + ' total=' + rows.length + '\n')
  process.exit(0)
}

if (jsonOnly) {
  const out = rows
    .filter((r) => want === 'all' || r.state === want)
    .map((r) => ({
      pane: r.pane,
      state: r.state,
      // Seconds, not the raw ms, and null rather than -1 when unknown: -1 is a
      // sentinel a consumer has to know about, and one that forgets it reports
      // an agent as having waited negative time.
      seconds: r.ms >= 0 ? Math.floor(r.ms / 1000) : null,
      label: r.label,
      detail: r.detail,
    }))
  process.stdout.write(JSON.stringify(out) + '\n')
  process.exit(0)
}

const LABEL = { wait: 'WAIT', busy: 'WORK', done: 'DONE', idle: 'IDLE' }
for (const r of rows) {
  if (want !== 'all' && r.state !== want) continue
  const disp = `${LABEL[r.state]} ${human(r.ms).padStart(7)}  ${r.label.padEnd(22).slice(0, 22)}  ${r.detail}`
  // State is its OWN field, never recovered from the display label. The picker
  // both tints and filters on it, and parsing a word back out of display text
  // is how a renamed label silently stops colouring every row.
  process.stdout.write(`${r.pane}\tagent\t${r.state}\t${disp.replace(/\s+$/, '')}\n`)
}
