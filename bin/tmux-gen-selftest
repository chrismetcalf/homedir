#!/usr/bin/env bash
# tmux-gen-selftest — fixture-driven tests for bin/tmux-gen.
#
# Never calls the real Claude: TMUX_GEN_CLAUDE points at a stub. A suite that
# costs money per run gets run less, and one that needs the network is flaky.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAILED=0

pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"; FAILED=1; }
assert_eq() { [ "$2" = "$3" ] && pass "$1" || fail "$1" "$2" "$3"; }

# Source tmux-gen as a library: main() must not run.
export TMUX_GEN_LIB=1
# shellcheck source=/dev/null
. "$DIR/tmux-gen"

echo "tmux-gen selftest"
echo "library mode"
assert_eq "sourcing does not run main" "" "${TMUX_GEN_MAIN_RAN:-}"
assert_eq "parse_reply is defined"     "function" "$(type -t parse_reply)"
assert_eq "gather_context is defined"  "function" "$(type -t gather_context)"
assert_eq "query is defined"           "function" "$(type -t query)"

echo "parse_reply"

parse_reply '{"kind":"command","command":"git status","note":"shows the tree"}'
assert_eq "clean JSON -> command"      "command"    "$REPLY_KIND"
assert_eq "clean JSON -> the command"  "git status" "$REPLY_CMD"
assert_eq "clean JSON -> the note"     "shows the tree" "$REPLY_NOTE"

parse_reply '```json
{"kind":"command","command":"ls -la","note":"long listing"}
```'
assert_eq "fenced JSON is unwrapped" "ls -la" "$REPLY_CMD"

parse_reply 'Here you go:
{"kind":"command","command":"df -h","note":"disk usage"}'
assert_eq "prose preamble is skipped" "df -h" "$REPLY_CMD"

parse_reply '{"kind":"answer","note":"-F sets the field separator."}'
assert_eq "answer kind"          "answer" "$REPLY_KIND"
assert_eq "answer has no command" ""      "$REPLY_CMD"

# The governing rule: anything we cannot positively identify as a command is an
# answer, so Enter is never offered for it.
parse_reply 'total garbage, not json at all'
assert_eq "garbage degrades to answer" "answer" "$REPLY_KIND"
assert_eq "garbage offers no command"  ""       "$REPLY_CMD"
assert_eq "garbage keeps raw text"     "total garbage, not json at all" "$REPLY_NOTE"

parse_reply '{"kind":"command","command":"","note":"oops"}'
assert_eq "empty command degrades to answer" "answer" "$REPLY_KIND"
assert_eq "empty command offers nothing"     ""       "$REPLY_CMD"

parse_reply ''
assert_eq "empty reply degrades to answer" "answer" "$REPLY_KIND"

# jq unescapes \n into a REAL newline byte. send-keys -l would then submit the
# first line to the shell with no keypress at all, which defeats the tool's
# entire reason for existing.
parse_reply '{"kind":"command","command":"echo hi\nrm -rf /tmp/x","note":"n"}'
assert_eq "embedded newline degrades to answer" "answer" "$REPLY_KIND"
assert_eq "embedded newline offers nothing"     ""       "$REPLY_CMD"

# CR is what the Enter key physically sends, so a model producing CRLF-ish
# output emits it naturally; send-keys -l would submit the line just like LF.
parse_reply '{"kind":"command","command":"echo hi\rrm -rf /tmp/x","note":"n"}'
assert_eq "embedded CR degrades to answer" "answer" "$REPLY_KIND"
assert_eq "embedded CR offers nothing"     ""       "$REPLY_CMD"

# ESC reaches readline's dispatcher — e.g. ESC C-e runs shell-expand-line,
# which performs command substitution with no keypress from the user at all.
parse_reply '{"kind":"command","command":"echo $(touch /tmp/x)\u001bx","note":"n"}'
assert_eq "embedded ESC degrades to answer" "answer" "$REPLY_KIND"
assert_eq "embedded ESC offers nothing"     ""       "$REPLY_CMD"

# jq -r on a non-string renders it as text, so a bare number would otherwise
# be insertable as "5".
parse_reply '{"kind":"command","command":5,"note":"n"}'
assert_eq "non-string command degrades to answer" "answer" "$REPLY_KIND"
assert_eq "non-string command offers nothing"     ""       "$REPLY_CMD"

echo "gather_context"

# A real repo: this checkout.
CTX_CWD=""; CTX_BRANCH=""
gather_context_from_dir "$DIR/.."
assert_eq "cwd is the repo"    "$(cd "$DIR/.." && pwd)" "$CTX_CWD"
assert_eq "branch is resolved" "$(git -C "$DIR/.." rev-parse --abbrev-ref HEAD)" "$CTX_BRANCH"

# Outside a repo: branch must be empty, not an error string.
tmpdir=$(mktemp -d)
CTX_CWD=""; CTX_BRANCH=""
gather_context_from_dir "$tmpdir"
assert_eq "cwd outside a repo"     "$tmpdir" "$CTX_CWD"
assert_eq "branch empty outside a repo" ""    "$CTX_BRANCH"
rm -rf "$tmpdir"

# A worktree: this repo uses them for agent builds, and a worktree's .git is a
# FILE pointing at the real gitdir, not a directory.
wtmain=$(mktemp -d); wtlink=$(mktemp -d); rm -rf "$wtlink"
git -C "$wtmain" init -q
git -C "$wtmain" commit -q --allow-empty -m one
git -C "$wtmain" worktree add -q -b wt-branch "$wtlink" 2>/dev/null
CTX_CWD=""; CTX_BRANCH=""
gather_context_from_dir "$wtlink"
assert_eq "worktree reports its own branch" "wt-branch" "$CTX_BRANCH"
git -C "$wtmain" worktree remove --force "$wtlink" 2>/dev/null
rm -rf "$wtmain" "$wtlink"

# A detached HEAD reports a short sha rather than the literal "HEAD".
detached=$(mktemp -d)
git -C "$detached" init -q
git -C "$detached" commit -q --allow-empty -m one
git -C "$detached" checkout -q --detach HEAD
CTX_CWD=""; CTX_BRANCH=""
gather_context_from_dir "$detached"
assert_eq "detached HEAD gives a sha" "$(git -C "$detached" rev-parse --short HEAD)" "$CTX_BRANCH"
rm -rf "$detached"

echo "query"

# A stub standing in for claude: records its stdin and flags, echoes a fixture.
STUB_DIR=$(mktemp -d)
cat > "$STUB_DIR/claude" <<'STUB'
#!/usr/bin/env bash
cat > "$STUB_RECORD_STDIN"
printf '%s\n' "$*" > "$STUB_RECORD_ARGS"
printf '%s' "$STUB_REPLY"
STUB
chmod +x "$STUB_DIR/claude"
export STUB_RECORD_STDIN="$STUB_DIR/stdin.txt"
export STUB_RECORD_ARGS="$STUB_DIR/args.txt"
export STUB_REPLY='{"kind":"command","command":"git status","note":"n"}'
export TMUX_GEN_CLAUDE="$STUB_DIR/claude"

CTX_CWD="/home/krezel/.homedir"; CTX_BRANCH="tmux-gen"
out=$(query "what changed")

assert_eq "query returns the model reply" "$STUB_REPLY" "$out"
grep -q "^cwd: /home/krezel/.homedir$" "$STUB_RECORD_STDIN" \
  && pass "cwd reaches the prompt" || fail "cwd reaches the prompt" "cwd line" "$(cat "$STUB_RECORD_STDIN")"
grep -q "^branch: tmux-gen$" "$STUB_RECORD_STDIN" \
  && pass "branch reaches the prompt" || fail "branch reaches the prompt" "branch line" "$(cat "$STUB_RECORD_STDIN")"
grep -q "what changed" "$STUB_RECORD_STDIN" \
  && pass "the question reaches the prompt" || fail "the question reaches the prompt" "question" "$(cat "$STUB_RECORD_STDIN")"

# The two flags that make this safe and fast. If either is ever dropped the
# tool either gains filesystem access or slows to 20-41s.
grep -q -- "--disallowed-tools" "$STUB_RECORD_ARGS" \
  && pass "tools are disabled" || fail "tools are disabled" "--disallowed-tools" "$(cat "$STUB_RECORD_ARGS")"
grep -q -- "--append-system-prompt" "$STUB_RECORD_ARGS" \
  && pass "system prompt is sent" || fail "system prompt is sent" "--append-system-prompt" "$(cat "$STUB_RECORD_ARGS")"
grep -q -- "--model sonnet" "$STUB_RECORD_ARGS" \
  && pass "model is sonnet" || fail "model is sonnet" "--model sonnet" "$(cat "$STUB_RECORD_ARGS")"

# Outside a repo there is no branch line at all, rather than an empty one.
CTX_BRANCH=""
query "anything" >/dev/null
grep -q "^branch:" "$STUB_RECORD_STDIN" \
  && fail "no branch line when not in a repo" "no branch: line" "$(cat "$STUB_RECORD_STDIN")" \
  || pass "no branch line when not in a repo"

rm -rf "$STUB_DIR"
unset TMUX_GEN_CLAUDE STUB_REPLY STUB_RECORD_STDIN STUB_RECORD_ARGS

echo "render_and_act"

# send-keys refuses a payload over roughly 16-20KB with "command too long" and
# exit 1. Ignoring that closed the popup exactly as a success does, leaving the
# user at an unchanged prompt with no explanation. A shell function shadows the
# real binary, so this needs no tmux server at all.
tmux() { printf 'command too long\n' >&2; return 1; }

REPLY_KIND="command"; REPLY_CMD="printf hi"; REPLY_NOTE="n"
# Two newlines: the first is the [Enter] insert choice, the second dismisses the
# failure notice. A run that never reports would block on the first read.
rka_out=$(printf '\n\n' | render_and_act '%0' 2>&1)
case "$rka_out" in
    *"insert failed"*) pass "a failed send-keys is reported, not swallowed" ;;
    *) fail "a failed send-keys is reported, not swallowed" "an 'insert failed' notice" "$rka_out" ;;
esac
# Matched as one string on purpose: before the fix tmux's stderr leaked to the
# terminal unredirected, so "command too long" appeared on its own either way.
case "$rka_out" in
    *"insert failed: command too long"*) pass "the notice quotes tmux's own reason" ;;
    *) fail "the notice quotes tmux's own reason" "insert failed: command too long" "$rka_out" ;;
esac

# ...and a successful insert still says nothing and asks for nothing.
tmux() { return 0; }
rka_out=$(printf '\n' | render_and_act '%0' 2>&1)
case "$rka_out" in
    *"insert failed"*) fail "a successful insert stays quiet" "no failure notice" "$rka_out" ;;
    *) pass "a successful insert stays quiet" ;;
esac

# The stub must not outlive this section: the safety test below needs real tmux.
unset -f tmux
assert_eq "the tmux stub is gone" "file" "$(type -t tmux)"

echo "safety: insert must not execute"

# The whole tool exists to put text on a prompt line WITHOUT running it. This
# section is the only test that proves it end to end, against a real tmux pane.
#
# A throwaway server needs BOTH -L and -f /dev/null. Without the latter it
# sources the real ~/.tmux.conf, drags in tpm, and leaks an orphaned
# tmux-autoreload watcher when the server dies. And note every tmux call below
# carries -L "$SAFE_SOCK": tmux-gen's own `tmux send-keys` resolves through $TMUX,
# which is why the tool is run INSIDE this server (see the split-window) rather
# than from here with $TMUX massaged by hand. $TMUX="" is NOT isolation — tmux
# falls back to the default socket, i.e. the user's live session.
if ! command -v tmux >/dev/null 2>&1; then
    echo "  skip (no tmux on this host)"
else

SAFE_SOCK="tmux-gen-test-$$"
CANARY="/tmp/tmux-gen-canary-$$"
SAFE_STUB=$(mktemp -d)
SAFE_SOCK_PATH=""
SAFE_DONE="$SAFE_STUB/finished"
SAFE_BARRIER="$SAFE_STUB/barrier"

cleanup_safety() {
    tmux -L "$SAFE_SOCK" kill-server 2>/dev/null
    rm -f "$CANARY" ${SAFE_SOCK_PATH:+"$SAFE_SOCK_PATH"}
    rm -rf "$SAFE_STUB"
}
trap cleanup_safety EXIT

# Poll, never sleep a fixed span: a timing margin tuned on an idle box is the
# classic load-sensitive flake. $1 is a test command, $2 a deadline in 0.1s ticks.
poll_for() {
    local i=0
    while [ "$i" -lt "$2" ]; do
        eval "$1" >/dev/null 2>&1 && return 0
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

# The stub answers with a command that is destructive ON PURPOSE. If tmux-gen
# ever submits what it inserts, this deletes the canary and the suite says so.
cat > "$SAFE_STUB/claude" <<STUB
#!/usr/bin/env bash
cat > /dev/null
printf '%s' '{"kind":"command","command":"rm -rf $CANARY","note":"destructive on purpose"}'
STUB
chmod +x "$SAFE_STUB/claude"

: > "$CANARY"

# The target pane must run a REAL INTERACTIVE SHELL. This is the load-bearing
# detail of the whole test: a pane running anything else (a bare `sleep`, or the
# tool itself) has nothing that would execute a submitted line, so the canary
# survives even when tmux-gen appends Enter — the test passes while the bug
# ships. The barrier assertion below exists to keep that mistake caught.
tmux -L "$SAFE_SOCK" -f /dev/null new-session -d -x 120 -y 24 "bash --norc --noprofile -i"
SAFE_SOCK_PATH=$(tmux -L "$SAFE_SOCK" display-message -p '#{socket_path}')
TARGET=$(tmux -L "$SAFE_SOCK" display-message -p '#{pane_id}')

# Drive the tool from a SECOND pane, targeting the shell pane — the same shape
# as production, where a popup targets the pane you invoked it from. -d keeps
# focus on the target. Both prompts arrive on stdin: the question, then an empty
# line that `read -n1` takes as the [Enter] insert choice. No sleep, no
# out-of-band keystroke, so there is nothing here to tune.
#
# `env -u TMUX_GEN_LIB` is not optional: this suite exports TMUX_GEN_LIB=1 to
# source tmux-gen as a library, the throwaway server inherits it, and the tool
# would then define its functions and exit without ever running main. The canary
# survives beautifully when nothing runs — which is exactly why the "reached the
# target pane" assertion above is checked as well, and not taken on trust.
tmux -L "$SAFE_SOCK" split-window -d -t "$TARGET" \
  "printf 'delete the canary\n\n' | env -u TMUX_GEN_LIB TMUX_GEN_CLAUDE='$SAFE_STUB/claude' bash '$DIR/tmux-gen' '$TARGET'; touch '$SAFE_DONE'; sleep 300"

poll_for "[ -f '$SAFE_DONE' ]" 300 \
  || fail "tmux-gen ran to completion" "exits within 30s" "still running after 30s"

# Captured before the C-u below, while the inserted text is still pending on the
# prompt line. A plain substring match is enough here precisely because the tool
# renders its own UI in the OTHER pane: anything on this one arrived by send-keys.
SAFE_SCREEN=$(tmux -L "$SAFE_SOCK" capture-pane -p -t "$TARGET" 2>/dev/null)
case "$SAFE_SCREEN" in
    *"rm -rf $CANARY"*) pass "the command text reached the target pane" ;;
    *) fail "the command text reached the target pane" "rm -rf $CANARY on the prompt line" "$(printf '%s' "$SAFE_SCREEN" | grep -v '^$' | tail -2)" ;;
esac

# Positive control, and a barrier. C-u discards the pending (unsubmitted) line
# so the barrier command cannot be concatenated onto it; the barrier file then
# appearing proves two things at once: this shell really does run what is
# submitted to it, and it has finished consuming everything sent before it — so
# the canary check below is not just reading a race it happened to win.
tmux -L "$SAFE_SOCK" send-keys -t "$TARGET" C-u
tmux -L "$SAFE_SOCK" send-keys -t "$TARGET" -l -- "touch '$SAFE_BARRIER'"
tmux -L "$SAFE_SOCK" send-keys -t "$TARGET" Enter
poll_for "[ -f '$SAFE_BARRIER' ]" 300 \
  && pass "the target shell does execute a submitted line" \
  || fail "the target shell does execute a submitted line" "barrier command ran" "no barrier after 30s — the canary result below proves nothing"

[ -f "$CANARY" ] \
  && pass "canary survived: the command was inserted, not executed" \
  || fail "canary survived: the command was inserted, not executed" "canary exists" "canary was DELETED"

cleanup_safety
trap - EXIT
fi

exit "$FAILED"
