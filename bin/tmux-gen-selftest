#!/usr/bin/env bash
# tmux-gen-selftest — fixture-driven tests for bin/tmux-gen.
#
# Never calls the real Claude: TMUX_GEN_CLAUDE points at a stub. A suite that
# costs money per run gets run less, and one that needs the network is flaky.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FAILED=0

pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n       expected: %s\n       actual:   %s\n' "$1" "$2" "$3"; FAILED=1; }
assert_eq() { [ "$2" = "$3" ] && pass "$1" || fail "$1" "$2" "$3"; }

# Source tmux-gen as a library: main() must not run.
export TMUX_GEN_LIB=1
# shellcheck source=/dev/null
. "$DIR/tmux-gen"

echo "tmux-gen selftest"
echo "library mode"
assert_eq "sourcing does not run main" "" "${TMUX_GEN_MAIN_RAN:-}"
assert_eq "parse_reply is defined"     "function" "$(type -t parse_reply)"
assert_eq "gather_context is defined"  "function" "$(type -t gather_context)"
assert_eq "query is defined"           "function" "$(type -t query)"

echo "parse_reply"

parse_reply '{"kind":"command","command":"git status","note":"shows the tree"}'
assert_eq "clean JSON -> command"      "command"    "$REPLY_KIND"
assert_eq "clean JSON -> the command"  "git status" "$REPLY_CMD"
assert_eq "clean JSON -> the note"     "shows the tree" "$REPLY_NOTE"

parse_reply '```json
{"kind":"command","command":"ls -la","note":"long listing"}
```'
assert_eq "fenced JSON is unwrapped" "ls -la" "$REPLY_CMD"

parse_reply 'Here you go:
{"kind":"command","command":"df -h","note":"disk usage"}'
assert_eq "prose preamble is skipped" "df -h" "$REPLY_CMD"

parse_reply '{"kind":"answer","note":"-F sets the field separator."}'
assert_eq "answer kind"          "answer" "$REPLY_KIND"
assert_eq "answer has no command" ""      "$REPLY_CMD"

# The governing rule: anything we cannot positively identify as a command is an
# answer, so Enter is never offered for it.
parse_reply 'total garbage, not json at all'
assert_eq "garbage degrades to answer" "answer" "$REPLY_KIND"
assert_eq "garbage offers no command"  ""       "$REPLY_CMD"
assert_eq "garbage keeps raw text"     "total garbage, not json at all" "$REPLY_NOTE"

parse_reply '{"kind":"command","command":"","note":"oops"}'
assert_eq "empty command degrades to answer" "answer" "$REPLY_KIND"
assert_eq "empty command offers nothing"     ""       "$REPLY_CMD"

parse_reply ''
assert_eq "empty reply degrades to answer" "answer" "$REPLY_KIND"

# jq unescapes \n into a REAL newline byte. send-keys -l would then submit the
# first line to the shell with no keypress at all, which defeats the tool's
# entire reason for existing.
parse_reply '{"kind":"command","command":"echo hi\nrm -rf /tmp/x","note":"n"}'
assert_eq "embedded newline degrades to answer" "answer" "$REPLY_KIND"
assert_eq "embedded newline offers nothing"     ""       "$REPLY_CMD"

# CR is what the Enter key physically sends, so a model producing CRLF-ish
# output emits it naturally; send-keys -l would submit the line just like LF.
parse_reply '{"kind":"command","command":"echo hi\rrm -rf /tmp/x","note":"n"}'
assert_eq "embedded CR degrades to answer" "answer" "$REPLY_KIND"
assert_eq "embedded CR offers nothing"     ""       "$REPLY_CMD"

# ESC reaches readline's dispatcher — e.g. ESC C-e runs shell-expand-line,
# which performs command substitution with no keypress from the user at all.
parse_reply '{"kind":"command","command":"echo $(touch /tmp/x)\u001bx","note":"n"}'
assert_eq "embedded ESC degrades to answer" "answer" "$REPLY_KIND"
assert_eq "embedded ESC offers nothing"     ""       "$REPLY_CMD"

# jq -r on a non-string renders it as text, so a bare number would otherwise
# be insertable as "5".
parse_reply '{"kind":"command","command":5,"note":"n"}'
assert_eq "non-string command degrades to answer" "answer" "$REPLY_KIND"
assert_eq "non-string command offers nothing"     ""       "$REPLY_CMD"

echo "gather_context"

# A real repo: this checkout.
CTX_CWD=""; CTX_BRANCH=""
gather_context_from_dir "$DIR/.."
assert_eq "cwd is the repo"    "$(cd "$DIR/.." && pwd)" "$CTX_CWD"
assert_eq "branch is resolved" "$(git -C "$DIR/.." rev-parse --abbrev-ref HEAD)" "$CTX_BRANCH"

# Outside a repo: branch must be empty, not an error string.
tmpdir=$(mktemp -d)
CTX_CWD=""; CTX_BRANCH=""
gather_context_from_dir "$tmpdir"
assert_eq "cwd outside a repo"     "$tmpdir" "$CTX_CWD"
assert_eq "branch empty outside a repo" ""    "$CTX_BRANCH"
rm -rf "$tmpdir"

# A worktree: this repo uses them for agent builds, and a worktree's .git is a
# FILE pointing at the real gitdir, not a directory.
wtmain=$(mktemp -d); wtlink=$(mktemp -d); rm -rf "$wtlink"
git -C "$wtmain" init -q
git -C "$wtmain" commit -q --allow-empty -m one
git -C "$wtmain" worktree add -q -b wt-branch "$wtlink" 2>/dev/null
CTX_CWD=""; CTX_BRANCH=""
gather_context_from_dir "$wtlink"
assert_eq "worktree reports its own branch" "wt-branch" "$CTX_BRANCH"
git -C "$wtmain" worktree remove --force "$wtlink" 2>/dev/null
rm -rf "$wtmain" "$wtlink"

# A detached HEAD reports a short sha rather than the literal "HEAD".
detached=$(mktemp -d)
git -C "$detached" init -q
git -C "$detached" commit -q --allow-empty -m one
git -C "$detached" checkout -q --detach HEAD
CTX_CWD=""; CTX_BRANCH=""
gather_context_from_dir "$detached"
assert_eq "detached HEAD gives a sha" "$(git -C "$detached" rev-parse --short HEAD)" "$CTX_BRANCH"
rm -rf "$detached"

echo "query"

# A stub standing in for claude: records its stdin and flags, echoes a fixture.
STUB_DIR=$(mktemp -d)
cat > "$STUB_DIR/claude" <<'STUB'
#!/usr/bin/env bash
cat > "$STUB_RECORD_STDIN"
printf '%s\n' "$*" > "$STUB_RECORD_ARGS"
printf '%s' "$STUB_REPLY"
STUB
chmod +x "$STUB_DIR/claude"
export STUB_RECORD_STDIN="$STUB_DIR/stdin.txt"
export STUB_RECORD_ARGS="$STUB_DIR/args.txt"
export STUB_REPLY='{"kind":"command","command":"git status","note":"n"}'
export TMUX_GEN_CLAUDE="$STUB_DIR/claude"

CTX_CWD="/home/krezel/.homedir"; CTX_BRANCH="tmux-gen"
out=$(query "what changed")

assert_eq "query returns the model reply" "$STUB_REPLY" "$out"
grep -q "^cwd: /home/krezel/.homedir$" "$STUB_RECORD_STDIN" \
  && pass "cwd reaches the prompt" || fail "cwd reaches the prompt" "cwd line" "$(cat "$STUB_RECORD_STDIN")"
grep -q "^branch: tmux-gen$" "$STUB_RECORD_STDIN" \
  && pass "branch reaches the prompt" || fail "branch reaches the prompt" "branch line" "$(cat "$STUB_RECORD_STDIN")"
grep -q "what changed" "$STUB_RECORD_STDIN" \
  && pass "the question reaches the prompt" || fail "the question reaches the prompt" "question" "$(cat "$STUB_RECORD_STDIN")"

# The two flags that make this safe and fast. If either is ever dropped the
# tool either gains filesystem access or slows to 20-41s.
grep -q -- "--disallowed-tools" "$STUB_RECORD_ARGS" \
  && pass "tools are disabled" || fail "tools are disabled" "--disallowed-tools" "$(cat "$STUB_RECORD_ARGS")"
grep -q -- "--append-system-prompt" "$STUB_RECORD_ARGS" \
  && pass "system prompt is sent" || fail "system prompt is sent" "--append-system-prompt" "$(cat "$STUB_RECORD_ARGS")"
grep -q -- "--model sonnet" "$STUB_RECORD_ARGS" \
  && pass "model is sonnet" || fail "model is sonnet" "--model sonnet" "$(cat "$STUB_RECORD_ARGS")"

# Outside a repo there is no branch line at all, rather than an empty one.
CTX_BRANCH=""
query "anything" >/dev/null
grep -q "^branch:" "$STUB_RECORD_STDIN" \
  && fail "no branch line when not in a repo" "no branch: line" "$(cat "$STUB_RECORD_STDIN")" \
  || pass "no branch line when not in a repo"

rm -rf "$STUB_DIR"
unset TMUX_GEN_CLAUDE STUB_REPLY STUB_RECORD_STDIN STUB_RECORD_ARGS

exit "$FAILED"
